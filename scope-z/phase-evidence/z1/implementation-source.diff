+    },
+    unresolvedObligationRefs: w ? [`original-s6-unknown-${family}-${freshCase}`] : [],
+    withdrawn: false,
+  }));
+  if (family === 27) {
+    works[1].partition.classification = "CONFIDENTIAL";
+    sources.find((s) => s.id === "privateLedger").partition.classification = "CONFIDENTIAL";
+  }
+  if (family === 28) {
