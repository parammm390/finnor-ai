@@ -230,4 +230,5 @@ export const MIGRATIONS: MigrationFile[] = [
   { name: "postx_y4_confidential_economic_computation.sql", sql: "-- Namespaced additive migration. No shared peer ordinal is claimed.\n-- This stores proposed functions, public protocol evidence and recipient-owned\n-- outputs. It creates no S1 grant, protected admission or economic effect.\nDO $y4_query_history$\nDECLARE previous text;\nBEGIN\n SELECT pg_get_constraintdef(oid) INTO STRICT previous FROM pg_constraint\n  WHERE conrelid='finnor_os.work_query_executions'::regclass\n   AND conname='work_query_executions_intent_check';\n IF previous NOT LIKE 'CHECK (%' THEN\n  RAISE EXCEPTION 'Y4 requires the existing validated query-history predicate';\n END IF;\n ALTER TABLE finnor_os.work_query_executions DROP CONSTRAINT work_query_executions_intent_check;\n EXECUTE format('ALTER TABLE finnor_os.work_query_executions ADD CONSTRAINT work_query_executions_intent_check CHECK ((%s) OR intent=%L)',\n  substring(previous FROM 7),'confidential_economic_computation_v1');\nEND $y4_query_history$;\nCREATE TABLE finnor_os.y4_computations(\n tenant_id uuid NOT NULL,id uuid NOT NULL,principal_id uuid NOT NULL,\n root_type text NOT NULL,root_id uuid NOT NULL,work_id uuid NOT NULL,work_input_id uuid NOT NULL,\n work_input_digest text NOT NULL,request jsonb NOT NULL CHECK(octet_length(request::text)<=262144),\n request_digest text NOT NULL CHECK(request_digest~'^[a-f0-9]{64}$'),environment jsonb NOT NULL,\n deadline_at timestamptz NOT NULL,max_attempts integer NOT NULL CHECK(max_attempts BETWEEN 1 AND 4),\n attempt_count integer NOT NULL DEFAULT 0 CHECK(attempt_count BETWEEN 0 AND max_attempts),\n generation integer NOT NULL DEFAULT 1 CHECK(generation>0),\n status text NOT NULL DEFAULT 'QUEUED' CHECK(status IN(\n  'QUEUED','COMPILING','AWAITING_PARTICIPANTS','READY','RUNNING','COMPUTED',\n  'RECONCILIATION_REQUIRED','FAILED','CANCELLED','INVALIDATED','UNSUPPORTED')),\n protocol jsonb,correspondence jsonb,session jsonb,runtime_receipt jsonb,\n data_bytes bigint NOT NULL DEFAULT 0 CHECK(data_bytes BETWEEN 0 AND 16777216\n  AND data_bytes<=(request->'limits'->>'maxRetainedBytes')::bigint),\n cpu_reserved_seconds integer NOT NULL DEFAULT 0 CHECK(cpu_reserved_seconds>=0\n  AND cpu_reserved_seconds<=(request->'limits'->>'maxCpuSeconds')::integer),\n idempotency_key text NOT NULL,created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n PRIMARY KEY(tenant_id,id),UNIQUE(tenant_id,principal_id,idempotency_key),UNIQUE(tenant_id,work_id),\n FOREIGN KEY(tenant_id,principal_id) REFERENCES finnor_os.users(tenant_id,id),\n FOREIGN KEY(tenant_id,work_id) REFERENCES finnor_os.works(tenant_id,id),\n FOREIGN KEY(tenant_id,work_input_id) REFERENCES finnor_os.work_inputs(tenant_id,id)\n);\nCREATE TABLE finnor_os.y4_consents(\n tenant_id uuid NOT NULL,computation_id uuid NOT NULL,participant_id text NOT NULL,principal_id uuid NOT NULL,\n body jsonb NOT NULL CHECK(octet_length(body::text)<=65536),body_digest text NOT NULL,\n created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n PRIMARY KEY(tenant_id,computation_id,participant_id),\n FOREIGN KEY(tenant_id,computation_id) REFERENCES finnor_os.y4_computations(tenant_id,id),\n FOREIGN KEY(tenant_id,principal_id) REFERENCES finnor_os.users(tenant_id,id)\n);\nCREATE TABLE finnor_os.y4_revocations(\n tenant_id uuid NOT NULL,computation_id uuid NOT NULL,participant_id text NOT NULL,principal_id uuid NOT NULL,\n body jsonb NOT NULL CHECK(octet_length(body::text)<=8192),created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n PRIMARY KEY(tenant_id,computation_id,participant_id),\n FOREIGN KEY(tenant_id,computation_id,participant_id) REFERENCES finnor_os.y4_consents(tenant_id,computation_id,participant_id)\n);\nCREATE TABLE finnor_os.y4_disclosures(\n tenant_id uuid NOT NULL,institution_id uuid NOT NULL,source_key text NOT NULL,computation_id uuid NOT NULL,\n created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n PRIMARY KEY(tenant_id,institution_id,source_key),\n FOREIGN KEY(tenant_id,computation_id) REFERENCES finnor_os.y4_computations(tenant_id,id)\n);\nCREATE TABLE finnor_os.y4_commitments(\n tenant_id uuid NOT NULL,computation_id uuid NOT NULL,participant_id text NOT NULL,principal_id uuid NOT NULL,\n body jsonb NOT NULL CHECK(octet_length(body::text)<=65536),body_digest text NOT NULL,\n created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n PRIMARY KEY(tenant_id,computation_id,participant_id),\n FOREIGN KEY(tenant_id,computation_id,participant_id) REFERENCES finnor_os.y4_consents(tenant_id,computation_id,participant_id)\n);\nCREATE TABLE finnor_os.y4_releases(\n tenant_id uuid NOT NULL,id uuid NOT NULL,computation_id uuid NOT NULL,participant_id text NOT NULL,principal_id uuid NOT NULL,\n body jsonb NOT NULL CHECK(octet_length(body::text)<=262144),body_digest text NOT NULL,\n created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n PRIMARY KEY(tenant_id,id),UNIQUE(tenant_id,computation_id,participant_id),\n FOREIGN KEY(tenant_id,computation_id,participant_id) REFERENCES finnor_os.y4_consents(tenant_id,computation_id,participant_id)\n);\nCREATE TABLE finnor_os.y4_events(\n id bigserial PRIMARY KEY,tenant_id uuid NOT NULL,computation_id uuid NOT NULL,actor_id uuid NOT NULL,\n kind text NOT NULL,idempotency_key text NOT NULL,body jsonb NOT NULL CHECK(octet_length(body::text)<=1048576),\n created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n UNIQUE(tenant_id,computation_id,idempotency_key),\n FOREIGN KEY(tenant_id,computation_id) REFERENCES finnor_os.y4_computations(tenant_id,id)\n);\nCREATE INDEX y4_work ON finnor_os.y4_computations(tenant_id,work_id,created_at,id);\nCREATE INDEX y4_events_by_computation ON finnor_os.y4_events(tenant_id,computation_id,id);\nCREATE TABLE finnor_os.y4_source_handles(\n tenant_id uuid NOT NULL,id uuid NOT NULL DEFAULT gen_random_uuid(),principal_id uuid NOT NULL,\n grant_id uuid NOT NULL,grant_version integer NOT NULL,private_cut jsonb NOT NULL\n  CHECK(octet_length(private_cut::text)<=1048576),\n public_body jsonb NOT NULL CHECK(octet_length(public_body::text)<=8192),\n public_digest text NOT NULL CHECK(public_digest~'^[a-f0-9]{64}$'),valid_until timestamptz NOT NULL,\n created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n PRIMARY KEY(tenant_id,id),UNIQUE(tenant_id,grant_id,grant_version),\n FOREIGN KEY(tenant_id,principal_id) REFERENCES finnor_os.users(tenant_id,id),\n FOREIGN KEY(tenant_id,grant_id) REFERENCES finnor_os.x1_source_grants(tenant_id,id)\n);\nALTER TABLE finnor_os.y4_source_handles ENABLE ROW LEVEL SECURITY;\nALTER TABLE finnor_os.y4_source_handles FORCE ROW LEVEL SECURITY;\nCREATE POLICY y4_source_owner ON finnor_os.y4_source_handles\n USING(tenant_id=finnor_os.request_tenant_id()\n  AND principal_id=NULLIF(current_setting('app.user_id',true),'')::uuid);\nREVOKE ALL ON finnor_os.y4_source_handles FROM PUBLIC,finnor_app,finnor_worker;\nGRANT SELECT ON finnor_os.y4_source_handles TO finnor_app;\nCREATE TRIGGER y4_source_handle_immutable BEFORE UPDATE OR DELETE ON finnor_os.y4_source_handles\n FOR EACH ROW EXECUTE FUNCTION finnor_os.m3_immutable();\n-- Internal comparison material. Never callable by the application, never\n-- returned in a public handle, and never a replacement source authorizer.\nCREATE FUNCTION finnor_os.y4_private_source_cut(t uuid,gid uuid) RETURNS jsonb\nLANGUAGE sql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\n SELECT jsonb_build_object('grant',to_jsonb(g),\n  'actor',jsonb_build_object('id',actor.id,'status',actor.status,'role',actor.role),\n  'work',jsonb_build_object('id',work.id,'createdBy',work.created_by),\n  'mandates',coalesce((SELECT jsonb_agg(to_jsonb(m) ORDER BY m.id) FROM finnor_os.x1_work_mandates m\n   WHERE m.tenant_id=g.tenant_id AND m.work_id=g.work_id AND m.principal_id=g.principal_id\n    AND m.revoked_at IS NULL AND m.valid_from<=clock_timestamp() AND m.expires_at>clock_timestamp()),'[]'),\n  'bindings',coalesce((SELECT jsonb_agg(jsonb_build_object('binding',to_jsonb(b),'subjectStatus',u.status) ORDER BY b.id)\n   FROM finnor_os.x1_subject_identity_bindings b LEFT JOIN finnor_os.users u\n    ON u.tenant_id=b.tenant_id AND u.id=b.subject_user_id\n   WHERE b.tenant_id=g.tenant_id AND b.source_id=g.source_id AND b.institution_id=g.institution_id\n    AND b.revoked_at IS NULL AND b.valid_from<=clock_timestamp() AND b.expires_at>clock_timestamp()),'[]'),\n  'consents',coalesce((SELECT jsonb_agg(to_jsonb(s) ORDER BY s.id) FROM finnor_os.x1_subject_consents s\n   WHERE s.tenant_id=g.tenant_id AND s.institution_id=g.institution_id AND s.source_class=g.source_class\n    AND s.purpose=g.purpose AND s.revoked_at IS NULL\n    AND s.granted_at<=clock_timestamp() AND s.expires_at>clock_timestamp()),'[]'))\n FROM finnor_os.x1_source_grants g\n JOIN finnor_os.users actor ON actor.tenant_id=g.tenant_id AND actor.id=g.principal_id\n JOIN finnor_os.works work ON work.tenant_id=g.tenant_id AND work.id=g.work_id AND work.created_by=g.principal_id\n WHERE g.tenant_id=t AND g.id=gid AND actor.status='active' AND actor.role='owner'\n  AND g.revoked_at IS NULL AND g.valid_from<=clock_timestamp() AND g.expires_at>clock_timestamp()\n  AND NOT EXISTS(SELECT 1 FROM finnor_os.x1_source_grants newer\n   WHERE newer.tenant_id=g.tenant_id AND newer.principal_id=g.principal_id\n    AND newer.work_id=g.work_id AND newer.source_id=g.source_id AND newer.version>g.version)\n$$;\nREVOKE ALL ON FUNCTION finnor_os.y4_private_source_cut(uuid,uuid) FROM PUBLIC,finnor_app,finnor_worker;\nCREATE FUNCTION finnor_os.y4_issue_source_handle(w uuid,gid uuid) RETURNS jsonb\nLANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\nDECLARE t uuid:=finnor_os.request_tenant_id();u uuid:=NULLIF(current_setting('app.user_id',true),'')::uuid;\n scope jsonb;cut jsonb;body jsonb;hid uuid:=gen_random_uuid();expiry timestamptz;\n h finnor_os.y4_source_handles;\nBEGIN\n PERFORM finnor_os.x1_lock_source_authority(w,ARRAY[gid]);\n scope:=finnor_os.x1_source_scope(w,gid);\n IF scope->'body'->>'originalReadAllowed' IS DISTINCT FROM 'true'\n  OR scope->'body'->'gap' IS DISTINCT FROM 'null'::jsonb THEN\n  RAISE EXCEPTION 'Y4_CURRENT_PARTICIPANT_SOURCE_OWNER_REQUIRED'; END IF;\n cut:=finnor_os.y4_private_source_cut(t,gid);\n IF cut IS NULL OR cut->'grant'->>'principal_id' IS DISTINCT FROM u::text\n  OR jsonb_array_length(cut->'mandates')<>1 OR jsonb_array_length(cut->'bindings')>200\n  OR jsonb_array_length(cut->'consents')>200 THEN\n  RAISE EXCEPTION 'Y4_EXACT_SOURCE_AUTHORITY_CUT_REQUIRED'; END IF;\n SELECT min(value::timestamptz) INTO expiry FROM(\n  SELECT cut->'grant'->>'expires_at' value\n  UNION ALL SELECT value->>'expires_at' FROM jsonb_array_elements(cut->'mandates')\n  UNION ALL SELECT value->'binding'->>'expires_at' FROM jsonb_array_elements(cut->'bindings')\n  UNION ALL SELECT value->>'expires_at' FROM jsonb_array_elements(cut->'consents')) bounds;\n IF expiry IS NULL OR expiry<=clock_timestamp() THEN RAISE EXCEPTION 'Y4_SOURCE_AUTHORITY_EXPIRED'; END IF;\n SELECT * INTO h FROM finnor_os.y4_source_handles\n  WHERE tenant_id=t AND grant_id=gid AND grant_version=(cut->'grant'->>'version')::integer;\n IF FOUND THEN\n  IF h.principal_id<>u OR h.private_cut IS DISTINCT FROM cut OR h.valid_until<>expiry THEN\n   RAISE EXCEPTION 'Y4_ORIGINAL_SOURCE_HANDLE_NOT_REPLACEABLE'; END IF;\n  RETURN jsonb_build_object('id',h.id,'body',h.public_body,'digest',h.public_digest);\n END IF;\n body:=jsonb_build_object('schema','finnor.y4.opaque-source-handle.v1','id',hid,\n  'principalId',u,'institutionId',cut->'grant'->>'institution_id','sourceId',cut->'grant'->>'source_id',\n  'sourceRevision',cut->'grant'->>'revision','grantVersion',(cut->'grant'->>'version')::integer,\n  'purpose',cut->'grant'->>'purpose','validUntil',expiry,'sourceTruthProven',false,'executionAuthorityGranted',false);\n INSERT INTO finnor_os.y4_source_handles(tenant_id,id,principal_id,grant_id,grant_version,private_cut,public_body,public_digest,valid_until)\n  VALUES(t,hid,u,gid,(cut->'grant'->>'version')::integer,cut,body,\n   encode(sha256(convert_to(body::text,'UTF8')),'hex'),expiry) RETURNING * INTO h;\n RETURN jsonb_build_object('id',h.id,'body',h.public_body,'digest',h.public_digest);\nEND $$;\nREVOKE ALL ON FUNCTION finnor_os.y4_issue_source_handle(uuid,uuid) FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION finnor_os.y4_issue_source_handle(uuid,uuid) TO finnor_app;\n-- This can attest only the exact owner-issued cut already consented to this\n-- computation. It returns no snapshot/hash/bytes and never impersonates an\n-- owner, grants authority or prepares a cryptographic session.\nCREATE FUNCTION finnor_os.y4_source_handle_current(qid uuid,pid text,hid uuid) RETURNS boolean\nLANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\nDECLARE t uuid:=finnor_os.request_tenant_id();u uuid:=NULLIF(current_setting('app.user_id',true),'')::uuid;\n h finnor_os.y4_source_handles;q finnor_os.y4_computations;consent finnor_os.y4_consents;\nBEGIN\n SELECT * INTO q FROM finnor_os.y4_computations WHERE tenant_id=t AND id=qid;\n IF NOT FOUND OR q.deadline_at<=clock_timestamp() OR q.status IN('CANCELLED','INVALIDATED','UNSUPPORTED','FAILED') THEN RETURN false; END IF;\n SELECT * INTO h FROM finnor_os.y4_source_handles WHERE tenant_id=t AND id=hid;\n IF NOT FOUND OR h.valid_until<=clock_timestamp() THEN RETURN false; END IF;\n SELECT * INTO consent FROM finnor_os.y4_consents\n  WHERE tenant_id=t AND computation_id=qid AND participant_id=pid AND principal_id=h.principal_id;\n IF NOT FOUND OR consent.body->>'functionDigest' IS DISTINCT FROM q.protocol->>'functionDigest'\n  OR (consent.body->'request'->>'validUntil')::timestamptz<=clock_timestamp() THEN RETURN false; END IF;\n IF u IS DISTINCT FROM q.principal_id AND NOT EXISTS(SELECT 1 FROM finnor_os.y4_consents c\n  WHERE c.tenant_id=t AND c.computation_id=qid AND c.principal_id=u) THEN RETURN false; END IF;\n IF EXISTS(SELECT 1 FROM finnor_os.y4_revocations r WHERE r.tenant_id=t AND r.computation_id=qid)\n  OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(q.request->'function'->'participants') p\n   WHERE p->>'id'=pid AND p->>'institutionId'=h.public_body->>'institutionId')\n  OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(q.request->'function'->'inputs') port\n   WHERE port->>'participantId'=pid AND port->'grantRef'->>'owner'='Y4_SOURCE_AUTHORITY_HANDLE'\n    AND port->'grantRef'->>'id'=hid::text AND port->'grantRef'->>'contentDigest'=h.public_digest\n    AND port->'grantRef'->>'version'=h.grant_version::text\n    AND port->'sourceRef'->>'owner'='Y4_SOURCE_VERSION_IDENTITY'\n    AND port->'sourceRef'->>'id'=h.public_body->>'sourceId'\n    AND port->'sourceRef'->>'version'=h.public_body->>'sourceRevision'\n    AND port->'sourceRef'->>'contentDigest'=h.public_digest)\n  OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(consent.body->'sourceCuts') cut\n   WHERE cut->>'handleId'=hid::text AND cut->>'digest'=h.public_digest)\n  THEN RETURN false; END IF;\n RETURN h.private_cut IS NOT DISTINCT FROM finnor_os.y4_private_source_cut(t,h.grant_id);\nEND $$;\nREVOKE ALL ON FUNCTION finnor_os.y4_source_handle_current(uuid,text,uuid) FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION finnor_os.y4_source_handle_current(uuid,text,uuid) TO finnor_app;\nCREATE FUNCTION finnor_os.y4_original_identity() RETURNS trigger\nLANGUAGE plpgsql SET search_path=pg_catalog,finnor_os AS $$\nBEGIN\n IF to_jsonb(NEW)-ARRAY['attempt_count','generation','status','protocol','correspondence','session','runtime_receipt','data_bytes','cpu_reserved_seconds']\n IS DISTINCT FROM to_jsonb(OLD)-ARRAY['attempt_count','generation','status','protocol','correspondence','session','runtime_receipt','data_bytes','cpu_reserved_seconds']\n OR NEW.attempt_count<OLD.attempt_count OR NEW.generation<OLD.generation OR NEW.data_bytes<OLD.data_bytes\n OR NEW.cpu_reserved_seconds<OLD.cpu_reserved_seconds\n OR (OLD.protocol IS NOT NULL AND NEW.protocol IS DISTINCT FROM OLD.protocol)\n OR (OLD.correspondence IS NOT NULL AND NEW.correspondence IS DISTINCT FROM OLD.correspondence)\n OR (OLD.session IS NOT NULL AND NEW.session IS DISTINCT FROM OLD.session)\n OR (OLD.runtime_receipt IS NOT NULL AND NEW.runtime_receipt IS DISTINCT FROM OLD.runtime_receipt)\n THEN RAISE EXCEPTION 'Y4 original allocation and checked artifacts cannot reset'; END IF;\n RETURN NEW;\nEND $$;\nCREATE TRIGGER y4_identity BEFORE UPDATE ON finnor_os.y4_computations\n FOR EACH ROW EXECUTE FUNCTION finnor_os.y4_original_identity();\nDO $$ DECLARE t text; BEGIN\n FOREACH t IN ARRAY ARRAY['y4_computations','y4_consents','y4_revocations','y4_disclosures','y4_commitments','y4_releases','y4_events'] LOOP\n  EXECUTE format('ALTER TABLE finnor_os.%I ENABLE ROW LEVEL SECURITY',t);\n  EXECUTE format('ALTER TABLE finnor_os.%I FORCE ROW LEVEL SECURITY',t);\n  IF t='y4_releases' THEN\n   EXECUTE format('CREATE POLICY y4_recipient ON finnor_os.%I USING(\n    tenant_id=finnor_os.request_tenant_id() AND principal_id=NULLIF(current_setting(''app.user_id'',true),'''')::uuid)\n    WITH CHECK(tenant_id=finnor_os.request_tenant_id() AND principal_id=NULLIF(current_setting(''app.user_id'',true),'''')::uuid)',t);\n  ELSE\n   EXECUTE format('CREATE POLICY y4_tenant ON finnor_os.%I USING(tenant_id=finnor_os.request_tenant_id())\n    WITH CHECK(tenant_id=finnor_os.request_tenant_id())',t);\n  END IF;\n  EXECUTE format('REVOKE ALL ON finnor_os.%I FROM finnor_app',t);\n  EXECUTE format('GRANT SELECT,INSERT ON finnor_os.%I TO finnor_app',t);\n  IF t='y4_computations' THEN\n   EXECUTE format('GRANT UPDATE ON finnor_os.%I TO finnor_app',t);\n  ELSE\n   EXECUTE format('CREATE TRIGGER y4_immutable BEFORE UPDATE OR DELETE ON finnor_os.%I\n    FOR EACH ROW EXECUTE FUNCTION finnor_os.m3_immutable()',t);\n  END IF;\n END LOOP;\nEND $$;\nCREATE FUNCTION finnor_os.y4_retained_bytes() RETURNS trigger\nLANGUAGE plpgsql SET search_path=pg_catalog,finnor_os AS $$\nDECLARE parent uuid;delta bigint;\nBEGIN\n IF TG_TABLE_NAME='y4_computations' THEN parent:=NEW.id; ELSE parent:=NEW.computation_id; END IF;\n delta:=octet_length((to_jsonb(NEW)-'data_bytes')::text);\n IF TG_OP='UPDATE' THEN delta:=greatest(0,delta-octet_length((to_jsonb(OLD)-'data_bytes')::text)); END IF;\n IF delta>0 THEN UPDATE finnor_os.y4_computations SET data_bytes=data_bytes+delta\n   WHERE tenant_id=NEW.tenant_id AND id=parent\n    AND data_bytes+delta<=(request->'limits'->>'maxRetainedBytes')::bigint;\n   IF NOT FOUND THEN RAISE EXCEPTION 'Y4_ORIGINAL_RETAINED_BYTE_LIMIT' USING ERRCODE='54000'; END IF;\n END IF;\n RETURN NEW;\nEND $$;\nCREATE TRIGGER y4_bytes AFTER INSERT ON finnor_os.y4_computations\n FOR EACH ROW EXECUTE FUNCTION finnor_os.y4_retained_bytes();\nCREATE TRIGGER y4_update_bytes AFTER UPDATE ON finnor_os.y4_computations\n FOR EACH ROW WHEN ((to_jsonb(NEW)-'data_bytes') IS DISTINCT FROM (to_jsonb(OLD)-'data_bytes'))\n EXECUTE FUNCTION finnor_os.y4_retained_bytes();\nDO $$ DECLARE t text; BEGIN\n FOREACH t IN ARRAY ARRAY['y4_consents','y4_revocations','y4_disclosures','y4_commitments','y4_releases','y4_events'] LOOP\n  EXECUTE format('CREATE TRIGGER y4_bytes AFTER INSERT ON finnor_os.%I\n   FOR EACH ROW EXECUTE FUNCTION finnor_os.y4_retained_bytes()',t);\n END LOOP;\nEND $$;\nGRANT USAGE,SELECT ON SEQUENCE finnor_os.y4_events_id_seq TO finnor_app;\n-- A confidential value remains recipient-scoped after entering the existing\n-- typed consumer. Tenant membership alone must not expose its snapshot,\n-- derivatives or hiding material. This is isolation, not source-currentness\n-- or admission; the existing owner transaction still checks those predicates.\nCREATE FUNCTION finnor_os.y4_recipient_snapshot_scope(p_tenant uuid,p_snapshot jsonb)\nRETURNS boolean LANGUAGE sql VOLATILE SECURITY INVOKER\nSET search_path=pg_catalog,finnor_os AS $$\n WITH refs AS (\n  SELECT ref FROM jsonb_path_query(p_snapshot,\n   '$.values.*.provenance[*] ? (@.kind == \"confidential_computation\")') AS item(ref)\n )\n SELECT p_tenant=finnor_os.request_tenant_id() AND NOT EXISTS(\n  SELECT 1 FROM refs r WHERE NOT EXISTS(\n   SELECT 1 FROM finnor_os.y4_releases l\n   JOIN finnor_os.y4_computations q ON q.tenant_id=l.tenant_id AND q.id=l.computation_id\n   WHERE l.tenant_id=p_tenant AND l.principal_id=NULLIF(current_setting('app.user_id',true),'')::uuid\n    AND q.id::text=r.ref->>'id' AND l.id::text=r.ref->>'versionId'\n    AND l.body_digest=r.ref->>'semanticHash'\n    AND q.status='COMPUTED' AND q.deadline_at>clock_timestamp()\n    AND NOT EXISTS(SELECT 1 FROM finnor_os.y4_revocations v\n     WHERE v.tenant_id=q.tenant_id AND v.computation_id=q.id)\n    AND EXISTS(SELECT 1 FROM jsonb_array_elements(l.body->'outputs') AS output(value)\n     WHERE output.value->>'key'=r.ref->>'anchorId')\n  )\n )\n$$;\nREVOKE ALL ON FUNCTION finnor_os.y4_recipient_snapshot_scope(uuid,jsonb) FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION finnor_os.y4_recipient_snapshot_scope(uuid,jsonb) TO finnor_app,finnor_worker;\nCREATE POLICY y4_recipient_derivative ON finnor_os.underwriting_runs AS RESTRICTIVE\n USING(finnor_os.y4_recipient_snapshot_scope(tenant_id,input_snapshot))\n WITH CHECK(finnor_os.y4_recipient_snapshot_scope(tenant_id,input_snapshot));\nCREATE POLICY y4_recipient_derivative ON finnor_os.underwriting_sensitivities AS RESTRICTIVE\n USING(EXISTS(SELECT 1 FROM finnor_os.underwriting_runs r\n  WHERE r.tenant_id=underwriting_sensitivities.tenant_id AND r.id=underwriting_sensitivities.base_run_id))\n WITH CHECK(EXISTS(SELECT 1 FROM finnor_os.underwriting_runs r\n  WHERE r.tenant_id=underwriting_sensitivities.tenant_id AND r.id=underwriting_sensitivities.base_run_id));\nCREATE POLICY y4_recipient_derivative ON finnor_os.underwriting_sensitivity_cells AS RESTRICTIVE\n USING(EXISTS(SELECT 1 FROM finnor_os.underwriting_runs r\n  WHERE r.tenant_id=underwriting_sensitivity_cells.tenant_id AND r.id=underwriting_sensitivity_cells.run_id)\n  AND EXISTS(SELECT 1 FROM finnor_os.underwriting_sensitivities s\n   WHERE s.tenant_id=underwriting_sensitivity_cells.tenant_id AND s.id=underwriting_sensitivity_cells.sensitivity_id))\n WITH CHECK(EXISTS(SELECT 1 FROM finnor_os.underwriting_runs r\n  WHERE r.tenant_id=underwriting_sensitivity_cells.tenant_id AND r.id=underwriting_sensitivity_cells.run_id)\n  AND EXISTS(SELECT 1 FROM finnor_os.underwriting_sensitivities s\n   WHERE s.tenant_id=underwriting_sensitivity_cells.tenant_id AND s.id=underwriting_sensitivity_cells.sensitivity_id));\nINSERT INTO finnor_os.compute_job_type_policies\n (job_type,default_class,allowed_classes,classification_rule,tenant_scope,obligation_kind,policy_revision,rationale)\n VALUES('run_confidential_economic_computation_v1','INTERACTIVE',ARRAY['INTERACTIVE'],'fixed','tenant','required',1,\n 'Y4 checked public compilation and recipient-private MPC under an original Work; uncertain input-accepting sessions reconcile without resubmission. No protected or production authority.');\nINSERT INTO finnor_os.compute_resource_policies\n (resource_key,capacity,per_tenant_capacity,interactive_reserve,lease_seconds,source)\n VALUES('native:y4-confidential',1,1,0,90,'Y4 serial checked compiler and local encrypted malicious-secure runtime; no authority for real effects');\n" },
   { name: "postx_y4_confidential_owner_consumption.sql", sql: "-- Additive recipient privacy at actual S5/S6 storage, not an alternate ledger.\n-- Serial production ordinal/integration remains unallocated.\nCREATE FUNCTION finnor_os.y4_contains_release(p_body jsonb)\nRETURNS boolean LANGUAGE sql IMMUTABLE SET search_path=pg_catalog AS $$\n SELECT COALESCE(jsonb_path_exists(p_body,'strict $.** ? (@.owner == \"Y4_CONFIDENTIAL_RELEASE\")'),false)\n$$;\nCREATE FUNCTION finnor_os.y4_s5_private(p_tenant uuid,p_digest text)\nRETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\n SELECT p_tenant=finnor_os.request_tenant_id() AND EXISTS(SELECT 1 FROM finnor_os.s5_proposals p WHERE p.tenant_id=p_tenant\n  AND p.content_digest=p_digest AND finnor_os.y4_contains_release(p.problem))\n$$;\nCREATE FUNCTION finnor_os.y4_s5_visible(p_tenant uuid,p_digest text)\nRETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\n SELECT p_tenant=finnor_os.request_tenant_id() AND\n  (NOT finnor_os.y4_s5_private(p_tenant,p_digest) OR EXISTS(\n   SELECT 1 FROM finnor_os.s5_proposals p WHERE p.tenant_id=p_tenant\n    AND p.content_digest=p_digest\n    AND p.principal_id=nullif(current_setting('app.user_id',true),'')::uuid))\n$$;\nCREATE FUNCTION finnor_os.y4_s5_subject_visible(p_tenant uuid,p_subject text)\nRETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\n SELECT p_tenant=finnor_os.request_tenant_id() AND NOT EXISTS(\n  SELECT 1 FROM finnor_os.s5_reservation_origins o\n   LEFT JOIN finnor_os.s5_consumptions co USING(tenant_id,reservation_id)\n   WHERE o.tenant_id=p_tenant AND (o.reservation_id=p_subject OR co.consumption_id=p_subject)\n    AND NOT finnor_os.y4_s5_visible(o.tenant_id,o.allocation_digest))\n  AND NOT EXISTS(SELECT 1 FROM finnor_os.s5_proposals p WHERE p.tenant_id=p_tenant\n   AND (p.content_digest=p_subject OR p.certificate->'ref'->>'id'=p_subject\n    OR p.problem->'ref'->>'id'=p_subject OR p.certificate->'compute'->>'id'=p_subject)\n   AND NOT finnor_os.y4_s5_visible(p.tenant_id,p.content_digest))\n  AND NOT EXISTS(SELECT 1 FROM finnor_os.s6_obligation_origins o WHERE o.tenant_id=p_tenant\n   AND (o.obligation_id=p_subject OR o.effect_id::text=p_subject OR o.domain_action_id::text=p_subject)\n   AND NOT finnor_os.y4_s5_visible(p_tenant,o.body->'allocationRef'->>'contentDigest'))\n$$;\nCREATE FUNCTION finnor_os.y4_allocation_context_complete()\nRETURNS boolean LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\nDECLARE t uuid:=finnor_os.request_tenant_id();\n u uuid:=nullif(current_setting('app.user_id',true),'')::uuid;\nBEGIN\n IF t IS NULL OR u IS NULL OR NOT EXISTS(SELECT 1 FROM finnor_os.users\n  WHERE tenant_id=t AND id=u AND status='active' AND role='owner') THEN RETURN false; END IF;\n -- Refuse an incomplete aggregate. Hidden reservations are never treated as zero.\n RETURN NOT EXISTS(SELECT 1 FROM finnor_os.s5_reservations s\n  JOIN finnor_os.s5_proposals p ON p.tenant_id=s.tenant_id AND p.content_digest=s.allocation_digest\n  WHERE s.tenant_id=t AND s.status<>'RELEASED'\n   AND p.principal_id<>u AND finnor_os.y4_contains_release(p.problem));\nEND $$;\nCREATE FUNCTION finnor_os.y4_s5_experience_visible(p_tenant uuid,p_principal uuid,p_body jsonb)\nRETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\n SELECT p_tenant=finnor_os.request_tenant_id() AND\n  (p_principal=nullif(current_setting('app.user_id',true),'')::uuid OR (\n   NOT finnor_os.y4_contains_release(p_body)\n   AND finnor_os.y4_s5_subject_visible(p_tenant,p_body->>'revisionRef')\n   AND NOT EXISTS(SELECT 1 FROM finnor_os.s5_experience e\n    WHERE e.tenant_id=p_tenant AND e.body->>'revisionRef'=p_body->>'revisionRef'\n     AND finnor_os.y4_contains_release(e.body))))\n$$;\nCREATE FUNCTION finnor_os.y4_s6_effect_visible(p_tenant uuid,p_effect uuid)\nRETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\n SELECT p_tenant=finnor_os.request_tenant_id() AND NOT EXISTS(\n  SELECT 1 FROM finnor_os.s6_obligation_origins o WHERE o.tenant_id=p_tenant\n   AND o.effect_id=p_effect AND NOT finnor_os.y4_s5_visible(p_tenant,o.body->'allocationRef'->>'contentDigest'))\n$$;\nCREATE FUNCTION finnor_os.y4_delivery_visible(p_tenant uuid,p_principal uuid,p_owner text,p_kind text,p_identity text)\nRETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\n SELECT p_tenant=finnor_os.request_tenant_id() AND\n  (p_principal=nullif(current_setting('app.user_id',true),'')::uuid OR NOT EXISTS(\n   SELECT 1 FROM finnor_os.s6_owner_delivery_origins o WHERE o.tenant_id=p_tenant\n    AND o.principal_id=p_principal AND o.semantic_owner=p_owner AND o.kind=p_kind AND o.identity=p_identity\n    AND (finnor_os.y4_contains_release(o.envelope)\n     OR NOT finnor_os.y4_s5_subject_visible(p_tenant,p_identity)\n     OR p_owner='S5' AND p_kind='EVENT' AND NOT finnor_os.y4_s5_experience_visible(p_tenant,p_principal,o.envelope->'payload'->'event')\n     OR NOT finnor_os.y4_s5_visible(p_tenant,COALESCE(\n      o.envelope#>>'{payload,reference,content,allocationRef,contentDigest}',\n      o.envelope#>>'{payload,event,detail,allocationRef,contentDigest}')))))\n$$;\nCREATE FUNCTION finnor_os.y4_control_context_complete()\nRETURNS boolean LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\nDECLARE t uuid:=finnor_os.request_tenant_id();\n u uuid:=nullif(current_setting('app.user_id',true),'')::uuid;\nBEGIN\n IF t IS NULL OR u IS NULL OR NOT EXISTS(SELECT 1 FROM finnor_os.users\n  WHERE tenant_id=t AND id=u AND status='active' AND role='owner') THEN RETURN false; END IF;\n RETURN NOT EXISTS(SELECT 1 FROM finnor_os.business_effects e\n  WHERE e.tenant_id=t AND e.status NOT IN('verified','cancelled','compensated')\n   AND NOT finnor_os.y4_s6_effect_visible(t,e.id));\nEND $$;\n-- Raw ordinary-role writes preserve the same original principal boundary as\n-- the authenticated owners. Tenant membership is not another party's consent.\nCREATE FUNCTION finnor_os.y4_write_identity() RETURNS trigger\nLANGUAGE plpgsql SET search_path=pg_catalog,finnor_os AS $$\nDECLARE t uuid:=finnor_os.request_tenant_id();\n u uuid:=nullif(current_setting('app.user_id',true),'')::uuid;\n q finnor_os.y4_computations;\nBEGIN\n -- A database administrator already controls tables/triggers; no ordinary\n -- application or worker role has this privilege.\n IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname=current_user AND rolsuper) THEN RETURN NEW; END IF;\n IF t IS NULL OR u IS NULL OR NEW.tenant_id IS DISTINCT FROM t\n  OR NOT EXISTS(SELECT 1 FROM finnor_os.users WHERE tenant_id=t AND id=u AND status='active')\n  THEN RAISE EXCEPTION 'Y4_ORIGINAL_WRITE_PRINCIPAL_REQUIRED' USING ERRCODE='42501'; END IF;\n IF TG_TABLE_NAME='y4_computations' THEN\n  IF TG_OP='INSERT' AND NEW.principal_id=u THEN RETURN NEW; END IF;\n  IF TG_OP='UPDATE' THEN\n   IF OLD.principal_id=u THEN RETURN NEW; END IF;\n   -- A participant's immutable audit insertion charges the parent's original\n   -- retained-byte budget. This nested trigger can change no other field.\n   IF pg_trigger_depth()>1 AND to_jsonb(NEW)-'data_bytes' IS NOT DISTINCT FROM to_jsonb(OLD)-'data_bytes'\n    THEN RETURN NEW; END IF;\n   -- Only the completed original commitment barrier may advance a computation\n   -- for a noninitiating participant, never its budgets, session or result.\n   IF OLD.status='AWAITING_PARTICIPANTS' AND NEW.status='READY'\n    AND to_jsonb(NEW)-'status' IS NOT DISTINCT FROM to_jsonb(OLD)-'status'\n    AND EXISTS(SELECT 1 FROM finnor_os.y4_consents c WHERE c.tenant_id=t AND c.computation_id=OLD.id AND c.principal_id=u)\n    AND jsonb_array_length(OLD.request->'function'->'participants')=\n      (SELECT count(*) FROM finnor_os.y4_commitments c WHERE c.tenant_id=t AND c.computation_id=OLD.id)\n    THEN RETURN NEW; END IF;\n  END IF;\n ELSE\n  SELECT * INTO q FROM finnor_os.y4_computations WHERE tenant_id=t AND id=NEW.computation_id;\n  IF NOT FOUND THEN RAISE EXCEPTION 'Y4_ORIGINAL_WRITE_PRINCIPAL_REQUIRED' USING ERRCODE='42501'; END IF;\n  IF TG_TABLE_NAME='y4_consents' THEN\n   IF NEW.principal_id=u AND NEW.body->>'participantId'=NEW.participant_id\n    AND EXISTS(SELECT 1 FROM jsonb_array_elements(q.request->'function'->'inputs') p WHERE p->>'participantId'=NEW.participant_id)\n    AND NOT EXISTS(SELECT 1 FROM jsonb_array_elements(q.request->'function'->'inputs') p\n     WHERE p->>'participantId'=NEW.participant_id AND NOT EXISTS(\n      SELECT 1 FROM finnor_os.y4_source_handles h\n      JOIN jsonb_array_elements(q.request->'function'->'participants') party ON party->>'id'=NEW.participant_id\n      WHERE h.tenant_id=t AND h.principal_id=u AND h.id::text=p->'grantRef'->>'id'\n       AND h.public_digest=p->'grantRef'->>'contentDigest'\n       AND h.public_body->>'institutionId'=party->>'institutionId'))\n    THEN RETURN NEW; END IF;\n  ELSIF TG_TABLE_NAME IN('y4_revocations','y4_commitments','y4_releases') THEN\n   IF NEW.principal_id=u AND EXISTS(SELECT 1 FROM finnor_os.y4_consents c\n    WHERE c.tenant_id=t AND c.computation_id=q.id AND c.participant_id=NEW.participant_id AND c.principal_id=u)\n    THEN RETURN NEW; END IF;\n  ELSIF TG_TABLE_NAME='y4_disclosures' THEN\n   IF q.principal_id=u AND EXISTS(\n    SELECT 1 FROM jsonb_array_elements(q.request->'function'->'inputs') p\n    JOIN jsonb_array_elements(q.request->'function'->'participants') party ON party->>'id'=p->>'participantId'\n    JOIN finnor_os.y4_consents c ON c.tenant_id=t AND c.computation_id=q.id AND c.participant_id=party->>'id'\n    WHERE party->>'institutionId'=NEW.institution_id::text AND p->'sourceRef'->>'owner'='Y4_SOURCE_VERSION_IDENTITY'\n     AND encode(sha256(convert_to(format('{\"id\":%s,\"owner\":\"Y4_SOURCE_VERSION_IDENTITY\"}',\n       to_json(p->'sourceRef'->>'id')),'UTF8')),'hex')=NEW.source_key)\n    THEN RETURN NEW; END IF;\n  ELSIF TG_TABLE_NAME='y4_events' THEN\n   IF NEW.actor_id=u AND (q.principal_id=u OR (\n    NEW.kind IN('PARTICIPANT_CONSENT','INPUT_COMMITMENT_ACCEPTED','CONSENT_REVOKED','RECIPIENT_RELEASE_IMPORTED',\n     'NATIVE_UNDERWRITING_CONSUMED','NATIVE_S4_S5_S6_PREPARED')\n    AND EXISTS(SELECT 1 FROM finnor_os.y4_consents c WHERE c.tenant_id=t AND c.computation_id=q.id\n     AND c.principal_id=u AND (NEW.body->>'participantId' IS NULL OR c.participant_id=NEW.body->>'participantId'))))\n    THEN RETURN NEW; END IF;\n  END IF;\n END IF;\n RAISE EXCEPTION 'Y4_ORIGINAL_WRITE_PRINCIPAL_REQUIRED' USING ERRCODE='42501';\nEND $$;\nDO $$ DECLARE t text; BEGIN\n FOREACH t IN ARRAY ARRAY['y4_computations','y4_consents','y4_revocations','y4_disclosures','y4_commitments','y4_releases','y4_events'] LOOP\n  EXECUTE format('CREATE TRIGGER y4_principal_write BEFORE INSERT OR UPDATE ON finnor_os.%I\n   FOR EACH ROW EXECUTE FUNCTION finnor_os.y4_write_identity()',t);\n END LOOP;\nEND $$;\nREVOKE ALL ON FUNCTION finnor_os.y4_write_identity() FROM PUBLIC;\nCREATE POLICY y4_s5_proposal_privacy ON finnor_os.s5_proposals AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_s5_visible(tenant_id,content_digest));\nCREATE POLICY y4_s5_request_privacy ON finnor_os.s5_requests AS RESTRICTIVE FOR SELECT\n USING(principal_id=nullif(current_setting('app.user_id',true),'')::uuid\n  OR NOT finnor_os.y4_s5_private(tenant_id,allocation_digest));\nCREATE POLICY y4_s5_origin_privacy ON finnor_os.s5_reservation_origins AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_s5_visible(tenant_id,allocation_digest));\nCREATE POLICY y4_s5_reservation_privacy ON finnor_os.s5_reservations AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_s5_visible(tenant_id,allocation_digest));\nCREATE POLICY y4_s5_consumption_privacy ON finnor_os.s5_consumptions AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_s5_subject_visible(tenant_id,reservation_id));\nCREATE POLICY y4_s5_state_privacy ON finnor_os.s5_consumption_states AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_s5_subject_visible(tenant_id,consumption_id));\nCREATE POLICY y4_s5_history_privacy ON finnor_os.s5_history AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_s5_subject_visible(tenant_id,subject_id));\nCREATE POLICY y4_s5_experience_privacy ON finnor_os.s5_experience AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_s5_experience_visible(tenant_id,principal_id,body));\nCREATE POLICY y4_s6_origin_privacy ON finnor_os.s6_obligation_origins AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_s5_visible(tenant_id,body->'allocationRef'->>'contentDigest'));\nCREATE POLICY y4_s6_effect_privacy ON finnor_os.business_effects AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_s6_effect_visible(tenant_id,id));\nCREATE POLICY y4_s6_action_privacy ON finnor_os.domain_actions AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_s6_effect_visible(tenant_id,business_effect_id));\nCREATE POLICY y4_delivery_origin_privacy ON finnor_os.s6_owner_delivery_origins AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_delivery_visible(tenant_id,principal_id,semantic_owner,kind,identity));\nCREATE POLICY y4_delivery_state_privacy ON finnor_os.s6_owner_delivery_states AS RESTRICTIVE FOR SELECT\n USING(finnor_os.y4_delivery_visible(tenant_id,principal_id,semantic_owner,kind,identity));\nDO $$ DECLARE f text; BEGIN\n FOREACH f IN ARRAY ARRAY['y4_contains_release(jsonb)','y4_s5_private(uuid,text)',\n 'y4_s5_visible(uuid,text)','y4_s5_subject_visible(uuid,text)',\n 'y4_allocation_context_complete()','y4_s5_experience_visible(uuid,uuid,jsonb)',\n 'y4_s6_effect_visible(uuid,uuid)','y4_delivery_visible(uuid,uuid,text,text,text)',\n 'y4_control_context_complete()'] LOOP\n  EXECUTE 'REVOKE ALL ON FUNCTION finnor_os.'||f||' FROM PUBLIC';\n  EXECUTE 'GRANT EXECUTE ON FUNCTION finnor_os.'||f||' TO finnor_app,finnor_worker';\n END LOOP;\nEND $$;\n" },
   { name: "postx_y4_runtime_migration_order.sql", sql: "-- Use the same bytewise filename order as the source manifest and migration runner.\n-- Preserve the complete existing freeze/activation predicates and privileges.\n\nCREATE OR REPLACE FUNCTION finnor_os.freeze_water_intake(\n  p_expected_epoch integer,p_actor text,p_evidence jsonb DEFAULT '{}'::jsonb\n) RETURNS integer\nLANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\nDECLARE\n  current_row finnor_os.product_runtime_authority%ROWTYPE;\n  required_roles text[];\n  role_name text;\n  release_count integer;\n  expected_migration_head text;\nBEGIN\n  IF coalesce(btrim(p_actor),'')='' OR jsonb_typeof(p_evidence)<>'object' THEN\n    RAISE EXCEPTION 'cutover actor and object evidence are required';\n  END IF;\n  IF NOT (p_evidence @> '{\"p0P4Verified\":true}'::jsonb) THEN\n    RAISE EXCEPTION 'P0-P4 prerequisite verification evidence is required before intake freeze';\n  END IF;\n  SELECT max(name COLLATE \"C\") INTO expected_migration_head FROM finnor_os._migrations;\n  IF expected_migration_head IS NULL THEN\n    RAISE EXCEPTION 'cutover migration provenance is unavailable';\n  END IF;\n  PERFORM pg_advisory_xact_lock(hashtextextended('product_runtime_authority',0));\n  SELECT * INTO current_row FROM finnor_os.product_runtime_authority\n   WHERE authority_key='product' FOR UPDATE;\n  IF current_row.epoch<>p_expected_epoch THEN RAISE EXCEPTION 'stale product runtime epoch'; END IF;\n  IF current_row.state='water_retired' THEN RETURN current_row.epoch; END IF;\n  required_roles := finnor_os.phase8_runtime_roles();\n  IF current_row.state='preparing' THEN\n    FOREACH role_name IN ARRAY required_roles LOOP\n      IF NOT EXISTS (\n        SELECT 1 FROM finnor_os.service_release_heartbeats h\n         WHERE h.service=role_name\n           AND h.last_beat_at>now()-interval '90 seconds'\n           AND h.cutover_protocol>=current_row.minimum_cutover_protocol\n           AND h.product_epoch=current_row.epoch\n           AND h.migration_head=expected_migration_head\n           AND h.release_sha ~ '^[0-9a-f]{40}$'\n      ) OR EXISTS (\n        SELECT 1 FROM finnor_os.service_release_heartbeats h\n         WHERE h.service=role_name AND h.last_beat_at>now()-interval '90 seconds'\n           AND (h.cutover_protocol<current_row.minimum_cutover_protocol\n             OR h.product_epoch<>current_row.epoch\n             OR h.migration_head<>expected_migration_head)\n      ) THEN\n        RAISE EXCEPTION 'mixed-fleet freeze blocked: compatible % provenance is not exclusive',role_name;\n      END IF;\n    END LOOP;\n    SELECT count(DISTINCT release_sha)::integer INTO release_count\n      FROM finnor_os.service_release_heartbeats\n     WHERE service=ANY(required_roles) AND last_beat_at>now()-interval '90 seconds';\n    IF release_count<>1 THEN RAISE EXCEPTION 'mixed-fleet freeze blocked: runtime roles do not share one release'; END IF;\n    UPDATE finnor_os.product_runtime_authority\n       SET state='water_intake_frozen',water_intake_frozen_at=now(),activated_by=p_actor,\n           activation_evidence=activation_evidence||p_evidence,updated_at=now()\n     WHERE authority_key='product';\n  END IF;\n  RETURN current_row.epoch;\nEND $$;\n\nCREATE OR REPLACE FUNCTION finnor_os.activate_private_equity_product_authority(\n  p_expected_epoch integer,p_actor text,p_evidence jsonb DEFAULT '{}'::jsonb\n) RETURNS integer\nLANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\nDECLARE\n  current_row finnor_os.product_runtime_authority%ROWTYPE;\n  required_roles text[];\n  role_name text;\n  blocker record;\n  release_count integer;\n  disabled_trigger_count integer;\n  expected_migration_head text;\nBEGIN\n  IF coalesce(btrim(p_actor),'')='' OR jsonb_typeof(p_evidence)<>'object' THEN\n    RAISE EXCEPTION 'cutover actor and object evidence are required';\n  END IF;\n  IF NOT (p_evidence @> '{\"safetyCensusZero\":true}'::jsonb) THEN\n    RAISE EXCEPTION 'explicit zero safety-census evidence is required before retirement';\n  END IF;\n  SELECT max(name COLLATE \"C\") INTO expected_migration_head FROM finnor_os._migrations;\n  IF expected_migration_head IS NULL THEN\n    RAISE EXCEPTION 'cutover migration provenance is unavailable';\n  END IF;\n  PERFORM pg_advisory_xact_lock(hashtextextended('product_runtime_authority',0));\n  SELECT * INTO current_row FROM finnor_os.product_runtime_authority\n   WHERE authority_key='product' FOR UPDATE;\n  IF current_row.epoch<>p_expected_epoch THEN RAISE EXCEPTION 'stale product runtime epoch'; END IF;\n  IF current_row.state='water_retired' THEN RETURN current_row.epoch; END IF;\n  IF current_row.state<>'water_intake_frozen' THEN RAISE EXCEPTION 'Water intake must be frozen before retirement'; END IF;\n  required_roles := finnor_os.phase8_runtime_roles();\n\n  FOREACH role_name IN ARRAY required_roles LOOP\n    IF NOT EXISTS (\n      SELECT 1 FROM finnor_os.service_release_heartbeats h\n       WHERE h.service=role_name\n         AND h.last_beat_at>now()-interval '90 seconds'\n         AND h.cutover_protocol>=current_row.minimum_cutover_protocol\n         AND h.product_epoch=current_row.epoch\n         AND h.migration_head=expected_migration_head\n         AND h.release_sha ~ '^[0-9a-f]{40}$'\n    ) THEN\n      RAISE EXCEPTION 'mixed-fleet cutover blocked: compatible % provenance is missing',role_name;\n    END IF;\n    IF EXISTS (\n      SELECT 1 FROM finnor_os.service_release_heartbeats h\n       WHERE h.service=role_name AND h.last_beat_at>now()-interval '90 seconds'\n         AND (h.cutover_protocol<current_row.minimum_cutover_protocol\n           OR h.product_epoch<>current_row.epoch\n           OR h.migration_head<>expected_migration_head)\n    ) THEN\n      RAISE EXCEPTION 'mixed-fleet cutover blocked: incompatible % instance is still live',role_name;\n    END IF;\n  END LOOP;\n\n  SELECT count(DISTINCT release_sha)::integer INTO release_count\n    FROM finnor_os.service_release_heartbeats\n   WHERE service=ANY(required_roles) AND last_beat_at>now()-interval '90 seconds';\n  IF release_count<>1 THEN RAISE EXCEPTION 'mixed-fleet cutover blocked: runtime roles do not share one release'; END IF;\n\n  FOR blocker IN SELECT * FROM finnor_os.water_retirement_blockers() LOOP\n    IF blocker.blocking_count<>0 THEN\n      RAISE EXCEPTION 'Water retirement safety gate blocked: %=%',blocker.category,blocker.blocking_count;\n    END IF;\n  END LOOP;\n\n  UPDATE finnor_os.jobs\n     SET status='quarantined',last_error='RETIRED_VERTICAL: historical Water job is non-executable',\n         lease_owner=NULL,lease_expires_at=NULL,lease_heartbeat_at=NULL\n   WHERE finnor_os.is_retired_water_job(type,payload) AND status='dead_letter';\n\n  UPDATE finnor_os.vertical_definitions\n     SET active=CASE key WHEN 'water' THEN false WHEN 'private_equity' THEN true ELSE active END,\n         updated_at=now()\n   WHERE key IN ('water','private_equity');\n  UPDATE finnor_os.canonical_truth_registry SET active=false,work_attachable=false,updated_at=now()\n   WHERE vertical_key='water' OR entity_type IN ('business_operation','business_operation_target');\n  UPDATE finnor_os.domain_policies SET active=false\n   WHERE finnor_os.is_retired_water_action(action_type)\n      OR finnor_os.active_tenant_vertical(tenant_id)='water';\n  UPDATE finnor_os.employee_roles SET active=false,updated_at=now()\n   WHERE legacy_role IN ('dispatcher','technician')\n      OR key IN ('dispatcher','technician');\n  UPDATE finnor_os.employee_role_assignments a SET active=false\n   WHERE EXISTS (SELECT 1 FROM finnor_os.employee_roles r WHERE r.id=a.role_id AND NOT r.active);\n  UPDATE finnor_os.users SET status='suspended'\n   WHERE role<>'owner' AND status='active';\n  UPDATE finnor_os.tenant_settings\n     SET is_dealer_zero=false,simulator_enabled=false,training_mode=false,\n         workspace_config=CASE\n           WHEN finnor_os.active_tenant_vertical(tenant_id)='private_equity'\n             THEN finnor_os.default_private_equity_workspace_config()\n           ELSE workspace_config\n         END,\n         updated_at=now()\n   WHERE is_dealer_zero OR simulator_enabled OR training_mode;\n  UPDATE finnor_os.tenant_settings\n     SET workspace_config=finnor_os.default_private_equity_workspace_config(),updated_at=now()\n   WHERE finnor_os.active_tenant_vertical(tenant_id)='private_equity'\n     AND workspace_config IS DISTINCT FROM finnor_os.default_private_equity_workspace_config();\n\n  SELECT finnor_os.disable_water_behavior_triggers() INTO disabled_trigger_count;\n\n  UPDATE finnor_os.product_runtime_authority\n     SET epoch=epoch+1,state='water_retired',water_retired_at=now(),activated_by=p_actor,\n         activation_evidence=activation_evidence||p_evidence\n           ||jsonb_build_object('waterBehaviorTriggersDropped',disabled_trigger_count),updated_at=now()\n   WHERE authority_key='product';\n  RETURN current_row.epoch+1;\nEND $$;\n\n" },
+  { name: "postz_z0_institution_application_bridge.sql", sql: "-- Coordinator integration input, NOT an applied migration or an access grant.\n-- Install after the existing X1/X2 migrations using the canonical DB owner.\n-- Existing institution owner guards, RLS, occupancy and immutable history stay.\n-- No reservation, resource, allowance, release or effect-dispatch writer is added.\n\nCREATE FUNCTION finnor_os.z0_s5_application_frame(p_ref jsonb,p_decision uuid,p_recovery boolean)\nRETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\nDECLARE t uuid:=finnor_os.request_tenant_id();\n u uuid:=nullif(current_setting('app.user_id',true),'')::uuid;\n cert jsonb; origin jsonb; parent jsonb; parent_status text; parent_envelopes jsonb;\n compiler finnor_os.x1_compiler_requests%ROWTYPE;\n programme finnor_os.p1_requests%ROWTYPE;\n episode finnor_os.x1_compiler_episodes%ROWTYPE;\n duty jsonb; duties integer; line jsonb; original_line jsonb; requested jsonb;\n subject jsonb; subject_count integer;\nBEGIN\n IF t IS NULL OR u IS NULL OR NOT EXISTS(SELECT 1 FROM finnor_os.users\n  WHERE tenant_id=t AND id=u AND status='active' AND role='owner')\n  THEN RAISE EXCEPTION 'Z0 authenticated original owner required'; END IF;\n PERFORM pg_advisory_xact_lock(hashtextextended('s5-portfolio:'||t::text,0));\n PERFORM pg_advisory_xact_lock(hashtextextended(t::text,5510));\n SELECT a.body INTO cert FROM finnor_os.application_semantics_artifacts a\n  WHERE a.tenant_id=t AND a.principal_id=u AND a.artifact_id=p_ref->>'id'\n   AND a.semantic_owner='S5' AND a.version='application-operation-v1'\n   AND a.content_digest=p_ref->>'contentDigest';\n IF cert IS NULL OR p_ref->>'owner' IS DISTINCT FROM 'S5'\n  OR p_ref->>'version' IS DISTINCT FROM 'application-operation-v1'\n  OR p_ref->>'id' IS DISTINCT FROM 'institution-application-allocation:'||(p_ref->>'contentDigest')\n  OR cert->>'schema' IS DISTINCT FROM 'finnor.s5.application-allocation.v1'\n  OR cert->>'occupation' IS DISTINCT FROM 'EXISTING_ORIGINAL_X1_RESERVATION_NO_NEW_FUNDING'\n  OR cert->>'tenantId' IS DISTINCT FROM t::text OR cert->>'principalId' IS DISTINCT FROM u::text\n  OR cert->'executionAuthorityGranted' IS DISTINCT FROM 'false'::jsonb\n  OR jsonb_typeof(cert->'check'->'envelopes') IS DISTINCT FROM 'array'\n  OR jsonb_typeof(cert->'acquisitionRequest'->'resourceDemand') IS DISTINCT FROM 'array'\n  OR jsonb_typeof(cert->'resourceRefs') IS DISTINCT FROM 'array'\n  THEN RAISE EXCEPTION 'Z0 inherited allocation preimage unavailable'; END IF;\n SELECT a.body INTO origin FROM finnor_os.application_semantics_artifacts a\n  WHERE a.tenant_id=t AND a.principal_id=u AND a.artifact_id=cert->'institutionalOriginRef'->>'id'\n   AND a.semantic_owner='S4' AND a.version=cert->'institutionalOriginRef'->>'version'\n   AND a.content_digest=cert->'institutionalOriginRef'->>'contentDigest';\n IF origin IS NULL OR origin->>'schema' IS DISTINCT FROM 'finnor.z0.institution-application-origin.v1'\n  OR origin->>'tenantId' IS DISTINCT FROM t::text OR origin->>'principalId' IS DISTINCT FROM u::text\n  OR origin->>'workId' IS DISTINCT FROM cert->>'workId'\n  OR origin->>'deadlineAt' IS DISTINCT FROM cert->>'deadlineAt'\n  OR origin->'originalReservationRef' IS DISTINCT FROM cert->'originalReservationRef'\n  OR origin->>'purpose' IS DISTINCT FROM 'LEARN_APPLICATION_MODEL_THEN_RETURN_TO_ORIGINAL_P1'\n  OR origin->'executionAuthorityGranted' IS DISTINCT FROM 'false'::jsonb\n  OR origin->'protectedAdmission' IS DISTINCT FROM 'false'::jsonb\n  OR cert->'acquisitionRequest'->'institutionalOrigin' IS DISTINCT FROM origin->'selector'\n  OR cert->'acquisitionRequest'->>'workId' IS DISTINCT FROM origin->>'workId'\n  OR cert->'acquisitionRequest'->'root' IS DISTINCT FROM origin->'root'\n  OR cert->'acquisitionRequest'->>'deadlineAt' IS DISTINCT FROM origin->>'deadlineAt'\n  THEN RAISE EXCEPTION 'Z0 original institution binding unavailable'; END IF;\n SELECT * INTO compiler FROM finnor_os.x1_compiler_requests\n  WHERE tenant_id=t AND principal_id=u AND id=(origin->'selector'->>'compilerRequestId')::uuid FOR SHARE;\n SELECT * INTO programme FROM finnor_os.p1_requests\n  WHERE tenant_id=t AND principal_id=u AND id=(origin->'selector'->>'programId')::uuid FOR SHARE;\n SELECT * INTO episode FROM finnor_os.x1_compiler_episodes\n  WHERE tenant_id=t AND principal_id=u AND id=compiler.episode_id FOR SHARE;\n IF compiler.id IS NULL OR programme.id IS NULL OR episode.id IS NULL\n  OR compiler.work_id IS DISTINCT FROM (origin->>'workId')::uuid\n  OR programme.work_id IS DISTINCT FROM compiler.work_id\n  OR compiler.work_input_id IS DISTINCT FROM (origin->>'workInputId')::uuid\n  OR programme.work_input_id IS DISTINCT FROM compiler.work_input_id\n  OR compiler.work_input_digest IS DISTINCT FROM origin->>'workInputDigest'\n  OR programme.work_input_digest IS DISTINCT FROM compiler.work_input_digest\n  OR origin->'root' IS DISTINCT FROM programme.request->'root'\n  OR compiler.program_id IS DISTINCT FROM programme.id\n  OR compiler.admission_id IS DISTINCT FROM (origin->>'admissionId')::uuid\n  OR episode.id IS DISTINCT FROM (origin->>'compilerEpisodeId')::uuid\n  OR episode.parent_reservation IS DISTINCT FROM origin->'originalReservationRef'\n  OR episode.parent_demand->>'demandDigest' IS DISTINCT FROM origin->>'originalDemandDigest'\n  OR programme.request->'institution'->'reservationRef' IS DISTINCT FROM episode.parent_reservation\n  OR programme.request->'institution'->'demand' IS DISTINCT FROM episode.parent_demand\n  OR programme.request->'institution'->>'compilerRequestId' IS DISTINCT FROM compiler.id::text\n  OR origin->'institutionalProgramRef'->>'owner' IS DISTINCT FROM 'S4_P1'\n  OR NOT EXISTS(SELECT 1 FROM finnor_os.x1_compiler_artifacts a WHERE a.tenant_id=t AND a.principal_id=u\n    AND a.request_id=compiler.id AND a.id=compiler.artifact_id\n    AND a.id::text=origin->'institutionalProgramRef'->>'id'\n    AND a.body_digest=origin->'institutionalProgramRef'->>'contentDigest'\n    AND a.body->'envelope'->>'schema_revision'=origin->'institutionalProgramRef'->>'version'\n    AND a.check_result->>'disposition'='ACCEPTED_DEVELOPMENT')\n  THEN RAISE EXCEPTION 'Z0 original owner/admission ancestry changed'; END IF;\n SELECT count(*),jsonb_agg(d.value)->0 INTO duties,duty\n  FROM finnor_os.x1_checked_artifacts a CROSS JOIN LATERAL jsonb_array_elements(a.responsibilities) d(value)\n  WHERE a.tenant_id=t AND a.principal_id=u AND a.work_id=compiler.work_id AND a.admission_id=compiler.admission_id\n    AND d.value->'obligation'->>'stableIdentity'=origin->'selector'->>'responsibilityIdentity';\n IF duties<>1 OR duty->'obligation'->>'responsiblePrincipal' IS DISTINCT FROM u::text\n  OR NOT (programme.request->'institution'->'responsibilities' @> jsonb_build_array(duty))\n  THEN RAISE EXCEPTION 'Z0 checked original responsibility required'; END IF;\n SELECT o.body,s.status,s.envelopes INTO parent,parent_status,parent_envelopes FROM finnor_os.s5_reservation_origins o\n  JOIN finnor_os.s5_reservations s USING(tenant_id,reservation_id)\n  WHERE o.tenant_id=t AND o.principal_id=u AND o.reservation_id=episode.parent_reservation->>'id'\n   AND o.body->>'schema'='finnor.s5.institution-reservation.v1' FOR UPDATE OF s;\n IF parent IS NULL OR parent_status='RELEASED'\n  OR parent->'ref' IS DISTINCT FROM episode.parent_reservation\n  OR parent->'envelopes' IS DISTINCT FROM parent_envelopes\n  OR parent->>'workId' IS DISTINCT FROM origin->>'workId'\n  OR parent->'demand'->>'demandDigest' IS DISTINCT FROM origin->>'originalDemandDigest'\n  THEN RAISE EXCEPTION 'Z0 original resource occupation unavailable'; END IF;\n IF NOT p_recovery THEN\n  IF p_decision IS NULL THEN RAISE EXCEPTION 'Z0 fresh original authority decision required'; END IF;\n  PERFORM finnor_os.s5_assert_institution_current(parent->'ref'->>'id',p_decision);\n  IF compiler.status NOT IN('WAITING','PARTIAL') OR programme.status NOT IN('WAITING','PARTIAL','FAILED')\n   OR compiler.generation IS DISTINCT FROM (origin->>'compilerGeneration')::integer\n   OR compiler.revision IS DISTINCT FROM (origin->>'compilerRevision')::integer\n   OR programme.generation IS DISTINCT FROM (origin->>'programmeGeneration')::integer\n   OR programme.episode_id IS DISTINCT FROM (origin->>'programmeEpisodeId')::uuid\n   OR programme.plan_revision_id IS DISTINCT FROM (origin->>'planRevisionId')::uuid\n   OR programme.request_digest IS DISTINCT FROM origin->>'programmeRequestDigest'\n   OR NOT EXISTS(SELECT 1 FROM finnor_os.works w\n      JOIN finnor_os.work_plan_revisions p ON p.tenant_id=w.tenant_id AND p.work_id=w.id\n      WHERE w.tenant_id=t AND w.id=compiler.work_id AND w.created_by=u\n        AND w.status NOT IN('completed','cancelled','failed')\n        AND p.id=programme.plan_revision_id AND p.work_input_id=compiler.work_input_id AND p.status='active'\n      FOR SHARE OF w,p)\n   OR compiler.programme_digest IS DISTINCT FROM origin->>'programmeDigest'\n   OR compiler.input_manifest->'current'->'sourceRevisions' IS DISTINCT FROM origin->'sourceRevisions'\n   OR compiler.input_manifest->'current'->>'rightsRevision' IS DISTINCT FROM origin->>'rightsRevision'\n   OR origin->>'rightsRevision' IS DISTINCT FROM (SELECT revision::text FROM finnor_os.authority_states WHERE tenant_id=t)\n   OR (SELECT i.id FROM finnor_os.work_inputs i WHERE i.tenant_id=t AND i.work_id=compiler.work_id\n     ORDER BY i.created_at DESC,i.id DESC LIMIT 1) IS DISTINCT FROM compiler.work_input_id\n   OR EXISTS(SELECT 1 FROM finnor_os.x1_compiler_requests newer WHERE newer.tenant_id=t\n      AND newer.principal_id=u AND newer.work_id=compiler.work_id AND newer.revision>compiler.revision)\n   OR (cert->>'deadlineAt')::timestamptz<=clock_timestamp()\n   OR (cert->>'deadlineAt')::timestamptz>LEAST(episode.original_deadline,episode.wall_deadline,\n      (duty->'obligation'->>'originalDeadline')::timestamptz,\n      (programme.proposed->'bounds'->>'deadlineAt')::timestamptz)\n   OR NOT EXISTS(SELECT 1 FROM finnor_os.x1_work_mandates m WHERE m.tenant_id=t AND m.principal_id=u\n      AND m.work_id=compiler.work_id AND m.revoked_at IS NULL AND m.valid_from<=clock_timestamp()\n      AND m.expires_at>clock_timestamp() AND m.revision=origin->>'mandateRevision')\n   THEN RAISE EXCEPTION 'Z0 original forward authority or deadline changed'; END IF;\n  PERFORM finnor_os.x1_assert_responsible_principals(compiler.work_id,compiler.input_manifest->'current'->'responsiblePrincipals');\n  PERFORM finnor_os.x1_assert_source_scopes(compiler.work_id,compiler.input_manifest->'current'->'sourceScopes',\n    ARRAY(SELECT jsonb_array_elements_text(compiler.grant_ids)::uuid));\n  PERFORM finnor_os.x1_assert_canonical_owner_cut(compiler.input_manifest->'current'->'canonicalOwners',true);\n  FOR subject IN SELECT value FROM jsonb_array_elements(\n    coalesce(compiler.input_manifest->'current'->'sensitiveSubjects','[]'::jsonb)) LOOP\n   IF jsonb_typeof(subject->'registrations') IS DISTINCT FROM 'array'\n     OR jsonb_array_length(subject->'registrations') NOT BETWEEN 1 AND 200\n     THEN RAISE EXCEPTION 'Z0 original subject population required'; END IF;\n   PERFORM 1 FROM finnor_os.x1_subject_identity_bindings b\n    JOIN finnor_os.x1_subject_consents consent ON consent.tenant_id=b.tenant_id\n      AND consent.subject_user_id=b.subject_user_id AND consent.institution_id=b.institution_id\n      AND consent.source_class=subject->>'sourceClass' AND consent.purpose=subject->>'purpose'\n    JOIN finnor_os.users actor ON actor.tenant_id=b.tenant_id AND actor.id=b.subject_user_id\n    WHERE b.tenant_id=t AND b.institution_id=subject->>'institutionId' AND b.source_id=subject->>'sourceId'\n      AND b.registration_id IN(SELECT value FROM jsonb_array_elements_text(subject->'registrations'))\n      AND b.revoked_at IS NULL AND b.valid_from<=clock_timestamp() AND b.expires_at>clock_timestamp()\n      AND consent.revoked_at IS NULL AND consent.granted_at<=clock_timestamp() AND consent.expires_at>clock_timestamp()\n      AND actor.status='active' FOR SHARE OF b,consent,actor;\n   GET DIAGNOSTICS subject_count = ROW_COUNT;\n   IF subject_count<>jsonb_array_length(subject->'registrations')\n     THEN RAISE EXCEPTION 'Z0 original subject consent changed'; END IF;\n  END LOOP;\n ELSIF p_decision IS NOT NULL THEN\n  -- Fresh permission to observe/account is not refreshed forward authority.\n  PERFORM finnor_os.x1_assert_input_decision(compiler.work_id,NULL,p_decision);\n END IF;\n IF jsonb_array_length(cert->'check'->'envelopes') NOT BETWEEN 1 AND 2\n  OR jsonb_array_length(cert->'acquisitionRequest'->'resourceDemand')<>jsonb_array_length(cert->'check'->'envelopes')\n  OR (SELECT count(DISTINCT value->>'resourceId') FROM jsonb_array_elements(cert->'check'->'envelopes'))<>\n    jsonb_array_length(cert->'check'->'envelopes')\n  THEN RAISE EXCEPTION 'Z0 child envelope population invalid'; END IF;\n FOR line IN SELECT value FROM jsonb_array_elements(cert->'check'->'envelopes') LOOP\n  SELECT value INTO original_line FROM jsonb_array_elements(parent->'envelopes')\n    WHERE value->>'resourceId'=line->>'resourceId' AND value->>'unit'=line->>'unit';\n  SELECT value INTO requested FROM jsonb_array_elements(cert->'acquisitionRequest'->'resourceDemand')\n    WHERE value->>'resourceId'=line->>'resourceId' AND value->>'unit'=line->>'unit';\n  IF original_line IS NULL OR requested IS NULL OR coalesce(line->>'unit','') NOT IN('request','seconds')\n   OR line->>'kind' IS DISTINCT FROM 'CUMULATIVE_EXPENDITURE'\n   OR jsonb_typeof(line->'quantities') IS DISTINCT FROM 'array'\n   OR line->'horizon' IS DISTINCT FROM original_line->'horizon'\n   OR jsonb_array_length(line->'quantities')<>jsonb_array_length(original_line->'quantities')\n   OR EXISTS(SELECT 1 FROM jsonb_array_elements_text(line->'quantities') WITH ORDINALITY q(value,n)\n     WHERE q.value !~ '^(0|[1-9][0-9]{0,15})$'\n       OR q.value::numeric>(original_line->'quantities'->>(q.n::integer-1))::numeric)\n   OR coalesce(requested->>'amount','') !~ '^[1-9][0-9]{0,3}$'\n   OR (requested->>'amount')::numeric>CASE WHEN line->>'unit'='seconds' THEN 900 ELSE 2048 END\n   OR (SELECT sum(value::numeric) FROM jsonb_array_elements_text(line->'quantities'))<>(requested->>'amount')::numeric\n   THEN RAISE EXCEPTION 'Z0 child envelope enlarges original resource'; END IF;\n END LOOP;\n RETURN jsonb_build_object('certificate',cert,'origin',origin,'parent',parent);\nEND $$;\nREVOKE ALL ON FUNCTION finnor_os.z0_s5_application_frame(jsonb,uuid,boolean) FROM PUBLIC;\n\nCREATE FUNCTION finnor_os.z0_s5_application_consumption(p_body jsonb,p_decision uuid)\nRETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\nDECLARE t uuid:=finnor_os.request_tenant_id(); u uuid:=nullif(current_setting('app.user_id',true),'')::uuid;\n frame jsonb; cert jsonb; parent jsonb; prior jsonb;\nBEGIN\n frame:=finnor_os.z0_s5_application_frame(p_body->'certificateRef',p_decision,false);\n cert:=frame->'certificate'; parent:=frame->'parent';\n IF p_body->>'schema' IS DISTINCT FROM 'finnor.s5.application-consumption.v1'\n  OR p_body->'reservationRef' IS DISTINCT FROM parent->'ref'\n  OR p_body->'originalParentRef' IS DISTINCT FROM cert->'originalParentRef'\n  OR p_body->'envelope' IS DISTINCT FROM parent->'envelopes'\n  OR p_body->>'status' IS DISTINCT FROM 'INTENDED_PENDING_S6'\n  OR p_body->'effectRef' IS DISTINCT FROM 'null'::jsonb\n  OR p_body->'executionAuthorityGranted' IS DISTINCT FROM 'false'::jsonb\n  OR p_body->'ref'->>'owner' IS DISTINCT FROM 'S5'\n  OR p_body->'ref'->>'version' IS DISTINCT FROM 'application-operation-v1'\n  OR coalesce(p_body->'ref'->>'contentDigest','') !~ '^[a-f0-9]{64}$'\n  OR p_body->'ref'->>'id' IS DISTINCT FROM 'application-consumption:'||(p_body->'ref'->>'contentDigest')\n  OR length(coalesce(p_body->>'idempotencyKey','')) NOT BETWEEN 1 AND 256\n  OR length(coalesce(p_body->>'nodeId','')) NOT BETWEEN 1 AND 512\n  OR coalesce(p_body->>'requestDigest','') !~ '^[a-f0-9]{64}$'\n  THEN RAISE EXCEPTION 'Z0 original application consumption invalid'; END IF;\n IF p_body->>'nodeId'='original-computation' THEN\n  IF p_body->'operationRef' IS DISTINCT FROM cert->'preparationRef'\n   OR p_body->'preparationRef' IS DISTINCT FROM cert->'preparationRef'\n   OR p_body->'predecessorObservationRef' IS DISTINCT FROM cert->'preparationRef'\n   OR p_body->>'requestDigest' IS DISTINCT FROM cert->>'requestDigest'\n   THEN RAISE EXCEPTION 'Z0 original computation binding changed'; END IF;\n ELSE\n  IF NOT EXISTS(SELECT 1 FROM finnor_os.application_semantics_sessions s\n    WHERE s.tenant_id=t AND s.principal_id=u AND s.id=s.parent_id\n      AND s.allocation_ref=p_body->'certificateRef' AND s.reservation_ref=parent->'ref'\n      AND s.original_parent_ref=cert->'originalParentRef'\n      AND p_body->>'nodeId' LIKE s.id::text||':%'\n      AND s.cancel_requested_at IS NULL AND s.deadline_at>clock_timestamp()\n      AND s.status NOT IN('COMPLETED','MODEL_READY','CANCELLED','FAILED','STALE','BLOCKED'))\n    THEN RAISE EXCEPTION 'Z0 actual original application session required'; END IF;\n END IF;\n SELECT body INTO prior FROM finnor_os.s5_consumptions\n  WHERE tenant_id=t AND principal_id=u AND idempotency_key=p_body->>'idempotencyKey';\n IF FOUND THEN\n  IF prior IS DISTINCT FROM p_body THEN RAISE EXCEPTION 'Z0 consumption replay conflict'; END IF;\n  RETURN prior;\n END IF;\n IF (SELECT count(*) FROM finnor_os.s5_consumptions WHERE tenant_id=t\n    AND reservation_id=parent->'ref'->>'id')>=1420 THEN RAISE EXCEPTION 'Z0 original consumption bound exhausted'; END IF;\n INSERT INTO finnor_os.s5_consumptions(tenant_id,principal_id,consumption_id,reservation_id,\n  policy_id,node_id,idempotency_key,request_digest,body)\n VALUES(t,u,p_body->'ref'->>'id',parent->'ref'->>'id',p_body->'preparationRef'->>'id',\n  p_body->>'nodeId',p_body->>'idempotencyKey',p_body->>'requestDigest',p_body);\n INSERT INTO finnor_os.s5_consumption_states(tenant_id,consumption_id,status,revision)\n VALUES(t,p_body->'ref'->>'id','INTENDED_PENDING_S6',1);\n UPDATE finnor_os.s5_reservations SET status='CONSUMPTION_PENDING',revision=revision+1\n  WHERE tenant_id=t AND reservation_id=parent->'ref'->>'id' AND status='RESERVED';\n RETURN p_body;\nEND $$;\nREVOKE ALL ON FUNCTION finnor_os.z0_s5_application_consumption(jsonb,uuid) FROM PUBLIC;\n\nCREATE FUNCTION finnor_os.z0_s5_application_charge(p_body jsonb,p_decision uuid)\nRETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\nDECLARE t uuid:=finnor_os.request_tenant_id(); u uuid:=nullif(current_setting('app.user_id',true),'')::uuid;\n frame jsonb; cert jsonb; parent jsonb; prior jsonb; co jsonb; original_limit numeric; child_limit numeric;\n original_used numeric; child_used numeric; recovery boolean;\nBEGIN\n recovery:=coalesce((p_body->>'recovery')::boolean,false);\n frame:=finnor_os.z0_s5_application_frame(p_body->'allocationRef',p_decision,recovery);\n cert:=frame->'certificate'; parent:=frame->'parent';\n SELECT body INTO co FROM finnor_os.s5_consumptions WHERE tenant_id=t AND principal_id=u\n  AND consumption_id=p_body->'consumptionRef'->>'id' AND reservation_id=parent->'ref'->>'id';\n IF co IS NULL OR co->'ref' IS DISTINCT FROM p_body->'consumptionRef'\n  OR co->'certificateRef' IS DISTINCT FROM p_body->'allocationRef'\n  OR p_body->'reservationRef' IS DISTINCT FROM parent->'ref'\n  OR p_body->'originalParentRef' IS DISTINCT FROM cert->'originalParentRef'\n  OR p_body->>'tenantId' IS DISTINCT FROM t::text OR p_body->>'principalId' IS DISTINCT FROM u::text\n  OR p_body->>'schema' IS DISTINCT FROM 'finnor.s5.application-resource-charge.v1'\n  OR p_body->'executionAuthorityGranted' IS DISTINCT FROM 'false'::jsonb\n  OR coalesce(p_body->>'phase','') NOT IN('ACQUISITION','CHECKING','COMPOSITION','EXECUTION','RECOVERY','OBSERVATION','MAINTENANCE','HUMAN')\n  OR p_body->>'unit' IS DISTINCT FROM CASE WHEN p_body->>'phase'='HUMAN' THEN 'seconds' ELSE 'request' END\n  OR (recovery AND p_body->>'phase'<>'RECOVERY')\n  OR coalesce(p_body->>'units','') !~ '^[1-9][0-9]{0,3}$' OR (p_body->>'units')::integer>2048\n  OR coalesce(p_body->'ref'->>'contentDigest','') !~ '^[a-f0-9]{64}$'\n  OR coalesce(p_body->>'requestDigest','') !~ '^[a-f0-9]{64}$'\n  OR length(coalesce(p_body->>'chargeKey','')) NOT BETWEEN 1 AND 512\n  OR p_body->'ref'->>'id' IS DISTINCT FROM 'application-resource-charge:'||(p_body->'ref'->>'contentDigest')\n  OR p_body->'ref'->>'owner' IS DISTINCT FROM 'S5'\n  OR p_body->'ref'->>'version' IS DISTINCT FROM 'application-operation-v1'\n  THEN RAISE EXCEPTION 'Z0 exact original application charge invalid'; END IF;\n IF recovery AND NOT EXISTS(SELECT 1 FROM finnor_os.application_semantics_requests r\n   JOIN finnor_os.application_semantics_sessions s ON s.tenant_id=r.tenant_id AND s.id=r.session_id\n   WHERE r.tenant_id=t AND r.principal_id=u AND s.allocation_ref=p_body->'allocationRef'\n    AND r.possible_egress AND r.status NOT IN('VERIFIED','DENIED'))\n   THEN RAISE EXCEPTION 'Z0 recovery cannot renew forward spending'; END IF;\n SELECT body INTO prior FROM finnor_os.s5_governed_resource_charges WHERE tenant_id=t\n  AND reservation_id=parent->'ref'->>'id' AND charge_key=p_body->>'chargeKey';\n IF FOUND THEN\n  IF prior IS DISTINCT FROM p_body THEN RAISE EXCEPTION 'Z0 original charge replay conflict'; END IF;\n  RETURN prior;\n END IF;\n SELECT sum(q.value::numeric) INTO original_limit FROM jsonb_array_elements(parent->'envelopes') e\n  CROSS JOIN LATERAL jsonb_array_elements_text(e->'quantities') q(value)\n  WHERE e->>'resourceId'=p_body->>'resourceId' AND e->>'unit'=p_body->>'unit';\n SELECT sum(q.value::numeric) INTO child_limit FROM jsonb_array_elements(cert->'check'->'envelopes') e\n  CROSS JOIN LATERAL jsonb_array_elements_text(e->'quantities') q(value)\n  WHERE e->>'resourceId'=p_body->>'resourceId' AND e->>'unit'=p_body->>'unit';\n SELECT coalesce(sum(units),0),coalesce(sum(units) FILTER(WHERE body->'allocationRef'=p_body->'allocationRef'),0)\n  INTO original_used,child_used FROM finnor_os.s5_governed_resource_charges\n  WHERE tenant_id=t AND reservation_id=parent->'ref'->>'id' AND resource_id=p_body->>'resourceId';\n IF original_limit IS NULL OR child_limit IS NULL OR original_used+(p_body->>'units')::integer>original_limit\n  OR child_used+(p_body->>'units')::integer>child_limit\n  OR p_body->>'limit' IS DISTINCT FROM original_limit::text\n  OR p_body->>'childLimit' IS DISTINCT FROM child_limit::text\n  OR p_body->>'usedAfter' IS DISTINCT FROM (original_used+(p_body->>'units')::integer)::text\n  OR p_body->>'childUsedAfter' IS DISTINCT FROM (child_used+(p_body->>'units')::integer)::text\n  OR (SELECT count(*) FROM finnor_os.s5_governed_resource_charges\n    WHERE tenant_id=t AND reservation_id=parent->'ref'->>'id')>=1420\n  THEN RAISE EXCEPTION 'Z0 original resource envelope exhausted'; END IF;\n INSERT INTO finnor_os.s5_governed_resource_charges(tenant_id,principal_id,reservation_id,consumption_id,\n  charge_key,phase,resource_id,unit,units,request_digest,body)\n VALUES(t,u,parent->'ref'->>'id',co->'ref'->>'id',p_body->>'chargeKey',p_body->>'phase',\n  p_body->>'resourceId',p_body->>'unit',(p_body->>'units')::integer,p_body->>'requestDigest',p_body);\n RETURN p_body;\nEND $$;\nREVOKE ALL ON FUNCTION finnor_os.z0_s5_application_charge(jsonb,uuid) FROM PUBLIC;\n\nCREATE FUNCTION finnor_os.z0_s5_application_effect_state(p_obligation text,p_stage text)\nRETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,finnor_os AS $$\nDECLARE t uuid:=finnor_os.request_tenant_id(); u uuid:=nullif(current_setting('app.user_id',true),'')::uuid;\n obligation jsonb; co jsonb; frame jsonb; effect_id uuid; effect_hash text; effect_status text;\n request_status text; possible boolean; revision integer;\nBEGIN\n SELECT o.body,o.effect_id,e.semantic_hash,e.status,c.body INTO obligation,effect_id,effect_hash,effect_status,co\n  FROM finnor_os.s6_obligation_origins o JOIN finnor_os.business_effects e ON e.tenant_id=o.tenant_id AND e.id=o.effect_id\n  JOIN finnor_os.s5_consumptions c ON c.tenant_id=o.tenant_id AND c.consumption_id=o.consumption_id\n  WHERE o.tenant_id=t AND o.principal_id=u AND o.obligation_id=p_obligation;\n IF co IS NULL OR obligation->>'schema' IS DISTINCT FROM 'finnor.s6.application-obligation.v1'\n  OR co->'ref' IS DISTINCT FROM obligation->'consumptionRef'\n  OR co->'certificateRef' IS DISTINCT FROM obligation->'allocationRef'\n  THEN RAISE EXCEPTION 'Z0 canonical application obligation unavailable'; END IF;\n frame:=finnor_os.z0_s5_application_frame(co->'certificateRef',NULL,true);\n IF coalesce(p_stage,'') NOT IN('BOUND','POSSIBLE','OBSERVED') THEN RAISE EXCEPTION 'Z0 S6 observation stage invalid'; END IF;\n SELECT r.status,r.possible_egress INTO request_status,possible FROM finnor_os.application_semantics_requests r\n  WHERE r.tenant_id=t AND r.principal_id=u AND r.obligation_id=p_obligation;\n IF p_stage='POSSIBLE' AND (possible IS DISTINCT FROM true OR effect_status<>'executing')\n  OR p_stage='OBSERVED' AND (request_status IS NULL\n    OR request_status='VERIFIED' AND effect_status<>'verified'\n    OR request_status='DENIED' AND effect_status<>'cancelled')\n  THEN RAISE EXCEPTION 'Z0 actual S6 state observation required'; END IF;\n UPDATE finnor_os.s5_consumption_states SET\n  effect_ref=jsonb_build_object('owner','S6','id',effect_id,'version','business-effect-v1','contentDigest',effect_hash),\n  status=CASE WHEN p_stage='BOUND' THEN status\n    WHEN p_stage='OBSERVED' AND request_status IN('VERIFIED','DENIED') THEN 'RECONCILED' ELSE 'UNKNOWN_OUTCOME' END,\n  revision=s5_consumption_states.revision+1,updated_at=clock_timestamp()\n  WHERE tenant_id=t AND consumption_id=co->'ref'->>'id' RETURNING s5_consumption_states.revision INTO revision;\n IF p_stage='POSSIBLE' OR p_stage='OBSERVED' AND request_status NOT IN('VERIFIED','DENIED') THEN\n  UPDATE finnor_os.s5_reservations SET status='UNKNOWN_OUTCOME',revision=s5_reservations.revision+1\n   WHERE tenant_id=t AND reservation_id=frame->'parent'->'ref'->>'id' AND status<>'UNKNOWN_OUTCOME';\n END IF;\n -- Never downgrade or release the parent: other X1/S6 consumption may still be unknown.\n RETURN jsonb_build_object('revision',revision,'originalReservationRef',frame->'parent'->'ref','releaseGranted',false);\nEND $$;\nREVOKE ALL ON FUNCTION finnor_os.z0_s5_application_effect_state(text,text) FROM PUBLIC;\n\n-- An application-shaped child of a private institution is still private.\nCREATE POLICY z0_inherited_application_consumption_privacy ON finnor_os.s5_consumptions AS RESTRICTIVE\n FOR SELECT USING(body->>'schema'<>'finnor.s5.application-consumption.v1'\n   OR reservation_id NOT LIKE 'institution-reservation:%' OR finnor_os.s5_institution_visible(reservation_id));\nCREATE POLICY z0_inherited_application_charge_privacy ON finnor_os.s5_governed_resource_charges AS RESTRICTIVE\n FOR SELECT USING(body->>'schema'<>'finnor.s5.application-resource-charge.v1'\n   OR reservation_id NOT LIKE 'institution-reservation:%' OR finnor_os.s5_institution_visible(reservation_id));\nCREATE POLICY z0_inherited_application_history_privacy ON finnor_os.s5_history AS RESTRICTIVE\n FOR SELECT USING(operation<>'APPLICATION_S6_OBSERVATION' OR finnor_os.s5_institution_consumption_visible(subject_id));\n\n-- Execution of this integration input is not authorized by its presence.\n-- The coordinator's normal migration process owns these narrowly scoped grants.\nGRANT EXECUTE ON FUNCTION finnor_os.z0_s5_application_consumption(jsonb,uuid),\n finnor_os.z0_s5_application_charge(jsonb,uuid),finnor_os.z0_s5_application_effect_state(text,text)\n TO finnor_app,finnor_worker;\n" },
 ];
