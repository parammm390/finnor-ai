+const cases: Array<{ id: string; expected: string; run: (api: any) => void }> = [];
+const add = (id: string, expected: string, run: (api: any) => void) => cases.push({ id, expected, run });
+const workId = "11111111-1111-4111-8111-111111111111";
+const inputId = "22222222-2222-4222-8222-222222222222";
+const programmeId = "33333333-3333-4333-8333-333333333333";
+const foreign = "44444444-4444-4444-8444-444444444444";
+const queries = [
+  { intent: "harness_program_v1", workId, programId: programmeId },
+  { intent: "economic_programme_v1", workId, programmeId },
+  { intent: "confidential_economic_computation_v1", workId },
+];
+for (const request of queries) add(`original-input:${request.intent}`, "same original input",
+  api => assert.deepEqual(api.nativeObservationRequest(request, { workId, workInputId: inputId }),
+    { request, workId, workInputId: inputId }));
+add("missing-semantic-work", "refused", api => assert.throws(() =>
+  api.nativeObservationRequest({ intent: "confidential_economic_computation_v1" }, { workId })));
+add("missing-envelope-work", "refused", api => assert.throws(() =>
+  api.nativeObservationRequest(queries[0], {})));
+add("conflicting-envelope-work", "refused", api => assert.throws(() =>
+  api.nativeObservationRequest(queries[0], { workId: foreign })));
+add("malformed-work", "refused", api => assert.throws(() =>
+  api.nativeObservationRequest({ ...queries[0], workId: "not-a-uuid" }, { workId: "not-a-uuid" })));
+add("extra-tenant-selector", "refused", api => assert.throws(() =>
+  api.nativeObservationRequest({ ...queries[0], tenantId: foreign }, { workId })));
+add("extra-steering-envelope", "refused", api => assert.throws(() =>
+  api.nativeObservationRequest(queries[0], { workId, instruction: "complete Work" })));
+add("non-native-query", "refused", api => assert.throws(() =>
+  api.nativeObservationRequest({ intent: "work_list" }, { workId })));
+const envelope = [
+  { resourceId: "compute", unit: "request", quantities: ["520", "0"] },
+  { resourceId: "human", unit: "seconds", quantities: ["900", "0"] },
+];
+const charges = [
+  { resourceId: "compute", unit: "request", units: "27" },
+  { resourceId: "compute", unit: "request", units: "6" },
+  { resourceId: "human", unit: "seconds", units: "4" },
