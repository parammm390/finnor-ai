+add("sum-original-and-child-charges", "520 - 27 - 6 = 487, child ceiling 200", api =>
+  assert.deepEqual(api.remainingInstitutionBudget(envelope, charges,
+    [{ resourceId: "compute", unit: "request", amount: "200" }]),
+  [{ resourceId: "compute", unit: "request", limit: "520", used: "33", remaining: "487", ceiling: "200" }]));
+add("no-new-parent-budget", "488 > 487 refused", api => assert.throws(() =>
+  api.remainingInstitutionBudget(envelope, charges, [{ resourceId: "compute", unit: "request", amount: "488" }])));
+add("duplicate-demand", "refused", api => assert.throws(() => api.remainingInstitutionBudget(envelope, charges,
+  [{ resourceId: "compute", unit: "request", amount: "1" }, { resourceId: "compute", unit: "request", amount: "1" }])));
+add("unit-reinterpretation", "refused", api => assert.throws(() => api.remainingInstitutionBudget(envelope, charges,
+  [{ resourceId: "compute", unit: "seconds", amount: "1" }])));
+add("fractional-requests", "refused", api => assert.throws(() => api.remainingInstitutionBudget(envelope, charges,
+  [{ resourceId: "compute", unit: "request", amount: "1.5" }])));
+add("unknown-charge-amount", "refused, not zero", api => assert.throws(() =>
+  api.remainingInstitutionBudget(envelope, [{ resourceId: "compute", unit: "request", units: null }],
+    [{ resourceId: "compute", unit: "request", amount: "1" }])));
+add("original-overdrawn", "refused", api => assert.throws(() =>
+  api.remainingInstitutionBudget(envelope, [{ resourceId: "compute", unit: "request", units: "521" }],
+    [{ resourceId: "compute", unit: "request", amount: "1" }])));
+const deadline = {
+  requestedDeadlineAt: "2026-10-24T15:00:20.000Z", originalDeadlineAt: "2026-10-24T15:01:00.000Z",
+  wallDeadlineAt: "2026-10-24T15:00:30.000Z", responsibilityDeadlineAt: "2026-10-24T15:00:40.000Z",
+  programmeDeadlineAt: "2026-10-24T15:00:25.000Z", nowMs: Date.parse("2026-10-24T15:00:00.000Z"),
+};
+add("remaining-original-deadline", "same requested attenuated deadline", api =>
+  assert.equal(api.assertInheritedDeadline(deadline), deadline.requestedDeadlineAt));
+for (const key of ["originalDeadlineAt", "wallDeadlineAt", "responsibilityDeadlineAt", "programmeDeadlineAt"]) {
+  add(`deadline-extension:${key}`, "refused", api => assert.throws(() =>
+    api.assertInheritedDeadline({ ...deadline, [key]: "2026-10-24T15:00:19.000Z" })));
+}
+add("expired-original-deadline", "refused", api => assert.throws(() =>
+  api.assertInheritedDeadline({ ...deadline, nowMs: Date.parse(deadline.requestedDeadlineAt) })));
+const charge = { parentLimit: "520", parentUsed: "519", childLimit: "200", childUsed: "10",
+  units: 1, recovery: false, phase: "ACQUISITION" };
+add("last-original-unit", "520 used, child 11 used", api => assert.deepEqual(api.assertInheritedCharge(charge),
+  { parentUsedAfter: "520", childUsedAfter: "11" }));
+add("original-charge-exhaustion", "refused", api => assert.throws(() =>
+  api.assertInheritedCharge({ ...charge, units: 2 })));
+add("child-charge-exhaustion", "refused", api => assert.throws(() =>
+  api.assertInheritedCharge({ ...charge, childUsed: "200" })));
+add("same-original-recovery-charge", "520 used, child 11 used", api => assert.deepEqual(
+  api.assertInheritedCharge({ ...charge, recovery: true, phase: "RECOVERY" }),
+  { parentUsedAfter: "520", childUsedAfter: "11" }));
+add("no-forward-recovery-authority", "refused", api => assert.throws(() =>
+  api.assertInheritedCharge({ ...charge, recovery: true, phase: "EXECUTION" })));
+add("unsafe-numeric-charge", "refused", api => assert.throws(() =>
+  api.assertInheritedCharge({ ...charge, parentUsed: 9007199254740992 })));
+
+const started = performance.now();
+let api: any, loadFailure: string | null = null;
+try { api = await import(pathToFileURL(source).href); }
+catch { loadFailure = "OWNED_SEMANTICS_INTERFACE_UNAVAILABLE"; }
+const observed = cases.map(test => {
+  try {
+    if (loadFailure) throw Error(loadFailure);
+    test.run(api);
+    return { id: test.id, expected: test.expected, status: "PASS" };
+  } catch (error) {
+    return { id: test.id, expected: test.expected, status: "FAIL",
+      predicate: error instanceof assert.AssertionError ? error.code : loadFailure ?? "CONTRACT_FAILURE" };
+  }
+});
+const baseline = process.argv.includes("--baseline");
+await mkdir(output, { recursive: true });
+const bytes = await readFile(import.meta.filename);
+const receipt = {
+  schema: "finnor.project-z.z0.isolated-contract-sweep.v1", baseline, observedAt: new Date().toISOString(),
