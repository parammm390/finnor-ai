              "PLpgSQL_stmt_if": {
                "lineno": 29,
                "cond": {
                  "PLpgSQL_expr": {
                    "query": "recovery AND NOT EXISTS(SELECT 1 FROM finnor_os.application_semantics_requests r\n   JOIN finnor_os.application_semantics_sessions s ON s.tenant_id=r.tenant_id AND s.id=r.session_id\n   WHERE r.tenant_id=t AND r.principal_id=u AND s.allocation_ref=p_body->'allocationRef'\n    AND r.possible_egress AND r.status NOT IN('VERIFIED','DENIED'))",
                    "parseMode": 2
