            {
              "PLpgSQL_stmt_execsql": {
                "lineno": 40,
                "sqlstmt": {
                  "PLpgSQL_expr": {
                    "query": "SELECT sum(q.value::numeric)                     FROM jsonb_array_elements(parent->'envelopes') e\n  CROSS JOIN LATERAL jsonb_array_elements_text(e->'quantities') q(value)\n  WHERE e->>'resourceId'=p_body->>'resourceId' AND e->>'unit'=p_body->>'unit'",
                    "parseMode": 0
