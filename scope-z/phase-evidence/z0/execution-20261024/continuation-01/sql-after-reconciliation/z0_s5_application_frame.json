                "sqlstmt": {
                  "PLpgSQL_expr": {
                    "query": "SELECT *                FROM finnor_os.p1_requests\n  WHERE tenant_id=t AND principal_id=u AND id=(origin->'selector'->>'programId')::uuid FOR SHARE",
                    "parseMode": 0
                  }
                },
                "into": true,
                "target": {
                  "PLpgSQL_row": {
                    "refname": "(unnamed row)",
                    "lineno": 50,
                    "fields": [
                      {
                        "name": "programme",
                        "varno": 12
                      }
                    ]
                  }
                }
              }
            },
            {
              "PLpgSQL_stmt_execsql": {
                "lineno": 52,
                "sqlstmt": {
                  "PLpgSQL_expr": {
                    "query": "SELECT *              FROM finnor_os.x1_compiler_episodes\n  WHERE tenant_id=t AND principal_id=u AND id=compiler.episode_id FOR SHARE",
                    "parseMode": 0
                  }
                },
                "into": true,
                "target": {
                  "PLpgSQL_row": {
                    "refname": "(unnamed row)",
                    "lineno": 52,
                    "fields": [
                      {
                        "name": "episode",
                        "varno": 13
                      }
                    ]
                  }
                }
              }
            },
            {
              "PLpgSQL_stmt_if": {
                "lineno": 54,
                "cond": {
                  "PLpgSQL_expr": {
                    "query": "compiler.id IS NULL OR programme.id IS NULL OR episode.id IS NULL\n  OR compiler.work_id IS DISTINCT FROM (origin->>'workId')::uuid\n  OR programme.work_id IS DISTINCT FROM compiler.work_id\n  OR compiler.work_input_id IS DISTINCT FROM (origin->>'workInputId')::uuid\n  OR programme.work_input_id IS DISTINCT FROM compiler.work_input_id\n  OR compiler.work_input_digest IS DISTINCT FROM origin->>'workInputDigest'\n  OR programme.work_input_digest IS DISTINCT FROM compiler.work_input_digest\n  OR origin->'root' IS DISTINCT FROM programme.request->'root'\n  OR compiler.program_id IS DISTINCT FROM programme.id\n  OR compiler.admission_id IS DISTINCT FROM (origin->>'admissionId')::uuid\n  OR episode.id IS DISTINCT FROM (origin->>'compilerEpisodeId')::uuid\n  OR episode.parent_reservation IS DISTINCT FROM origin->'originalReservationRef'\n  OR episode.parent_demand->>'demandDigest' IS DISTINCT FROM origin->>'originalDemandDigest'\n  OR programme.request->'institution'->'reservationRef' IS DISTINCT FROM episode.parent_reservation\n  OR programme.request->'institution'->'demand' IS DISTINCT FROM episode.parent_demand\n  OR programme.request->'institution'->>'compilerRequestId' IS DISTINCT FROM compiler.id::text\n  OR origin->'institutionalProgramRef'->>'owner' IS DISTINCT FROM 'S4_P1'\n  OR NOT EXISTS(SELECT 1 FROM finnor_os.x1_compiler_artifacts a WHERE a.tenant_id=t AND a.principal_id=u\n    AND a.request_id=compiler.id AND a.id=compiler.artifact_id\n    AND a.id::text=origin->'institutionalProgramRef'->>'id'\n    AND a.body_digest=origin->'institutionalProgramRef'->>'contentDigest'\n    AND a.body->'envelope'->>'schema_revision'=origin->'institutionalProgramRef'->>'version'\n    AND a.check_result->>'disposition'='ACCEPTED_DEVELOPMENT')",
                    "parseMode": 2
                  }
                },
                "then_body": [
                  {
                    "PLpgSQL_stmt_raise": {
                      "lineno": 77,
                      "elog_level": 21,
                      "message": "Z0 original owner/admission ancestry changed"
                    }
                  }
                ]
              }
            },
            {
              "PLpgSQL_stmt_execsql": {
                "lineno": 78,
                "sqlstmt": {
                  "PLpgSQL_expr": {
                    "query": "SELECT count(*),jsonb_agg(d.value)->0                    FROM finnor_os.x1_checked_artifacts a CROSS JOIN LATERAL jsonb_array_elements(a.responsibilities) d(value)\n  WHERE a.tenant_id=t AND a.principal_id=u AND a.work_id=compiler.work_id AND a.admission_id=compiler.admission_id\n    AND d.value->'obligation'->>'stableIdentity'=origin->'selector'->>'responsibilityIdentity'",
                    "parseMode": 0
                  }
                },
                "into": true,
                "target": {
                  "PLpgSQL_row": {
                    "refname": "(unnamed row)",
                    "lineno": 78,
                    "fields": [
                      {
                        "name": "duties",
                        "varno": 15
                      },
                      {
                        "name": "duty",
                        "varno": 14
                      }
                    ]
                  }
                }
              }
            },
            {
              "PLpgSQL_stmt_if": {
                "lineno": 82,
                "cond": {
                  "PLpgSQL_expr": {
                    "query": "duties<>1 OR duty->'obligation'->>'responsiblePrincipal' IS DISTINCT FROM u::text\n  OR NOT (programme.request->'institution'->'responsibilities' @> jsonb_build_array(duty))",
                    "parseMode": 2
                  }
                },
                "then_body": [
                  {
                    "PLpgSQL_stmt_raise": {
                      "lineno": 84,
                      "elog_level": 21,
                      "message": "Z0 checked original responsibility required"
                    }
                  }
                ]
              }
            },
            {
              "PLpgSQL_stmt_execsql": {
                "lineno": 85,
                "sqlstmt": {
                  "PLpgSQL_expr": {
                    "query": "SELECT o.body,s.status,s.envelopes                                            FROM finnor_os.s5_reservation_origins o\n  JOIN finnor_os.s5_reservations s USING(tenant_id,reservation_id)\n  WHERE o.tenant_id=t AND o.principal_id=u AND o.reservation_id=episode.parent_reservation->>'id'\n   AND o.body->>'schema'='finnor.s5.institution-reservation.v1' FOR UPDATE OF s",
                    "parseMode": 0
                  }
                },
                "into": true,
                "target": {
                  "PLpgSQL_row": {
                    "refname": "(unnamed row)",
                    "lineno": 85,
                    "fields": [
                      {
                        "name": "parent",
                        "varno": 8
                      },
                      {
                        "name": "parent_status",
                        "varno": 9
                      },
                      {
                        "name": "parent_envelopes",
                        "varno": 10
                      }
                    ]
                  }
                }
              }
            },
            {
              "PLpgSQL_stmt_if": {
                "lineno": 89,
                "cond": {
                  "PLpgSQL_expr": {
                    "query": "parent IS NULL OR parent_status='RELEASED'\n  OR parent->'ref' IS DISTINCT FROM episode.parent_reservation\n  OR parent->'envelopes' IS DISTINCT FROM parent_envelopes\n  OR parent->>'workId' IS DISTINCT FROM origin->>'workId'\n  OR parent->'demand'->>'demandDigest' IS DISTINCT FROM origin->>'originalDemandDigest'",
                    "parseMode": 2
                  }
                },
                "then_body": [
                  {
                    "PLpgSQL_stmt_raise": {
                      "lineno": 94,
                      "elog_level": 21,
                      "message": "Z0 original resource occupation unavailable"
                    }
                  }
                ]
              }
            },
            {
              "PLpgSQL_stmt_if": {
                "lineno": 95,
                "cond": {
                  "PLpgSQL_expr": {
                    "query": "NOT p_recovery",
                    "parseMode": 2
                  }
                },
                "then_body": [
                  {
                    "PLpgSQL_stmt_if": {
                      "lineno": 96,
                      "cond": {
                        "PLpgSQL_expr": {
                          "query": "p_decision IS NULL",
                          "parseMode": 2
                        }
                      },
                      "then_body": [
                        {
                          "PLpgSQL_stmt_raise": {
                            "lineno": 96,
                            "elog_level": 21,
                            "message": "Z0 fresh original authority decision required"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "PLpgSQL_stmt_perform": {
                      "lineno": 97,
                      "expr": {
                        "PLpgSQL_expr": {
                          "query": "SELECT finnor_os.s5_assert_institution_current(parent->'ref'->>'id',p_decision)",
                          "parseMode": 0
                        }
                      }
                    }
                  },
                  {
                    "PLpgSQL_stmt_if": {
                      "lineno": 98,
