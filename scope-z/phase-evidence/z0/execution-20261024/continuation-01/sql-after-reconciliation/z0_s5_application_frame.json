            {
              "PLpgSQL_stmt_perform": {
                "lineno": 14,
                "expr": {
                  "PLpgSQL_expr": {
                    "query": "SELECT pg_advisory_xact_lock(hashtextextended('s5-portfolio:'||t::text,0))",
                    "parseMode": 0
                  }
                }
              }
            },
            {
              "PLpgSQL_stmt_perform": {
                "lineno": 15,
                "expr": {
                  "PLpgSQL_expr": {
                    "query": "SELECT pg_advisory_xact_lock(hashtextextended(t::text,5510))",
                    "parseMode": 0
                  }
                }
              }
            },
            {
              "PLpgSQL_stmt_execsql": {
                "lineno": 16,
                "sqlstmt": {
                  "PLpgSQL_expr": {
                    "query": "SELECT a.body           FROM finnor_os.application_semantics_artifacts a\n  WHERE a.tenant_id=t AND a.principal_id=u AND a.artifact_id=p_ref->>'id'\n   AND a.semantic_owner='S5' AND a.version='application-operation-v1'\n   AND a.content_digest=p_ref->>'contentDigest'",
                    "parseMode": 0
                  }
                },
                "into": true,
                "target": {
                  "PLpgSQL_row": {
                    "refname": "(unnamed row)",
                    "lineno": 16,
                    "fields": [
                      {
                        "name": "cert",
                        "varno": 6
                      }
                    ]
                  }
                }
              }
            },
            {
              "PLpgSQL_stmt_if": {
                "lineno": 20,
                "cond": {
                  "PLpgSQL_expr": {
                    "query": "cert IS NULL OR p_ref->>'owner' IS DISTINCT FROM 'S5'\n  OR p_ref->>'version' IS DISTINCT FROM 'application-operation-v1'\n  OR p_ref->>'id' IS DISTINCT FROM 'institution-application-allocation:'||(p_ref->>'contentDigest')\n  OR cert->>'schema' IS DISTINCT FROM 'finnor.s5.application-allocation.v1'\n  OR cert->>'occupation' IS DISTINCT FROM 'EXISTING_ORIGINAL_X1_RESERVATION_NO_NEW_FUNDING'\n  OR cert->>'tenantId' IS DISTINCT FROM t::text OR cert->>'principalId' IS DISTINCT FROM u::text\n  OR cert->'executionAuthorityGranted' IS DISTINCT FROM 'false'::jsonb\n  OR jsonb_typeof(cert->'check'->'envelopes') IS DISTINCT FROM 'array'\n  OR jsonb_typeof(cert->'acquisitionRequest'->'resourceDemand') IS DISTINCT FROM 'array'\n  OR jsonb_typeof(cert->'resourceRefs') IS DISTINCT FROM 'array'",
                    "parseMode": 2
                  }
                },
                "then_body": [
                  {
                    "PLpgSQL_stmt_raise": {
                      "lineno": 30,
                      "elog_level": 21,
                      "message": "Z0 inherited allocation preimage unavailable"
                    }
                  }
                ]
              }
            },
            {
              "PLpgSQL_stmt_execsql": {
                "lineno": 31,
                "sqlstmt": {
                  "PLpgSQL_expr": {
                    "query": "SELECT a.body             FROM finnor_os.application_semantics_artifacts a\n  WHERE a.tenant_id=t AND a.principal_id=u AND a.artifact_id=cert->'institutionalOriginRef'->>'id'\n   AND a.semantic_owner='S4' AND a.version=cert->'institutionalOriginRef'->>'version'\n   AND a.content_digest=cert->'institutionalOriginRef'->>'contentDigest'",
                    "parseMode": 0
                  }
                },
                "into": true,
                "target": {
                  "PLpgSQL_row": {
                    "refname": "(unnamed row)",
                    "lineno": 31,
                    "fields": [
                      {
                        "name": "origin",
                        "varno": 7
                      }
                    ]
                  }
                }
              }
            },
            {
              "PLpgSQL_stmt_if": {
                "lineno": 35,
                "cond": {
                  "PLpgSQL_expr": {
                    "query": "origin IS NULL OR origin->>'schema' IS DISTINCT FROM 'finnor.z0.institution-application-origin.v1'\n  OR origin->>'tenantId' IS DISTINCT FROM t::text OR origin->>'principalId' IS DISTINCT FROM u::text\n  OR origin->>'workId' IS DISTINCT FROM cert->>'workId'\n  OR origin->>'deadlineAt' IS DISTINCT FROM cert->>'deadlineAt'\n  OR origin->'originalReservationRef' IS DISTINCT FROM cert->'originalReservationRef'\n  OR origin->>'purpose' IS DISTINCT FROM 'LEARN_APPLICATION_MODEL_THEN_RETURN_TO_ORIGINAL_P1'\n  OR origin->'executionAuthorityGranted' IS DISTINCT FROM 'false'::jsonb\n  OR origin->'protectedAdmission' IS DISTINCT FROM 'false'::jsonb\n  OR cert->'acquisitionRequest'->'institutionalOrigin' IS DISTINCT FROM origin->'selector'\n  OR cert->'acquisitionRequest'->>'workId' IS DISTINCT FROM origin->>'workId'\n  OR cert->'acquisitionRequest'->'root' IS DISTINCT FROM origin->'root'\n  OR cert->'acquisitionRequest'->>'deadlineAt' IS DISTINCT FROM origin->>'deadlineAt'",
                    "parseMode": 2
                  }
                },
                "then_body": [
                  {
                    "PLpgSQL_stmt_raise": {
                      "lineno": 47,
                      "elog_level": 21,
                      "message": "Z0 original institution binding unavailable"
                    }
                  }
                ]
              }
            },
            {
              "PLpgSQL_stmt_execsql": {
                "lineno": 48,
                "sqlstmt": {
                  "PLpgSQL_expr": {
                    "query": "SELECT *               FROM finnor_os.x1_compiler_requests\n  WHERE tenant_id=t AND principal_id=u AND id=(origin->'selector'->>'compilerRequestId')::uuid FOR SHARE",
                    "parseMode": 0
                  }
                },
                "into": true,
                "target": {
                  "PLpgSQL_row": {
                    "refname": "(unnamed row)",
                    "lineno": 48,
                    "fields": [
