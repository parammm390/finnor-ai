FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS dependencies

WORKDIR /app/finnor-os

# Native flock must be built for the Linux image, not borrowed from a host.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# The worker is an npm workspace entrypoint. Keep the lockfile and every workspace
# available so the existing embedded orchestrator, handlers, projections, and SSE
# gateway run from the same process without a source rewrite.
COPY finnor-os/package.json finnor-os/package-lock.json finnor-os/tsconfig.json finnor-os/tsconfig.base.json ./
COPY finnor-os/apps ./apps
COPY finnor-os/packages ./packages
COPY finnor-os/scripts ./scripts
# Source-custody readers intentionally attest canonical repository-relative
# paths. Retain that layout and the root inputs instead of weakening identity.
COPY package-lock.json /app/package-lock.json
COPY infra/deployment/production.contract.json /app/infra/deployment/production.contract.json
COPY scripts/release/production-mutation-guard.mjs scripts/release/release-policy.mjs scripts/release/worktree-state.mjs /app/scripts/release/

RUN npm ci --no-audit --no-fund

FROM ghcr.io/astral-sh/uv:0.10.9@sha256:10902f58a1606787602f303954cea099626a4adb02acbac4c69920fe9d278f82 AS r3-installer

# A translated x64 supervisor may run on an arm64 kernel. Its ordinary M3
# callee must use the native syscall ABI. Scientific suppliers stay x64.
FROM --platform=linux/arm64 node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS s6-native-callee
RUN apt-get update \
    && apt-get install --yes --no-install-recommends bubblewrap=0.8.0-2+deb12u1 \
    && rm -rf /var/lib/apt/lists/*

FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS r3-scientific

COPY --from=r3-installer /uv /usr/local/bin/uv
COPY finnor-os/scripts/r3/requirements.lock finnor-os/scripts/r3/upstream-requirements.lock /locks/
ENV UV_PYTHON_INSTALL_DIR=/opt/r3-python UV_NO_CACHE=1
RUN uv python install 3.11.15 3.12.13 \
    && uv venv --python 3.11.15 /opt/r3-runtime \
    && uv pip sync --require-hashes --only-binary :all: --python /opt/r3-runtime/bin/python /locks/requirements.lock \
    && uv venv --python 3.12.13 /opt/r3-upstream-runtime \
    && uv pip sync --require-hashes --only-binary :all: --python /opt/r3-upstream-runtime/bin/python /locks/upstream-requirements.lock \
    && /opt/r3-upstream-runtime/bin/python -I -m compileall -q -j 3 /opt/r3-upstream-runtime

FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS runtime

WORKDIR /app/finnor-os
# Scientific libraries must exist in the final stage, not only npm's builder.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libstdc++6 libgomp1 libgcc-s1 libgfortran5 bubblewrap=0.8.0-2+deb12u1 openssl=3.0.22-1~deb12u1 libssl3=3.0.22-1~deb12u1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dependencies /app /app
COPY --from=r3-scientific /opt/r3-python /opt/r3-python
COPY --from=r3-scientific /opt/r3-runtime /opt/r3-runtime
COPY --from=r3-scientific /opt/r3-upstream-runtime /opt/r3-upstream-runtime
COPY --from=s6-native-callee /usr/local/bin/node /opt/finnor-s6-linux-native/node
COPY --from=s6-native-callee /usr/bin/bwrap /opt/finnor-s6-linux-native/bwrap
COPY --from=s6-native-callee /usr/bin/uname /opt/finnor-s6-linux-native/uname
COPY --from=s6-native-callee /usr/lib/aarch64-linux-gnu /usr/lib/aarch64-linux-gnu
COPY --from=s6-native-callee /usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1 /usr/lib/ld-linux-aarch64.so.1
RUN node scripts/r3/seal-linux-callee.mjs

ENV NODE_ENV=production \
    PORT=8090 \
    SSE_PORT=8090 \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    FINNOR_R3_RUNTIME_MANIFEST=/opt/r3-runtime/manifest.json \
    FINNOR_S3_PYTHON=/opt/r3-upstream-runtime/bin/python \
    FINNOR_S5_PYTHON=/opt/r3-upstream-runtime/bin/python \
    FINNOR_S3_MODEL_STORE=/tmp/finnor-models \
    FINNOR_S4_POLICY_STORE=/tmp/finnor-policies

# Runtime code/dependencies remain root-owned and non-writable by the worker.
# Only its explicitly bounded temporary output directories are writable.
RUN mkdir -p /tmp/finnor-models /tmp/finnor-policies \
    && chown node:node /tmp/finnor-models /tmp/finnor-policies \
    && chmod 700 /tmp/finnor-models /tmp/finnor-policies \
    && mkdir /tmp/r3-runtime-seal \
    && chown node:node /tmp/r3-runtime-seal \
    && chmod 700 /tmp/r3-runtime-seal
USER node
RUN /opt/r3-runtime/bin/python -I scripts/r3/seal-runtime.py \
      --output /tmp/r3-runtime-seal/manifest.json --scip-license scripts/r3/licenses/scip-Apache-2.0.txt
USER root
RUN mv /tmp/r3-runtime-seal/manifest.json /opt/r3-runtime/manifest.json \
    && chown root:root /opt/r3-runtime/manifest.json \
    && chmod 444 /opt/r3-runtime/manifest.json \
    && rmdir /tmp/r3-runtime-seal
USER node

# The ordinary API uses the same scientific/runtime/source tree. This target is
# built explicitly; the default target below retains the existing worker role.
FROM runtime AS api
USER root
RUN NODE_OPTIONS=--import=tsx npm run build --workspace apps/api
USER node
ENV PORT=3100
EXPOSE 3100
CMD ["node", "--import=tsx", "node_modules/next/dist/bin/next", "start", "apps/api", "--hostname", "0.0.0.0", "--port", "3100"]

FROM runtime AS worker

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8090/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# tsx is intentionally available from the locked workspace install: the audited
# production worker entrypoint is TypeScript and retains its current signal handling.
# Invoke the binary directly so the worker receives ECS SIGTERM as PID 1 instead
# of placing npm/npx between the runtime and the container signal.
CMD ["node_modules/.bin/tsx", "apps/worker/src/index.ts"]
