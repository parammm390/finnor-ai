FROM node:22-bookworm-slim AS dependencies

WORKDIR /app/finnor-os

# Native flock must be built for the Linux image, not borrowed from a host.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# The worker is an npm workspace entrypoint. Keep the lockfile and every workspace
# available so the existing embedded orchestrator, handlers, projections, and SSE
# gateway run from the same process without a source rewrite.
COPY finnor-os/package.json finnor-os/package-lock.json finnor-os/tsconfig.json finnor-os/tsconfig.base.json ./
COPY finnor-os/apps ./apps
COPY finnor-os/packages ./packages
COPY finnor-os/scripts ./scripts
# Source-custody readers intentionally attest canonical repository-relative
# paths. Retain that layout and the root inputs instead of weakening identity.
COPY package-lock.json /app/package-lock.json
COPY infra/deployment/production.contract.json /app/infra/deployment/production.contract.json

RUN npm ci --no-audit --no-fund

# Build the same pinned exact runtime for the image architecture. Mac binaries
# are never copied into Linux. Protected R2 activation remains separately guarded.
FROM dependencies AS r2-scientific-build
RUN apt-get update \
    && apt-get install --yes --no-install-recommends cmake curl xz-utils bzip2 zlib1g-dev patchelf \
    && rm -rf /var/lib/apt/lists/*
RUN python3 scripts/r2/build-native.py --build-root /opt/r2-build

FROM node:22-bookworm-slim
RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 python3-venv libstdc++6 zlib1g \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/finnor-os
COPY --from=dependencies /app /app
# Existing S3/S5/S2 numerical callees use their ordinary configured interpreter.
RUN python3 -m venv /opt/finnor-python \
    && /opt/finnor-python/bin/python -m pip install --no-cache-dir -r packages/epistemic-runtime/src/intervention-requirements.txt \
    && /opt/finnor-python/bin/python -m pip freeze --all > /opt/finnor-python/installed-versions.txt
COPY --from=r2-scientific-build /opt/r2-build/runtime /opt/finnor-r2/runtime
# Preserve pinned GNU source archives for notices and relinking obligations.
COPY --from=r2-scientific-build /opt/r2-build/gmp.tar.xz /opt/finnor-r2/sources/gmp.tar.xz
COPY --from=r2-scientific-build /opt/r2-build/mpfr.tar.xz /opt/finnor-r2/sources/mpfr.tar.xz

ENV FINNOR_R2_RUNTIME=/opt/finnor-r2/runtime \
    FINNOR_R2_PYTHON=/opt/finnor-python/bin/python \
    FINNOR_S3_PYTHON=/opt/finnor-python/bin/python \
    FINNOR_S5_PYTHON=/opt/finnor-python/bin/python \
    NODE_ENV=production \
    PORT=8090 \
    SSE_PORT=8090

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8090/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# tsx is intentionally available from the locked workspace install: the audited
# production worker entrypoint is TypeScript and retains its current signal handling.
# Invoke the binary directly so the worker receives ECS SIGTERM as PID 1 instead
# of placing npm/npx between the runtime and the container signal.
CMD ["node_modules/.bin/tsx", "apps/worker/src/index.ts"]
