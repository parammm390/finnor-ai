  const faults=(await admin.query("SELECT id,type,status,attempts,claim_fence,last_error FROM finnor_os.jobs WHERE status IN('quarantined','dead_letter') ORDER BY id LIMIT 257")).rows;
  if(faults.length){const record=JSON.stringify({observedAt:new Date().toISOString(),readOnlyObserver:true,faults})+'\n';queueDiagnosticBytes+=Buffer.byteLength(record);if(queueDiagnosticBytes<=1048576)await appendFile(join(evidence,'actual-queue-failures.jsonl'),record);}
