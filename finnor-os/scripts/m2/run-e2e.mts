async function test(id:string,input:unknown,predicate:string,fn:()=>Promise<unknown>){if(process.env.FINNOR_M2_CASE_FILTER&&!process.env.FINNOR_M2_CASE_FILTER.split(',').some(filter=>id.includes(filter))){results.push({id,status:'NOT_RUN',predicate,input});await save();return;}const t=performance.now();try{results.push({id,input,predicate,status:'PASS',observed:await fn(),durationMs:performance.now()-t});}catch(e){results.push({id,input,predicate,status:'FAIL',observed:{message:String((e as Error).message),cause:(e as any).cause?{message:(e as any).cause.message,code:(e as any).cause.code,constraint:(e as any).cause.constraint}:null,stack:(e as Error).stack},durationMs:performance.now()-t});}await save();}
