/** Pre-build source identity, embedded by both the API and worker compilers. */
import {readFile,writeFile} from 'node:fs/promises';
import {resolve,join} from 'node:path';
import {createHash} from 'node:crypto';
import {STRATEGIC_SEMANTIC_FILES} from '../../packages/epistemic-runtime/src/strategic-response/source-paths';
const source=resolve(import.meta.dirname,'../../packages/epistemic-runtime/src/strategic-response');
const files=await Promise.all(STRATEGIC_SEMANTIC_FILES.map(async path=>({path,
 sha256:createHash('sha256').update(await readFile(resolve(source,path))).digest('hex')})));
const path=join(source,'source-manifest.generated.ts'),
 body='// Generated by scripts/y2/stamp-source.mts. Do not edit.\nexport default '+JSON.stringify({
  schema:'finnor.y2.emitted-semantic-source.v1',files},null,2)+' as const;\n';
const previous=await readFile(path,'utf8').catch(error=>{if(error.code==='ENOENT')return '';throw error;});
if(process.argv.includes('--check')){if(previous!==body)throw Error('Y2_EMITTED_SOURCE_STAMP_STALE');}
else if(previous!==body)await writeFile(path,body);
console.log('Y2_EMITTED_SEMANTIC_SOURCE_STAMP',files.length);
