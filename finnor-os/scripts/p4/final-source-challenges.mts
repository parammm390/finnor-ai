import {strict as assert} from 'node:assert';
import {randomUUID} from 'node:crypto';
import {createEvidenceSource,appendEvidenceVersion} from '@finnor/memory';
import {createMetricSeries,recordMetricObservation} from '@finnor/private-equity';
/** Owner/API challenges with fixed independent inputs, preregistered separately. */
export async function finalSourceChallenges(e:any){
 const {test,api,handles,submit,finish,descriptor,root,ctx,admin,tenant,actor,companies,foreignTenant,foreignActor,sourceRef,periodStart,periodEnd,validAt}=e;
 const program={schema:'finnor.derivation-ir.v1',nodes:[{id:'rows',op:'source',inputId:'value'},{id:'value',op:'unique',input:'rows'}],outputs:['value']},acceptance={selectedUniverse:'COMPLETE',absoluteTolerance:'0',materialOutputs:['value']};
 async function selected(key:string){const hs=await handles('C',[{inputId:'value',source:descriptor('C',key)}]);return {hs,done:await finish(await submit('C',{handles:hs,program,acceptance}))};}
 await test('exact-prefix-and-amount-selection',{C_01:'20',C_010:'200',currency:'USD'},'exact canonical key and decimal fields cannot pass via prefix or quoted-value substring',async()=>{for(const [metricKey,value] of Object.entries({C_01:'20',C_010:'200'})){const series=await createMetricSeries(ctx,{subjectType:'external_organization',subjectId:companies.C,metricKey,name:'Same printed diligence label',unit:'currency',currencyCode:'USD',frequency:'annual'});await recordMetricObservation(ctx,{metricSeriesId:String(series.row.id),periodStart:new Date(periodStart),periodEnd:new Date(periodEnd),value:{type:'number',value},evidence:sourceRef});}const short=await selected('C_01'),long=await selected('C_010');assert.equal(short.done.status,'TESTED');assert.equal(long.done.status,'TESTED');assert.equal(short.done.derivation.result.outputs.value.value,'20');assert.equal(long.done.derivation.result.outputs.value.value,'200');assert.notEqual(short.done.derivation.witnesses[0].recordId,long.done.derivation.witnesses[0].recordId);return {short,long};});
 await test('equal-answer-foreign-handle',{local:'20',foreign:'20'},'two genuinely authorized equal outputs do not permit foreign handle or cache transfer',async()=>{const foreignCtx={auth:{tenantId:foreignTenant,userId:foreignActor,employeeId:foreignActor,role:'owner' as const},provenance:{sourceSystem:'p4:e2e',createdBy:foreignActor}};const source=await createEvidenceSource(foreignTenant,{sourceKey:'equal-answer',sourceType:'manual',title:'Foreign same numerical source'});const version=await appendEvidenceVersion(foreignTenant,source.id,{content:'Original independent foreign value20',snapshot:{value:'20'},asOf:new Date(periodStart)});const series=await createMetricSeries(foreignCtx,{subjectType:'external_organization',subjectId:companies.foreign,metricKey:'C_01',name:'Same printed diligence label',unit:'currency',currencyCode:'USD',frequency:'annual'});await recordMetricObservation(foreignCtx,{metricSeriesId:String(series.row.id),periodStart:new Date(periodStart),periodEnd:new Date(periodEnd),value:{type:'number',value:'20'},evidence:{evidenceSourceId:source.id,evidenceVersionId:version.versionId}});const own=await selected('C_01'),foreignIdentity={tenant:foreignTenant,actor:foreignActor},foreignRoot=root('foreign');const foreignHandles=await api('evidence-handles',{root:foreignRoot,validAt,inputs:[{inputId:'value',source:descriptor('foreign','C_01')}]},foreignIdentity);assert.equal(foreignHandles.status,200,JSON.stringify(foreignHandles));const foreign=await api('evidence-submit',{schema:'finnor.evidence-request.v1',question:'Return exact foreign C_01 original value',root:foreignRoot,validAt,idempotencyKey:randomUUID(),mode:'ordinary_disposable',inputs:foreignHandles.body.handles.map((h:any)=>({inputId:h.inputId,handleId:h.id})),program,acceptance},foreignIdentity);assert.equal(foreign.status,202);await e.queue.tick();const foreignRead=await api('evidence-read',{queryId:foreign.body.queryId},foreignIdentity);assert.equal(foreignRead.body.status,'TESTED',JSON.stringify(foreignRead));assert.equal(foreignRead.body.derivation.result.outputs.value.value,'20');assert.equal(own.done.derivation.result.outputs.value.value,'20');const request={schema:'finnor.evidence-request.v1',question:'Attempt equal-answer transfer',validAt,mode:'ordinary_disposable',program,acceptance};const stolen=await api('evidence-submit',{...request,root:foreignRoot,idempotencyKey:randomUUID(),inputs:own.hs.map((h:any)=>({inputId:h.inputId,handleId:h.id}))},foreignIdentity);const reverse=await api('evidence-submit',{...request,root:root('C'),idempotencyKey:randomUUID(),inputs:foreignHandles.body.handles.map((h:any)=>({inputId:h.inputId,handleId:h.id}))});assert.equal(stolen.status,404);assert.equal(reverse.status,404);assert.equal(JSON.stringify(stolen.body),JSON.stringify(reverse.body));return {own,foreignRead,stolen,reverse};});
 await test('source-privilege-outage',{},'real source privilege loss invalidates cached result and denies fresh source access; restore cannot resurrect it',async()=>{const before=await finish(await submit('C'));assert.equal(before.status,'TESTED');const failed=await finish(await submit('C',{limits:{maxRows:1000,maxBytes:8388608,deadlineMs:25}}));assert.equal(failed.status,'FAILED');assert(failed.derivation.beliefView.claims.length>0);let invalid:any,invalidFailed:any,unavailable:any;try{await admin.query('REVOKE SELECT ON finnor_os.canonical_entity_versions FROM finnor_app');invalid=await api('evidence-read',{queryId:before.queryId});assert.equal(invalid.body.status,'INVALIDATED',JSON.stringify(invalid));assert(!invalid.body.derivation?.result);invalidFailed=await api('evidence-read',{queryId:failed.queryId});assert.equal(invalidFailed.body.status,'INVALIDATED');assert.equal(invalidFailed.body.derivation,null);unavailable=await api('evidence-handles',{root:root('C'),validAt,inputs:[{inputId:'value',source:descriptor('C','EV')}]});assert([404,422].includes(unavailable.status));assert(!unavailable.body.handles);}finally{await admin.query('GRANT SELECT ON finnor_os.canonical_entity_versions TO finnor_app');}const restored=await api('evidence-read',{queryId:before.queryId});assert.equal(restored.body.status,'INVALIDATED');const fresh=await finish(await submit('C'));assert.equal(fresh.status,'TESTED');return {before,failed,invalid,invalidFailed,unavailable,restored,fresh};});
 await test('decisive-tail-beyond-view',{records:5001,decisiveFinalValue:'999',candidateLimit:5000,viewLimit:1000},'real oversized source cannot acquire a complete material handle by silently discarding decisive data',async()=>{const series=await createMetricSeries(ctx,{subjectType:'external_organization',subjectId:companies.C,metricKey:'bounded_tail',name:'Decisive tail',unit:'currency',currencyCode:'USD',frequency:'daily'}),tailId='ffffffff-ffff-4fff-bfff-ffffffffffff';await admin.query(`INSERT INTO finnor_os.pe_metric_observations(id,tenant_id,metric_series_id,period_start,period_end,value_type,value_numeric,evidence_source_id,evidence_version_id,source_system,created_by)
 SELECT CASE WHEN n=5000 THEN $2::uuid ELSE gen_random_uuid() END,$1,$3,'2010-01-01'::timestamptz+n*interval '1 day','2010-01-01'::timestamptz+n*interval '1 day','number',CASE WHEN n=5000 THEN 999 ELSE 1 END,$4,$5,'p4:e2e:bounded-tail',$6 FROM generate_series(0,5000) n`,[tenant,tailId,series.row.id,sourceRef.evidenceSourceId,sourceRef.evidenceVersionId,actor]);const membership=(await admin.query('SELECT count(*)::text count FROM finnor_os.pe_metric_observations WHERE tenant_id=$1 AND metric_series_id=$2',[tenant,series.row.id])).rows[0];const last=(await admin.query('SELECT value_numeric::text value,value_numeric=999 exact,period_start,period_end FROM finnor_os.pe_metric_observations WHERE tenant_id=$1 AND id=$2',[tenant,tailId])).rows[0];assert.equal(membership.count,'5001');assert.equal(last.exact,true);const refused=await api('evidence-handles',{root:root('C'),validAt,inputs:[{inputId:'value',source:descriptor('C','bounded_tail',{frequency:'daily',periodStart:last.period_start.toISOString(),periodEnd:last.period_end.toISOString()})}]});assert.equal(refused.status,422,JSON.stringify(refused));assert(!refused.body.handles);assert.match(JSON.stringify(refused),/COVERAGE|CANDIDATE|BOUND|TRUNCAT/);return {membership,last,refused};});
}
