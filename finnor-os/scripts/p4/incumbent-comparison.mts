  return {preparationMs,prepared,pairs,costUSD:null,costStatus:'LOCAL_COST_UNMETERED',qualifiedFrontierDelta:'INCONCLUSIVE',scope:'Actual public finite native procedures; no equipped frontier-model trial or total-dollar confidence interval.'};
