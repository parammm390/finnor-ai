import {strict as assert} from 'node:assert';
import {randomUUID} from 'node:crypto';
import {spawn,spawnSync} from 'node:child_process';
import {readFile,writeFile} from 'node:fs/promises';
import {join} from 'node:path';
import {withTenantTransaction} from '@finnor/db';
import {createDocument,appendDocumentVersion} from '@finnor/data-platform';
import {createMetricSeries,recordMetricObservation,restateMetricObservation} from '@finnor/private-equity';
export async function adversarialE2E(e:any){const {test,api,handles,submit,finish,descriptor,root,ctx,admin,tenant,actor,companies,sourceRef,evidence,periodStart,periodEnd,validAt,repo}=e;
 const binary=(op:string)=>({schema:'finnor.derivation-ir.v1',nodes:[{id:'lr',op:'source',inputId:'left'},{id:'left',op:'unique',input:'lr'},{id:'rr',op:'source',inputId:'right'},{id:'right',op:'unique',input:'rr'},{id:'value',op,left:'left',right:'right',decimalPlaces:18}],outputs:['value']});
 const one={schema:'finnor.derivation-ir.v1',nodes:[{id:'rows',op:'source',inputId:'value'},{id:'value',op:'unique',input:'rows'}],outputs:['value']};
 const accept={selectedUniverse:'COMPLETE',absoluteTolerance:'0',materialOutputs:['value']};
 async function metric(key:string,value:string,overrides:any={}){const s=await createMetricSeries(ctx,{subjectType:'external_organization',subjectId:companies.C,metricKey:key,name:key,unit:'currency',currencyCode:'USD',frequency:'annual',...overrides});const observation=await recordMetricObservation(ctx,{metricSeriesId:String(s.row.id),periodStart:new Date(periodStart),periodEnd:new Date(periodEnd),value:{type:'number',value},evidence:sourceRef});return {seriesId:s.row.id,observationId:observation.row.id};}
 async function physical(pending:any,action:(body:any)=>Promise<any>){const child=spawn(process.execPath,['--import=tsx',join(import.meta.dirname,'physical-worker.mts')],{cwd:join(repo,'finnor-os'),env:{...process.env},stdio:['ignore','pipe','pipe']});let stdout='',stderr='';child.stdout.on('data',b=>stdout+=b);child.stderr.on('data',b=>stderr+=b);const ended=new Promise<any>(yes=>child.once('exit',(code,signal)=>yes({code,signal,pid:child.pid,stdout,stderr})));let start:any;const observationDeadline=Date.now()+30000;try{while(Date.now()<observationDeadline){start=(await admin.query("SELECT body FROM finnor_os.p4_attempt_events WHERE query_id=$1 AND body->>'phase'='NATIVE_STARTED' ORDER BY created_at DESC LIMIT 1",[pending.queryId])).rows[0]?.body;if(start)break;if(child.exitCode!==null)throw Error('Physical worker stopped: '+stderr);await new Promise(r=>setTimeout(r,20));}assert(start,'Actual native start missing');const effect=await action(start);const exit=await ended;return {start,effect,exit};}finally{if(child.exitCode===null&&child.signalCode===null){child.kill('SIGTERM');await Promise.race([ended,new Promise(r=>setTimeout(r,2000))]);if(child.exitCode===null&&child.signalCode===null){child.kill('SIGKILL');await ended;}}await writeFile(join(evidence,'physical-observer-'+pending.queryId+'.json'),JSON.stringify({observationDeadline,start:start??null,exitCode:child.exitCode,signalCode:child.signalCode,pid:child.pid,stdout,stderr},null,2));}}
 async function artifact(label:string,subject:any,row:any){const python=process.env.FINNOR_P4_FIXTURE_PYTHON??'/Users/paramdave/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3';const spec={folder:join(evidence,'bytes',label),entityId:subject.entityId,rows:[row]},built=spawnSync(python,[join(import.meta.dirname,'document-fixtures.py')],{input:JSON.stringify(spec),encoding:'utf8',timeout:30000});assert.equal(built.status,0,built.stderr);const bytes=await readFile(JSON.parse(built.stdout).xlsx);return withTenantTransaction(tenant,{userId:actor},async(db,c)=>{const {documentId}=await createDocument(db,{tenantId:tenant,kind:'other',title:'P4 '+label,provenance:{sourceSystem:'p4:e2e',createdBy:actor}});const v=await appendDocumentVersion(db,{tenantId:tenant,documentId,bytes,mediaType:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',format:'xlsx',origin:'manual_upload',actor,head:{kind:'current',key:'default',expectedVersionId:null}});await c.query("INSERT INTO finnor_os.artifact_bindings(tenant_id,version_id,anchor_id,anchor_hash,target_kind,target_id,target_entity_type,actor_id,created_by) VALUES($1,$2,'registered-financial-table',$3,'canonical_entity',$4,'external_organization',$5,'p4:e2e')",[tenant,v.id,v.byte_sha256,subject.entityId,actor]);const headers=['entityId','metricKey','value','periodStart','periodEnd','currencyCode','frequency','unit','calendar','consolidation','instrument','scale','sign'];return {...descriptor('A','Revenue'),kind:'artifact',subject,documentId,documentVersionId:v.id,periodStart:row.periodStart??periodStart,periodEnd:row.periodEnd??periodEnd,frequency:row.frequency??'annual',consolidation:row.consolidation??'OWNER_SUBJECT_ONLY',layout:{format:'xlsx',sheet:'Financials',headerRow:1,columns:Object.fromEntries(headers.map((h,i)=>[h,String.fromCharCode(65+i)]))}};});}
 await test('fatal-revenue-twenty-percent',{A:{value:'120',period:'annual',scope:'CONSOLIDATED'},B:{value:'100',period:'trailing quarter',scope:'STANDALONE'},temptingWrongAnswer:'0.2'},'individually valid exact citations across same-name parent/subsidiary and incompatible scopes/periods cannot certify 20% growth',async()=>{await admin.query("UPDATE finnor_os.external_organizations SET name='Revenue Holdings' WHERE tenant_id=$1 AND id=ANY($2::uuid[])",[tenant,[companies.A,companies.B]]);const left=await artifact('fatal-parent-annual',root('A'),{metricKey:'Revenue',value:'120',consolidation:'CONSOLIDATED'}),right=await artifact('fatal-subsidiary-quarter',root('B'),{metricKey:'Revenue',value:'100',periodStart:'2025-10-01T00:00:00.000Z',frequency:'quarterly',consolidation:'STANDALONE'});const hs=await handles('A',[{inputId:'left',source:left},{inputId:'right',source:right}]);assert(hs.every((h:any)=>h.coverage.status==='COMPLETE'&&h.coverage.rowCount===1));const result=await finish(await submit('A',{question:'Did consolidated annual parent revenue increase 20% from the subsidiary trailing quarter?',handles:hs,program:binary('growth'),acceptance:accept}));assert.equal(result.status,'FAILED');assert.equal(result.derivation.result,null);assert.match(result.derivation.failure.predicate,/ENTITY|PERIOD|CONSOLIDATION/);return {left,right,hs,result};});
 await test('join-scope-laundering-refusal',{parentAnnual:'120',subsidiaryQuarter:'100',joinKey:'metricKey'},'a matching label cannot launder another entity or reporting scope through a material join',async()=>{const left=await artifact('join-parent-annual',root('A'),{metricKey:'Revenue',value:'120',consolidation:'CONSOLIDATED'}),right=await artifact('join-subsidiary-quarter',root('B'),{metricKey:'Revenue',value:'100',periodStart:'2025-10-01T00:00:00.000Z',frequency:'quarterly',consolidation:'STANDALONE'});const hs=await handles('A',[{inputId:'left',source:left},{inputId:'right',source:right}]);const program={schema:'finnor.derivation-ir.v1',nodes:[{id:'lr',op:'source',inputId:'left'},{id:'rr',op:'source',inputId:'right'},{id:'joined',op:'join',left:'lr',right:'rr',on:['metricKey']},{id:'value',op:'unique',input:'joined'}],outputs:['value']};const refused=await finish(await submit('A',{handles:hs,program,acceptance:accept}));assert.equal(refused.status,'FAILED',JSON.stringify(refused));assert.equal(refused.derivation.result,null);assert.match(refused.derivation.failure.predicate,/ENTITY|PERIOD|SCOPE/);return {left,right,refused};});
 await test('original-capital-95-less25',{available:'95',otherMandateReservationFixture:'25',expected:'70'},'exact visible available-equity and reservation fixture arithmetic yields70 with source witnesses; no S4/S5 allocation is invented',async()=>{await metric('available_equity_fixture','95');await metric('reserved_elsewhere_fixture','25');const hs=await handles('C',[{inputId:'left',source:descriptor('C','available_equity_fixture')},{inputId:'right',source:descriptor('C','reserved_elsewhere_fixture')}]);const result=await finish(await submit('C',{question:'Derive95 minus25 fixture headroom; do not select an allocation.',handles:hs,program:binary('subtract'),acceptance:accept}));assert.equal(result.status,'TESTED');assert.equal(result.derivation.result.outputs.value.value,'70');assert.equal(result.derivation.funding,null);assert.equal(result.derivation.mandate,null);return {result,futureExpectedAllocations:'A+C3.5, B+C3.0 when A needs60, A alone with70: UNCLAIMED'};});
 await test('missing-fx-zero-and-ambiguous-instrument',{USD:'20',EUR:'20',zero:'0'},'missing FX source, zero denominator, and unsupported instrument/calendar metadata refuse complete material output',async()=>{await metric('usd_twenty','20');await metric('eur_twenty','20',{currencyCode:'EUR'});await metric('zero_denominator','0');const fxHandles=await handles('C',[{inputId:'left',source:descriptor('C','usd_twenty')},{inputId:'right',source:descriptor('C','eur_twenty',{currencyCode:'EUR'})}]);const fx=await finish(await submit('C',{handles:fxHandles,program:binary('add'),acceptance:accept}));assert.equal(fx.status,'FAILED');assert.match(fx.derivation.failure.predicate,/FX|CURRENCY/);const zeroHandles=await handles('C',[{inputId:'left',source:descriptor('C','usd_twenty')},{inputId:'right',source:descriptor('C','zero_denominator')}]);const zero=await finish(await submit('C',{handles:zeroHandles,program:binary('ratio'),acceptance:accept}));assert.equal(zero.status,'FAILED');assert.match(zero.derivation.failure.predicate,/ZERO/);const tenor=await api('evidence-handles',{root:root('C'),validAt,inputs:[{inputId:'value',source:descriptor('C','usd_twenty',{instrument:'ambiguous revolving vs term facility',calendar:'GREGORIAN'})}]});assert.equal(tenor.status,422);return {fx,zero,tenor};});
 await test('host-code-network-write-injection',{targets:['SQL','eval','shell','network','metadata URL','filesystem','forged principal','cache injection','node bound']},'strict real authenticated API schemas deny arbitrary execution and attenuated-handle escapes before a job exists',async()=>{const hs=await handles('C',[{inputId:'value',source:descriptor('C','EV')}]);const request={schema:'finnor.evidence-request.v1',question:'bounded',root:root('C'),validAt,mode:'ordinary_disposable',inputs:hs.map((h:any)=>({inputId:h.inputId,handleId:h.id})),program:one,acceptance:accept};const before=Number((await admin.query('SELECT count(*) count FROM finnor_os.p4_queries WHERE tenant_id=$1',[tenant])).rows[0].count),responses:any[]=[];for(const extra of [{code:'process.env'},{sql:'SELECT pg_read_file(\'/etc/passwd\')'},{shell:'curl http://169.254.169.254'},{network:'https://metadata.invalid'},{principalId:randomUUID()},{reusable:{value:'999'}},{program:{...one,nodes:[{id:'value',op:'eval',code:'fetch()'}]}},{program:{...one,nodes:Array.from({length:65},(_,i)=>({id:'node'+i,op:'source',inputId:'value'})),outputs:['node64']}}]){const denied=await api('evidence-submit',{...request,idempotencyKey:randomUUID(),...extra});assert.equal(denied.status,400,JSON.stringify(denied));responses.push(denied);}const path=await api('evidence-handles',{root:root('C'),inputs:[{inputId:'value',source:{...descriptor('C','EV'),path:'/etc/passwd'}}]});assert.equal(path.status,400);assert.equal(Number((await admin.query('SELECT count(*) count FROM finnor_os.p4_queries WHERE tenant_id=$1',[tenant])).rows[0].count),before);return {responses,path,newQueries:0};});
 await test('selected-row-bound',{threeMaterialSources:3,maxRows:2},'combined material source bound refuses instead of discarding a decisive source',async()=>{const result=await finish(await submit('C',{limits:{maxRows:2,maxBytes:8388608,deadlineMs:30000}}));assert.equal(result.status,'FAILED');assert.equal(result.derivation.result,null);assert.equal(result.derivation.failure.predicate,'COMBINED_SELECTED_SOURCE_ROW_BOUND');return result;});
 await test('canonical-deletion-prior-closure',{},'canonical physical deletion stays forbidden; real restatement and document archival invalidate direct and prior-result descendants with immutable history retained',async()=>{const m=await metric('delete_me','200');const hs=await handles('C',[{inputId:'value',source:descriptor('C','delete_me')}]);const parent=await finish(await submit('C',{handles:hs,program:one,acceptance:accept}));assert.equal(parent.status,'TESTED');assert.equal(parent.derivation.result.outputs.value.value,'200');const childHandles=await handles('C',[{inputId:'value',source:{kind:'derivation',derivationId:parent.derivation.id,output:'value'}}]);const child=await finish(await submit('C',{handles:childHandles,program:one,acceptance:accept}));assert.equal(child.status,'TESTED',JSON.stringify(child));await assert.rejects(admin.query('DELETE FROM finnor_os.pe_metric_observations WHERE tenant_id=$1 AND id=$2',[tenant,m.observationId]),/canonical rows cannot be deleted/);await restateMetricObservation(ctx,{priorObservationId:String(m.observationId),expectedVersion:1,replacement:{value:{type:'number',value:'201'},evidence:sourceRef}});const p=await api('evidence-read',{queryId:parent.queryId}),c=await api('evidence-read',{queryId:child.queryId});assert.equal(p.body.status,'INVALIDATED');assert.equal(c.body.status,'INVALIDATED');assert(!p.body.derivation?.result);assert(!c.body.derivation?.result);const history=Number((await admin.query("SELECT count(*) count FROM finnor_os.canonical_entity_versions WHERE tenant_id=$1 AND entity_type='pe_metric_observation' AND entity_id=$2",[tenant,m.observationId])).rows[0].count);assert(history>=1);const doc=await artifact('logical-deletion',root('C'),{metricKey:'Revenue',value:'200'});const docHandles=await handles('C',[{inputId:'value',source:doc}]);const docParent=await finish(await submit('C',{handles:docHandles,program:one,acceptance:accept}));assert.equal(docParent.status,'TESTED');const docChildHandles=await handles('C',[{inputId:'value',source:{kind:'derivation',derivationId:docParent.derivation.id,output:'value'}}]);const docChild=await finish(await submit('C',{handles:docChildHandles,program:one,acceptance:accept}));assert.equal(docChild.status,'TESTED');await admin.query('UPDATE finnor_os.documents SET archived_at=clock_timestamp() WHERE tenant_id=$1 AND id=$2',[tenant,doc.documentId]);const archivedParent=await api('evidence-read',{queryId:docParent.queryId}),archivedChild=await api('evidence-read',{queryId:docChild.queryId});assert.equal(archivedParent.body.status,'INVALIDATED');assert.equal(archivedChild.body.status,'INVALIDATED');const fresh=await api('evidence-handles',{root:root('C'),validAt,inputs:[{inputId:'value',source:doc}]});assert([404,422].includes(fresh.status));return {parent,child,p,c,history,canonicalPhysicalDeletionRefused:true,docParent,docChild,archivedParent,archivedChild,fresh};});
 await test('running-cancellation',{},'cancellation after physical native start cannot be overwritten by stale publication',async()=>{const pending=await submit('C');const physicalRun=await physical(pending,async()=>api('evidence-cancel',{queryId:pending.queryId}));assert.equal(physicalRun.effect.body.status,'CANCELLED');const read=await api('evidence-read',{queryId:pending.queryId});assert.equal(read.body.status,'CANCELLED');assert(!read.body.derivation?.result);const events=(await admin.query('SELECT kind,body FROM finnor_os.p4_attempt_events WHERE query_id=$1 ORDER BY created_at',[pending.queryId])).rows;assert(events.some((x:any)=>x.kind==='FENCED'&&x.body.receipt));return {physicalRun,read,events};});
 await test('rights-revoked-during-native',{},'actual principal suspension after native start denies publication and retains invocation cost/history; reactivation does not restore that result',async()=>{const pending=await submit('C');const physicalRun=await physical(pending,async()=>{await admin.query("UPDATE finnor_os.users SET status='suspended' WHERE tenant_id=$1 AND id=$2",[tenant,actor]);return {suspended:true};});const denied=await api('evidence-read',{queryId:pending.queryId});assert([401,403,404].includes(denied.status));const events=(await admin.query('SELECT kind,body FROM finnor_os.p4_attempt_events WHERE query_id=$1 ORDER BY created_at',[pending.queryId])).rows;assert(events.some((x:any)=>x.body.predicate==='RIGHTS_REVOKED_AFTER_NATIVE_EXECUTION'&&x.body.receipt));await admin.query("UPDATE finnor_os.users SET status='active' WHERE tenant_id=$1 AND id=$2",[tenant,actor]);const restored=await api('evidence-read',{queryId:pending.queryId});assert.equal(restored.body.status,'INVALIDATED');assert(!restored.body.derivation?.result);return {physicalRun,denied,events,restored};});
}
