const H=['entityId','metricKey','value','periodStart','periodEnd','currencyCode','frequency','unit','calendar','consolidation','instrument','scale','sign'];
export async function extendedE2E(e:any){
 const {test,api,handles,submit,finish,descriptor,root,ctx,admin,tenant,actor,companies,series,observations,sourceRef,evidence,queue,periodStart,periodEnd,validAt}=e;
 const python=process.env.FINNOR_P4_FIXTURE_PYTHON??'/Users/paramdave/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3';
 const ocr=join(e.repo,'.p4-runtime/vision-ocr');process.env.FINNOR_P4_OCR_BINARY=ocr;process.env.FINNOR_P4_OCR_SHA256=createHash('sha256').update(await readFile(ocr)).digest('hex');
 let docSources:any={},consumer:any;
 async function docs(label:string,rows:any[],options:any={}){
  const folder=join(evidence,'bytes',label),spec={folder,entityId:companies.A,rows,...options};
  const result=spawnSync(python,[join(import.meta.dirname,'document-fixtures.py')],{input:JSON.stringify(spec),encoding:'utf8',timeout:30000});assert.equal(result.status,0,result.stderr);const files=JSON.parse(result.stdout),sources:any={};
  for(const format of ['xlsx','pdf','image'] as const){const bytes=await readFile(files[format]);sources[format]=await withTenantTransaction(tenant,{userId:actor},async(db,c)=>{const {documentId}=await createDocument(db,{tenantId:tenant,kind:'other',title:'P4 '+label+' '+format,provenance:{sourceSystem:'p4:e2e',createdBy:actor}});const version=await appendDocumentVersion(db,{tenantId:tenant,documentId,bytes,mediaType:format==='xlsx'?'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet':format==='pdf'?'application/pdf':'image/png',format:format==='image'?'unknown':format,origin:'manual_upload',actor,head:{kind:'current',key:'default',expectedVersionId:null}});await c.query("INSERT INTO finnor_os.artifact_bindings(tenant_id,version_id,anchor_id,anchor_hash,target_kind,target_id,target_entity_type,actor_id,created_by) VALUES($1,$2,'registered-financial-table',$3,'canonical_entity',$4,'external_organization',$5,'p4:e2e')",[tenant,version.id,version.byte_sha256,companies.A,actor]);return {...descriptor('A','EV'),kind:'artifact',documentId,documentVersionId:version.id,layout:{format,headerRow:1,...(format==='xlsx'?{sheet:'Financials',columns:Object.fromEntries(H.map((h,i)=>[h,String.fromCharCode(65+i)]))}:{delimiter:'|'})}};});}
  return sources;
 }
 async function oneSource(source:any,name='EV') {let hs;try{hs=await handles('A',[{inputId:name,source}]);}catch(error){try{await (await import('../../packages/private-equity/src/evidence-execution/sources')).createHandle(ctx,root('A'),name,source,{knowledgeAt:new Date().toISOString(),validAt});}catch(diagnostic){await writeFile(join(evidence,'document-diagnostic-'+source.layout.format+'.json'),JSON.stringify({error:String(diagnostic),receipt:(diagnostic as any).receipt??null,stack:(diagnostic as Error).stack},null,2));}throw error;}const program={schema:'finnor.derivation-ir.v1',nodes:[{id:'rows',op:'source',inputId:name},{id:'value',op:'unique',input:'rows'}],outputs:['value']};return finish(await submit('A',{handles:hs,program,acceptance:{selectedUniverse:'COMPLETE',absoluteTolerance:'0',materialOutputs:['value']}}));}
 await test('xlsx-raw-cell-and-stale-cache',{cell:'Financials!C2',expected:'120',formula:'120-70',staleCache:'999'},'real immutable XLSX raw cell succeeds; unverified formula cache has no material value',async()=>{docSources=await docs('original',[{metricKey:'EV',value:'120'},{metricKey:'debt',value:'70'},{metricKey:'EBITDA',value:'20'}]);const exact=await oneSource(docSources.xlsx);assert.equal(exact.status,'TESTED',JSON.stringify(exact));assert.equal(exact.derivation.result.outputs.value.value,'120');assert.equal(exact.derivation.witnesses[0].anchor.cell,'C2');const stale=await docs('stale-formula',[{metricKey:'EV',value:'999'}],{formula:true});const refused=await oneSource(stale.xlsx);assert.equal(refused.status,'PARTIAL',JSON.stringify(refused));assert.equal(refused.derivation?.result,null);assert.match(JSON.stringify(refused),/FORMULA_CACHE_UNVERIFIED/);return {exact,refused};});
 await test('text-pdf-witness',{value:'120'},'real PDF text yields actual page/quote and byte digest; no template-only claim',async()=>{if(!docSources.pdf)throw Error('XLSX fixture prerequisite failed');const result=await oneSource(docSources.pdf);assert.equal(result.status,'TESTED',JSON.stringify(result));assert.equal(result.derivation.result.outputs.value.value,'120');assert(result.derivation.witnesses[0].anchor.page>=1);assert(result.derivation.witnesses[0].anchor.quote.includes('120'));return result;});
 await test('real-image-ocr',{value:'120',engine:'Apple Vision'},'actual PNG recognition preserves exact subject/financial row and real bounding box with uncalibrated OCR qualification',async()=>{if(!docSources.image)throw Error('document fixture prerequisite failed');const bytes=await readFile(join(evidence,'bytes/original/financials.png'));const raw=spawnSync(ocr,[],{input:bytes,maxBuffer:1048576,timeout:25000});await writeFile(join(evidence,'actual-ocr-regions.json'),raw.stdout);assert.equal(raw.status,0,raw.stderr.toString());const result=await oneSource(docSources.image);assert.equal(result.status,'TESTED',JSON.stringify(result));assert.equal(result.derivation.result.outputs.value.value,'120');assert(result.derivation.witnesses[0].anchor.region.length===4);assert(result.derivation.witnesses[0].uncertainty.includes('OCR_CONFIDENCE_NOT_CALIBRATED'));return result;});
 await test('document-duplicates-conflict-scale-sign',{},'duplicate equal facts reconcile; hidden conflicting row refuses; scale/sign normalization is exact',async()=>{const equal=await docs('equal',[{metricKey:'EV',value:'120'},{metricKey:'EV',value:'120'}]);const reconciled=await oneSource(equal.xlsx);assert.equal(reconciled.status,'TESTED');assert.equal(reconciled.derivation.result.outputs.value.value,'120');assert.equal(reconciled.derivation.result.outputs.value.witnessIds.length,2);const conflict=await docs('conflict',[{metricKey:'EV',value:'120'},{metricKey:'EV',value:'121'}],{hidden:true});const refused=await oneSource(conflict.xlsx);assert.equal(refused.status,'FAILED');assert.equal(refused.derivation?.result,null);assert.match(JSON.stringify(refused),/UNRESOLVED_SOURCE_CONFLICT/);const scaled=await docs('scale-sign',[{metricKey:'EV',value:'-0.12',scale:'1000',sign:'NEGATE'}]);const exact=await oneSource({...scaled.xlsx,scale:'1000',sign:'NEGATE'});assert.equal(exact.status,'TESTED');assert.equal(exact.derivation.result.outputs.value.value,'120');return {reconciled,refused,exact};});
 await test('document-ambiguous-date-refusal',{rawPeriodStart:'01/01/2025',expected:'PARTIAL'},'registered financial dates do not guess a locale convention even when a guess would match the requested period',async()=>{const ambiguous=await docs('ambiguous-date',[{metricKey:'EV',value:'120',periodStart:'01/01/2025'}]);const refused=await oneSource(ambiguous.xlsx);assert.equal(refused.status,'PARTIAL',JSON.stringify(refused));assert.equal(refused.derivation?.result,null);assert.match(JSON.stringify(refused),/PERIOD_INTERPRETATION/);return refused;});
 await test('document-ocr-runtime-change',{expected:'120',mutation:'configured binary SHA mismatch'},'current image-derived cache binds the actual native OCR runtime and does not resurrect after restoration',async()=>{const sources=await docs('ocr-runtime',[{metricKey:'EV',value:'120'}]),original=await oneSource(sources.image);assert.equal(original.status,'TESTED');assert.equal(original.derivation.result.outputs.value.value,'120');const saved=process.env.FINNOR_P4_OCR_SHA256;let invalid:any,witness:any;try{process.env.FINNOR_P4_OCR_SHA256='0'.repeat(64);invalid=await api('evidence-read',{queryId:original.queryId});assert.equal(invalid.body.status,'INVALIDATED',JSON.stringify(invalid));assert(!invalid.body.derivation?.result);witness=await api('evidence-witness',{queryId:original.queryId,output:'value'});assert.equal(witness.status,422);}finally{process.env.FINNOR_P4_OCR_SHA256=saved;}const restored=await api('evidence-read',{queryId:original.queryId});assert.equal(restored.body.status,'INVALIDATED');const fresh=await oneSource(sources.image);assert.equal(fresh.status,'TESTED');return {original,invalid,witness,restored,fresh};});
 await test('relational-filter-project-join-aggregate',{B:['EV100','debt50','EBITDA25'],expectedSum:'175',expectedCount:'3'},'real wildcard membership, filter/project/join and aggregate have independently checked table results',async()=>{const hs=await handles('B',[{inputId:'all',source:descriptor('B','*')}]);const program={schema:'finnor.derivation-ir.v1',nodes:[{id:'all',op:'source',inputId:'all'},{id:'kept',op:'filter',input:'all',field:'value',predicate:'gte',value:'20'},{id:'cols',op:'project',input:'kept',fields:['entityId','metricKey','value']},{id:'pairs',op:'join',left:'cols',right:'cols',on:['entityId','metricKey']},{id:'sumRows',op:'aggregate',input:'pairs',method:'sum',groupBy:[]},{id:'sum',op:'unique',input:'sumRows'},{id:'countRows',op:'aggregate',input:'pairs',method:'count',groupBy:[]},{id:'count',op:'unique',input:'countRows'}],outputs:['sum','count']};const result=await finish(await submit('B',{handles:hs,program,acceptance:{selectedUniverse:'COMPLETE',absoluteTolerance:'0',materialOutputs:['sum','count']}}));assert.equal(result.status,'TESTED',JSON.stringify(result));assert.equal(result.derivation.result.outputs.sum.value,'175');assert.equal(result.derivation.result.outputs.count.value,'3');assert.equal(result.derivation.result.outputs.count.semantics.unit,'count');return result;});
 await test('typed-underwriting-consumer',{B:{equity:'50'}},'actual immutable ModelVersion and persisted existing underwriting engine consume only a typed current DERIVED_VALUE',async()=>{const fresh=await finish(await submit('B'));assert.equal(fresh.status,'TESTED');const deal=await createDeal(ctx,{targetOrganizationId:companies.B,name:'P4 typed consumer',dealLeadEmployeeId:actor,signedLoiAt:new Date(periodStart),targetClosingAt:new Date('2027-01-01')});const investmentCase=await createInvestmentCase(ctx,{dealId:String(deal.row.id),title:'P4 typed consumer'});const investmentCaseId=String(investmentCase.row.id);const model=await createUnderwritingModel(ctx,{investmentCaseId,modelKey:'p4-evidence',name:'P4 evidence consumer'});const semantics=fresh.derivation.result.outputs.equity.semantics;const version=await createUnderwritingModelVersion(ctx,{modelId:String(model.id),definition:{schemaVersion:'underwriting-model-ir.v1',modelKey:'p4-evidence',modelVersion:'1',financialConventionVersion:'finnor-pe-lbo/1.0.0',minimumEngineVersion:'finnor-underwriting-engine/1.0.0',periodDefinition:{frequency:'annual',forecastStart:'2026-01-01',count:1},nodes:[{id:'equity',kind:'input',dependencies:[],valueType:'decimal',unit:'money',currency:'USD',shape:'scalar',required:true,allowedTruthClasses:['DERIVED_VALUE'],evidenceSemantics:semantics},{id:'equity_out',kind:'output',dependencies:['equity'],sourceNodeId:'equity',valueType:'decimal',unit:'money',currency:'USD',shape:'scalar'}],circularBlocks:[]}});const body={investmentCaseId,modelVersionId:String(version.id),worldAt:validAt,idempotencyKey:randomUUID(),bindings:{equity:{derivationId:fresh.derivation.id,output:'equity'}}};const used=await api('evidence-consume',body);assert.equal(used.status,200,JSON.stringify(used));assert.equal(used.body.inputSnapshot.values.equity.truthClass,'DERIVED_VALUE');assert.equal(used.body.inputSnapshot.values.equity.provenance[0].kind,'evidence_derivation');assert.equal(used.body.result.outputs.equity_out.value,'50');const persisted=(await admin.query('SELECT work_id::text FROM finnor_os.underwriting_runs WHERE id=$1',[used.body.id])).rows[0];assert.equal(persisted.work_id,fresh.workId);assert.equal(used.body.workId,fresh.workId);const coreLinks=(await admin.query("SELECT entity_type,entity_id::text,source FROM finnor_os.work_entity_links WHERE tenant_id=$1 AND work_id=$2 AND entity_type='pe_investment_case' AND entity_id=$3",[tenant,fresh.workId,investmentCaseId])).rows;assert.equal(coreLinks.length,1);consumer={body,used,fresh,persisted,coreLinks};return consumer;});
 await test('typed-consumer-work-scope',{},'a caller-selected conflicting Work refuses before creating another underwriting run',async()=>{assert(consumer,'typed consumer prerequisite failed');const before=(await admin.query('SELECT count(*)::text count FROM finnor_os.underwriting_runs')).rows[0].count;const refused=await api('evidence-consume',{...consumer.body,workId:randomUUID(),idempotencyKey:randomUUID()});assert.equal(refused.status,422,JSON.stringify(refused));assert.equal(refused.body.predicate,'DERIVATION_CONSUMER_WORK_SCOPE_MISMATCH');assert.equal((await admin.query('SELECT count(*)::text count FROM finnor_os.underwriting_runs')).rows[0].count,before);return {refused,noAdditionalRun:true};});
 await test('supported-model-version-source',{value:'50'},'actual immutable ModelVersion/run scalar has exact model and original source witnesses and current dependency closure',async()=>{assert(consumer,'typed consumer prerequisite failed');const source={kind:'model',subject:root('B'),modelVersionId:consumer.body.modelVersionId,runId:consumer.used.body.id,output:'equity_out'};const hs=await handles('B',[{inputId:'modelValue',source}]);const program={schema:'finnor.derivation-ir.v1',nodes:[{id:'rows',op:'source',inputId:'modelValue'},{id:'value',op:'unique',input:'rows'}],outputs:['value']};const done=await finish(await submit('B',{handles:hs,program,acceptance:{selectedUniverse:'COMPLETE',absoluteTolerance:'0',materialOutputs:['value']}}));assert.equal(done.status,'TESTED',JSON.stringify(done));assert.equal(done.derivation.result.outputs.value.value,'50');assert(done.derivation.witnesses.some((w:any)=>w.sourceKind==='model'&&w.version===consumer.body.modelVersionId&&w.recordId===consumer.used.body.id));assert(done.derivation.witnesses.some((w:any)=>w.sourceKind==='canonical'));assert(done.derivation.invalidationKeys.some((d:any)=>d.key==='derivation:'+consumer.fresh.derivation.id));consumer.modelSource=source;consumer.modelQuery=done;return {source,handles:hs,done};});
 await test('model-source-identity-refusal',{},'a different ModelVersion, target entity or absent output has no usable source handle',async()=>{assert(consumer?.modelSource,'model source prerequisite failed');const observed=[];for(const source of [{...consumer.modelSource,modelVersionId:randomUUID()},{...consumer.modelSource,subject:root('A')},{...consumer.modelSource,output:'absent'}]){const refused=await api('evidence-handles',{root:root('B'),validAt,inputs:[{inputId:'modelValue',source}]});assert([404,422].includes(refused.status),JSON.stringify(refused));assert(!refused.body.handles);observed.push(refused);}return observed;});
 await test('bounded-deadline-and-cancel',{},'source/compute deadlines refuse usable output and queued cancellation records its real terminal state',async()=>{const timed=await finish(await submit('C',{limits:{maxRows:1000,maxBytes:8388608,deadlineMs:25}}));assert.notEqual(timed.status,'TESTED');assert(!timed.derivation?.result);assert.match(JSON.stringify(timed),/DEADLINE/);const pending=await submit('C'),cancel=await api('evidence-cancel',{queryId:pending.queryId});assert.equal(cancel.body.status,'CANCELLED');const reloaded=await api('evidence-read',{queryId:pending.queryId});assert.equal(reloaded.body.status,'CANCELLED');await queue.tick();return {timed,cancel,reloaded};});
 async function physical(submitted:any,action:(child:any,receipt:any)=>Promise<any>){const child=spawn(process.execPath,['--import=tsx',join(import.meta.dirname,'physical-worker.mts')],{cwd:join(e.repo,'finnor-os'),env:{...process.env},stdio:['ignore','pipe','pipe']});let stdout='',stderr='';child.stdout.on('data',b=>stdout+=b);child.stderr.on('data',b=>stderr+=b);const ended=new Promise<any>(yes=>child.once('exit',(code,signal)=>yes({code,signal,stdout,stderr,pid:child.pid})));let start:any;const observationDeadline=Date.now()+30000;try{while(Date.now()<observationDeadline){start=(await admin.query("SELECT body FROM finnor_os.p4_attempt_events WHERE query_id=$1 AND body->>'phase'='NATIVE_STARTED' ORDER BY created_at DESC LIMIT 1",[submitted.queryId])).rows[0]?.body;if(start)break;if(child.exitCode!==null)throw Error('Physical worker ended before native invocation: '+stderr);await new Promise(r=>setTimeout(r,20));}assert(start,'actual native invocation not observed');const performed=await action(child,start);const exit=await ended;return {start,performed,exit};}finally{if(child.exitCode===null&&child.signalCode===null){child.kill('SIGTERM');await Promise.race([ended,new Promise(r=>setTimeout(r,2000))]);if(child.exitCode===null&&child.signalCode===null){child.kill('SIGKILL');await ended;}}await writeFile(join(evidence,'physical-observer-'+submitted.queryId+'.json'),JSON.stringify({observationDeadline,start:start??null,exitCode:child.exitCode,signalCode:child.signalCode,pid:child.pid,stdout,stderr},null,2));}}
 await test('physical-worker-kill-recovery',{},'SIGKILL after real native start, actual queue lease recovery, new delivery/fence and one published generation preserve unknown abandoned cost',async()=>{const pending=await submit('C');const killed=await physical(pending,async child=>{child.kill('SIGKILL');return {signal:'SIGKILL',pid:child.pid};});await new Promise(r=>setTimeout(r,3300));const recovered=await queue.recoverExpiredRunningJobs();assert(recovered>=1);const recoveryWaitStarted=Date.now();for(let n=0;n<15;n++){const ready=(await admin.query("SELECT run_at<=clock_timestamp() ready FROM finnor_os.jobs WHERE payload->>'queryId'=$1",[pending.queryId])).rows[0]?.ready;if(ready)break;await new Promise(r=>setTimeout(r,5000));}const done=await finish(pending);assert.equal(done.status,'TESTED',JSON.stringify(done));assert(done.derivation.costs.attempts>=2);assert(done.derivation.costs.unreconciledAttemptIds.length>=1);const history=(await admin.query('SELECT * FROM finnor_os.job_delivery_attempts WHERE job_id=$1 ORDER BY started_at',[done.derivation.runtime.jobId])).rows;assert(history.length>=2);assert.equal((await admin.query('SELECT count(*)::text count FROM finnor_os.p4_derivations WHERE query_id=$1',[pending.queryId])).rows[0].count,'1');return {killed,recovered,recoveryWaitMs:Date.now()-recoveryWaitStarted,done,history};});
 await test('publication-source-race',{},'source correction after NATIVE_STARTED fences publication and stale consumer/get/explain refuse the persisted old basis',async()=>{const pending=await submit('B');const race=await physical(pending,async()=>restateMetricObservation(ctx,{priorObservationId:observations['B.debt'],expectedVersion:1,replacement:{value:{type:'number',value:'60'},evidence:sourceRef}}));const reloaded=await api('evidence-read',{queryId:pending.queryId});assert.equal(reloaded.body.status,'INVALIDATED',JSON.stringify(reloaded));assert(!reloaded.body.derivation?.result);const attempts=(await admin.query('SELECT kind,body FROM finnor_os.p4_attempt_events WHERE query_id=$1 ORDER BY created_at',[pending.queryId])).rows;assert(attempts.some((a:any)=>a.kind==='FENCED'));return {race,reloaded,attempts};});
 await test('stale-consumer-refusal',{},'typed reuse, get run, explain, and artifact comparison reject corrected derived input without promoting it to a fact',async()=>{assert(consumer,'consumer prerequisite failed');const replay=await api('evidence-consume',{...consumer.body,idempotencyKey:randomUUID()});assert.equal(replay.status,422,JSON.stringify(replay));await assert.rejects(getUnderwritingRun(ctx,consumer.used.body.id));await assert.rejects(explainUnderwritingOutput(ctx,consumer.used.body.id,'equity_out'));const {compareUnderwritingRunToArtifact}=await import('@finnor/private-equity');await assert.rejects(compareUnderwritingRunToArtifact(ctx,{runId:consumer.used.body.id,documentId:docSources.xlsx.documentId,documentVersionId:docSources.xlsx.documentVersionId}));const staleModel=await api('evidence-read',{queryId:consumer.modelQuery.queryId});assert.equal(staleModel.body.status,'INVALIDATED');assert(!staleModel.body.derivation?.result);const refusedHandle=await api('evidence-handles',{root:root('B'),validAt,inputs:[{inputId:'modelValue',source:consumer.modelSource}]});assert([404,422].includes(refusedHandle.status));return {replay,staleModel,refusedHandle,oldRunId:consumer.used.body.id,readRefused:true,explainRefused:true,artifactComparisonRefused:true};});
 await test('historical-commit-visibility',{},'a source inserted before knowledge cut but committed after it cannot appear in the historical selected domain',async()=>{const s=await createMetricSeries(ctx,{subjectType:'external_organization',subjectId:companies.C,metricKey:'late_commit',name:'Late commit',unit:'currency',currencyCode:'USD',frequency:'annual'});await admin.query('BEGIN');await admin.query("SET LOCAL app.test_vertical_mode='explicit'");await admin.query("INSERT INTO finnor_os.pe_metric_observations(tenant_id,metric_series_id,period_start,period_end,value_type,value_numeric,evidence_source_id,evidence_version_id,source_system,created_by) VALUES($1,$2,$3,$4,'number',777,$5,$6,'p4:e2e',$7)",[tenant,s.row.id,periodStart,periodEnd,sourceRef.evidenceSourceId,sourceRef.evidenceVersionId,actor]);const cut=(await admin.query('SELECT clock_timestamp() at')).rows[0].at.toISOString();await new Promise(r=>setTimeout(r,15));await admin.query('COMMIT');const historical=await api('evidence-handles',{root:root('C'),validAt,knowledgeAt:cut,inputs:[{inputId:'late',source:descriptor('C','late_commit')}]});assert.equal(historical.status,200,JSON.stringify(historical));assert.equal(historical.body.handles[0].coverage.rowCount,0);assert.equal(historical.body.handles[0].coverage.status,'PARTIAL');const fresh=await handles('C',[{inputId:'late',source:descriptor('C','late_commit')}]);assert.equal(fresh[0].coverage.rowCount,1);return {cut,historical,fresh};});
 await test('schema-change-invalidation',{},'real catalog change invalidates existing complete results; restored schema cannot rewrite the old immutable artifact',async()=>{const current=await finish(await submit('C'));assert.equal(current.status,'TESTED');await admin.query('ALTER TABLE finnor_os.pe_metric_series ADD COLUMN p4_schema_challenge text');const invalid=await api('evidence-read',{queryId:current.queryId});assert.equal(invalid.body.status,'INVALIDATED');await admin.query('ALTER TABLE finnor_os.pe_metric_series DROP COLUMN p4_schema_challenge');return {invalid,derivationId:current.derivation.id};});
}
