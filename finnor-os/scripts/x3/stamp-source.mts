/** Deterministic pre-build metadata. Bundlers embed it, so a stale emitted API
 * cannot attest to newer source files merely by hashing them at runtime. */
import {readFile,writeFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {createHash} from 'node:crypto';
import {APPLICATION_SOURCE_PATHS} from '../../packages/private-equity/src/enterprise-applications/source-paths';
const root=resolve(import.meta.dirname,'../../..');
const files=await Promise.all(APPLICATION_SOURCE_PATHS.map(async path=>({path,sha256:createHash('sha256').update(await readFile(resolve(root,path))).digest('hex')})));
const path=resolve(root,'finnor-os/packages/private-equity/src/enterprise-applications/source-manifest.generated.ts');
const text='// Generated by scripts/x3/stamp-source.mts. Do not edit.\nexport default '+JSON.stringify({schema:'finnor.x3.emitted-source.v1',files},null,2)+' as const;\n';
const previous=await readFile(path,'utf8').catch(error=>{if(error.code==='ENOENT')return '';throw error;});
if(process.argv.includes('--check')){if(previous!==text)throw Error('X3_SOURCE_STAMP_STALE');}
else if(previous!==text)await writeFile(path,text);
console.log('X3_EMITTED_SOURCE_STAMP',files.length);
