/** Run after the X3 host stamp and generated contracts, before emitted builds. */
import {readFile,writeFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {createHash} from 'node:crypto';
import {LEARNING_SOURCE_PATHS} from '../../packages/private-equity/src/policy-learning/source-paths';
const root=resolve(import.meta.dirname,'../../..');
const files=await Promise.all(LEARNING_SOURCE_PATHS.map(async path=>({path,sha256:createHash('sha256').update(await readFile(resolve(root,path))).digest('hex')})));
const path=resolve(root,'finnor-os/packages/private-equity/src/policy-learning/source-manifest.generated.ts');
const body='// Generated by scripts/x5/stamp-source.mts. Do not edit.\nexport default '+JSON.stringify({schema:'finnor.x5.emitted-source.v1',files},null,2)+' as const;\n';
const prior=await readFile(path,'utf8');
if(process.argv.includes('--check')){if(prior!==body)throw Error('X5_SOURCE_STAMP_STALE');}
else if(prior!==body)await writeFile(path,body);
console.log('X5_EMITTED_SOURCE_STAMP',files.length);
