  const id=await submit({kind:'modal_execute',code,sources:[],stdin:'',timeoutMs:120000});const run=await settle(id,125000);assert.equal(run.status,'SUCCEEDED',run.failureCode);assert.equal(run.result.executionStatus,'PROGRAM_COMPLETED');const observation=JSON.parse(Buffer.from(run.result.program.stdoutBase64,'base64').toString());assert.equal(observation.marker,'FINNOR_MODAL_NATIVE_OK');assert.equal(observation.uid,65534);assert.equal(observation.networkBlocked,true);assert.equal(observation.providerCredentialVariablesPresent,false);assert.equal(run.result.terminationAcknowledged,true);return{runId:id,sandboxId:run.result.sandboxId,observation,terminationAcknowledged:true,resultDigest:run.resultDigest};
