import {build} from 'esbuild';
import {readFile,writeFile} from 'node:fs/promises';
import {resolve} from 'node:path';
const root=resolve(import.meta.dirname,'../..');
const output=resolve(root,'packages/private-equity/src/economic-action-theory/constructor.generated.mjs');
const result=await build({absWorkingDir:root,entryPoints:['packages/private-equity/src/economic-action-theory/compiler.ts'],
 bundle:true,platform:'node',target:'node22',format:'esm',minify:true,write:false,
 tsconfig:resolve(root,'tsconfig.base.json')});
const body='// Generated by scripts/y1/build-constructor.mts. Do not edit.\n'+result.outputFiles[0]!.text;
if(process.argv.includes('--check')){
 if(await readFile(output,'utf8')!==body)throw Error('Y1_CONSTRUCTOR_MODULE_STALE');
}else await writeFile(output,body);
console.log('Y1_CONSTRUCTOR_MODULE',Buffer.byteLength(body));
