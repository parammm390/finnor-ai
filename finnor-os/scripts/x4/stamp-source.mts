/** Generate after contracts and X3/X5 stamps, before installed builds. */
import {readFile,writeFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {createHash} from 'node:crypto';
import {build} from 'esbuild';
import {IDENTIFICATION_SOURCE_PATHS} from '../../packages/private-equity/src/system-identification/source-paths';
const root=resolve(import.meta.dirname,'../../..');
// The fixed scientific interpreter is an emitted, pinned Node22 module. Avoid
// paying a TypeScript loader startup for each bounded physical analysis child.
const child=await build({absWorkingDir:resolve(root,'finnor-os'),entryPoints:['packages/private-equity/src/system-identification/core-child.mts'],
 bundle:true,platform:'node',target:'node22',format:'esm',write:false,banner:{js:'// Generated by scripts/x4/stamp-source.mts. Do not edit.'}});
const childPath=resolve(root,'finnor-os/packages/private-equity/src/system-identification/core-child.generated.mjs'),emitted=child.outputFiles[0]!.text;
const priorChild=await readFile(childPath,'utf8').catch(error=>{if(error.code==='ENOENT')return '';throw error;});
if(process.argv.includes('--check')){if(priorChild!==emitted)throw Error('X4_SCIENTIFIC_INTERPRETER_BUILD_STALE');}
else if(priorChild!==emitted)await writeFile(childPath,emitted);
const files=await Promise.all(IDENTIFICATION_SOURCE_PATHS.map(async path=>({path,sha256:createHash('sha256').update(await readFile(resolve(root,path))).digest('hex')})));
const path=resolve(root,'finnor-os/packages/private-equity/src/system-identification/source-manifest.generated.ts');
const body='// Generated by scripts/x4/stamp-source.mts. Do not edit.\nexport default '+JSON.stringify({schema:'finnor.x4.emitted-source.v1',files},null,2)+' as const;\n';
const prior=await readFile(path,'utf8');
if(process.argv.includes('--check')){if(prior!==body)throw Error('X4_SOURCE_STAMP_STALE');}
else if(prior!==body)await writeFile(path,body);
console.log('X4_EMITTED_SOURCE_STAMP',files.length);
