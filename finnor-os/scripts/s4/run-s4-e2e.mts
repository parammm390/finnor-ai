 await challenge('owner-obligation-and-horizon-preservation',{},'An earlier recorded commitment or residual debt cannot disappear from a linked revision, and the episode/horizon cannot reset',async()=>{const committed=structuredClone(ownerInput);committed.problem.obligations=[{ref:ref('recorded-pending','S6'),effectRef:ref('recorded-pending-effect','S6'),actionId:null,status:'KNOWN_PENDING',lockedExposureIds:[],exposures:{price:[0,0,0]},resources:{capacity:0},occupancy:{capacity:0},occupationUntilPeriod:3,terminalLiability:5}];const first=await api('synthesize',committed);assert.equal(first.status,200,JSON.stringify(first));assert(first.body.policy);const dropped=await api('replan',{...ownerInput,priorPolicyRef:first.body.policy.ref,reason:'Adversarial omission of earlier debt'});assert.equal(dropped.body.status,'UNCERTAINTY_UNRESOLVED',JSON.stringify(dropped));assert.equal(dropped.body.policy,null);const changed=structuredClone(ownerInput);changed.mandate.episodeId='unrelated-episode';changed.problem.episodeId=changed.mandate.episodeId;const {ref:r,...b}=changed.mandate;changed.mandate.ref={...r,id:`mandate:${epistemicHash(b)}`,contentDigest:epistemicHash(b)};assert.equal((await api('replan',{...changed,priorPolicyRef:policyRef,reason:'Adversarial episode reset'})).status,400);const horizon=structuredClone(ownerInput);horizon.mandate.horizon.periods=2;horizon.mandate.utility.discountFactors=[1,1,1];const {ref:hr,...hb}=horizon.mandate;horizon.mandate.ref={...hr,id:`mandate:${epistemicHash(hb)}`,contentDigest:epistemicHash(hb)};assert.equal((await api('replan',{...horizon,priorPolicyRef:policyRef,reason:'Adversarial horizon truncation'})).status,400);return {firstPolicy:first.body.policy.ref,dropped};});
 await challenge('actual-cold-process-replay',{},'Fresh process resolves the exact retained numerical snapshot, policy and input artifact',async()=>{const file=join(output,'cold-replay-input.json');await writeFile(file,JSON.stringify({operation:'replay',tenantId:tenant,principalId:principal,body:{policyRef}}));const cold=spawnSync(join(repo,'finnor-os/node_modules/.bin/tsx'),[join(repo,'finnor-os/scripts/s4/run-s4-cold.mts'),file],{env:process.env,encoding:'utf8',timeout:30000,maxBuffer:1024*1024});assert.equal(cold.status,0,cold.stderr);const replay=JSON.parse(cold.stdout);assert.equal(replay.status,200,JSON.stringify(replay));assert.equal(replay.body.programMatches,true);assert.equal(replay.body.certificateMatches,true);return replay;});
 await challenge('owner-numerical-deadline-and-byte-faults',{},'Actual backend fault and decision timeout are explicit failures; streamed bytes are rejected before parsing',async()=>{const configured=process.env.FINNOR_S3_PYTHON;let unavailable:any;try{process.env.FINNOR_S3_PYTHON=join(output,'unavailable-numerical-executable');unavailable=await api('synthesize',ownerInput);}finally{process.env.FINNOR_S3_PYTHON=configured;}assert.equal(unavailable.status,200,JSON.stringify(unavailable));assert.equal(unavailable.body.status,'NUMERICAL_FAILURE');assert.equal(unavailable.body.policy,null);assert.equal(unavailable.body.compute.cost.money,null);const tiny=structuredClone(ownerInput);tiny.mandate.search.deadlineMs=1;const {ref:r,...b}=tiny.mandate;tiny.mandate.ref={...r,id:`mandate:${epistemicHash(b)}`,contentDigest:epistemicHash(b)};const timed=await api('synthesize',tiny);assert.equal(timed.body.status,'SEARCH_EXHAUSTED',JSON.stringify(timed));assert.equal(timed.body.policy,null);const oversized=await POST(new Request('http://localhost/api/policies/read',{method:'POST',headers:{'content-type':'application/json','x-tenant-id':tenant,'x-user-id':principal},body:JSON.stringify({padding:'x'.repeat(2*1024*1024)})}),{params:Promise.resolve({operation:'read'})});assert.equal(oversized.status,413);return {unavailable,timed,oversized:{status:oversized.status,body:await oversized.json()}};});
 await challenge('owner-recorded-human-override',{},'Override assertion records human demand and cannot mutate or activate an immutable policy',async()=>{const assessment=await api('assessment',{policyRef,type:'HUMAN_OVERRIDE',reason:'Registered human objection for bounded review',requestedActionId:'wait',humanSeconds:12,evidenceRefs:[ref('objection','BUSINESS_OWNER')]});assert.equal(assessment.status,200,JSON.stringify(assessment));assert.equal(assessment.body.humanBudgetDemand,12);assert.equal(assessment.body.protectedReceipt,null);assert.equal(assessment.body.policyChanged,false);assert.equal(assessment.body.executionAuthorityGranted,false);assert.equal((await api('read',{policyRef})).body.ref.contentDigest,policyRef.contentDigest);const excessive=await api('assessment',{policyRef,type:'HUMAN_OVERRIDE',reason:'Over budget',requestedActionId:'wait',humanSeconds:901,evidenceRefs:[]});assert.equal(excessive.status,400);return {assessment,excessive};});
 await challenge('actual-s2-instrument-and-prior-boundary',{},'Actual S1/S3-linked S2 design is consumed with complete costs; S4 uses fixed ambiguity rather than supplied S2 priors',async()=>{const req=structuredClone(request);req.mechanisms.push({...structuredClone(req.mechanisms[0]),id:'parity-alternative',meaning:'Separate supplied hypothesis with the same fitted response in this cohort'});const fitted=await api('fit',{request:req},tenant,principal,s3Post);assert.equal(fitted.body.status,'FITTED',JSON.stringify(fitted));const m=structuredClone(ownerInput.mandate),newInput=structuredClone(ownerInput);m.resources.dimensions.push({id:'exposure',unit:'measurement-unit',capacity:24,totalLimit:24});const {ref:mr,...mb}=m;m.ref={...mr,id:`mandate:${epistemicHash(mb)}`,contentDigest:epistemicHash(mb)};newInput.mandate=m;for(const a of newInput.problem.actions){a.resources.exposure=0;a.occupancy.exposure=0;}newInput.problem.modelRef=fitted.body.model.ref;const design=JSON.parse(await readFile(join(repo,'finnor-os/scripts/s3/instrument-design.json'),'utf8'));design.episodeId=m.episodeId;design.mandateRef=m.ref;design.decisionContext.utilityRef=m.utilityRef;design.decisionContext.lossUnit=m.utility.unit;design.decisionContext.horizonEnd=new Date(Date.parse(m.horizon.startAt)+3*m.horizon.periodMs).toISOString();design.decisionContext.actionIds=['raise','wait','stop','inspect'];design.decisionContext.lossByHypothesis=[['0','0','0','0'],['0','0','0','0']];design.validUntil=m.validUntil;design.hypotheses=fitted.body.model.request.mechanisms.map((mechanism:any,i:number)=>{const digest=epistemicHash({modelRef:fitted.body.model.ref,mechanism});return {ref:{owner:'S3',id:`mechanism:${digest}`,version:'s3-temporal-linear-v1',contentDigest:digest},prior:i===0?'0.25':'0.75',meaning:mechanism.meaning};});design.candidates=design.candidates.slice(0,1);const candidate=design.candidates[0];candidate.samples=1;candidate.timing={startAt:new Date().toISOString(),endAt:m.validUntil,minimumIntervalMs:0};candidate.costEstimate.money={value:'1',unit:m.utility.unit};candidate.exposure.unitsPerSample='1';design.constraints.moneyLimit={value:'10',unit:m.utility.unit};candidate.likelihood.probabilities=[['1','0'],['0','1']];const designed=await api('design-experiment',{modelRef:fitted.body.model.ref,root,request:design},tenant,principal,s3Post);assert.equal(designed.status,200,JSON.stringify(designed));const protocol=designed.body.bundle.designs[0].protocol;assert(protocol);newInput.protocols=[protocol];newInput.problem.actions.push({id:'inspect',kind:'INQUIRE',cost:1,costUnit:m.utility.unit,resources:{capacity:0,exposure:1},occupancy:{capacity:0,exposure:0},occupationPeriods:1,tailLiability:0,earliestPeriod:0,lastPeriod:2,atMostOnce:true,exposures:{},protocolRef:{owner:'S2',id:protocol.id,version:protocol.version,contentDigest:protocol.contentDigest},informationDelayPeriods:1,humanSeconds:0});const result=await api('synthesize',newInput);assert.equal(result.status,200,JSON.stringify(result));assert(result.body.policy);assert.notEqual(result.body.policy.nodes.find((n:any)=>n.id===result.body.policy.rootNodeId).actionId,'inspect');assert.equal(result.body.policy.certificate.ambiguity,'FIXED_COMPLETE_SCENARIOS_NO_PROBABILITIES');const privateInstrument=structuredClone(newInput);privateInstrument.problem.observations=[{schema:'finnor.s2.control-observation.v1',id:'private-actor',sourceRef:ref('private','S2'),variableId:'unregistered-private-actor',unit:'normalized-value',delayPeriods:1,afterActionIds:['raise'],bins:[{category:'all',lowerInclusive:-6,upperExclusive:6}],qualification:'SUPPLIED_DETERMINISTIC_COARSENING_UNVERIFIED'}];assert.equal((await api('synthesize',privateInstrument)).status,400);return {design:designed.body,result};});
 await challenge('owner-foreign-and-forged-activation',{},'Foreign tenant/principal is denied, and allocation or authority claims cannot activate an effect',async()=>{assert((await api('read',{policyRef},foreignTenant,foreignPrincipal)).status>=400);const handoff=await api('handoff',{policyRef,decision:{knowledgeAt:new Date().toISOString(),period:0,actionHistory:[],observations:[],rightsRef:ownerInput.mandate.rightsRef,obligations:[],allocationRefs:[]},allocationRef:ref('forged','S5')});assert.equal(handoff.status,200,JSON.stringify(handoff));assert.equal(handoff.body.status,'BLOCKED_ALLOCATION');assert.equal(handoff.body.executionAuthorityGranted,false);return handoff;});
