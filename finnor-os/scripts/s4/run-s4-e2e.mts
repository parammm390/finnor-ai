 await challenge('actual-source-change-and-unknown-effect',{},'Independent source correction invalidates prior policy; a durable unknown effect cannot be hidden by empty obligations',async()=>{await admin!.query("UPDATE finnor_os.users SET status='active' WHERE id=$1",[principal]);assert.equal((await api('validate',{policyRef})).body.status,'STALE_INPUT');const refreshed=await api('fit',{request},tenant,principal,s3Post);assert.equal(refreshed.body.status,'FITTED',JSON.stringify(refreshed));const next=structuredClone(ownerInput);next.problem.modelRef=refreshed.body.model.ref;const revised=await api('replan',{...next,priorPolicyRef:policyRef,reason:'Source/rights-linked revision preserves prior proposal'});assert.equal(revised.status,200,JSON.stringify(revised));assert(revised.body.policy);await restateMetricObservation(ctx,{priorObservationId:observationIds['outcome:127']!,expectedVersion:1,replacement:{value:{type:'number',value:'1.5'},evidence:{evidenceSourceId:source,evidenceVersionId:version}}});const stale=await api('validate',{policyRef:revised.body.policy.ref});assert.equal(stale.body.status,'STALE_INPUT',JSON.stringify(stale));assert((await api('read',{policyRef:revised.body.policy.ref})).status>=400);const changedModel=await api('refit',{request,priorRef:refreshed.body.model.ref},tenant,principal,s3Post);assert.equal(changedModel.body.status,'FITTED',JSON.stringify(changedModel));next.problem.modelRef=changedModel.body.model.ref;const effectId=randomUUID(),digest=epistemicHash({fixture:'independent-unknown',effectId});preexistingEffect={id:effectId,semantic_hash:digest,status:'reconciliation_required'};await admin!.query("INSERT INTO finnor_os.business_effects(id,tenant_id,semantic_hash,scope_hash,operation_class,effect,status) VALUES($1,$2,$3,$3,'external_side_effect',$4::jsonb,'reconciliation_required')",[effectId,tenant,digest,JSON.stringify({schemaVersion:1,qualification:'GENERATED_PREEXISTING_UNKNOWN_NOT_S4_EXECUTION'})]);const blocked=await api('synthesize',next);assert.equal(blocked.status,200,JSON.stringify(blocked));assert.equal(blocked.body.status,'UNCERTAINTY_UNRESOLVED');assert.equal(blocked.body.policy,null);return {refreshedModel:refreshed.body.model.ref,revisedPolicy:revised.body.policy.ref,sourceCorrection:observationIds['outcome:127'],stale,changedModel:changedModel.body.model.ref,preexistingEffect,blocked};});
 await challenge('independent-no-effects-readback',{},'S4 proposals do not execute, settle or create protected receipts',async()=>{const result=await admin!.query('SELECT (SELECT count(*) FROM finnor_os.business_effects WHERE tenant_id=$1)::int effects,(SELECT count(*) FROM finnor_os.decision_receipts WHERE tenant_id=$1)::int receipts',[tenant]);assert.equal(result.rows[0].effects,preexistingEffect?1:0);assert.equal(result.rows[0].receipts,0);const effects=(await admin!.query('SELECT id,semantic_hash,status FROM finnor_os.business_effects WHERE tenant_id=$1',[tenant])).rows;assert.deepEqual(effects,preexistingEffect?[preexistingEffect]:[]);return {counts:result.rows[0],effects,qualification:'PREEXISTING_FIXTURE_EFFECT_UNCHANGED_ZERO_S4_CREATED_EFFECTS'};});
