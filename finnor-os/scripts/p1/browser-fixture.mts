 const otherBody={schema:'finnor.harness-request.v1',instruction:'Inspect another native Work with equal financial values and distinct programme identity',root:programRoot,threadId:otherThread.id,validAt:'2026-01-01T00:00:00.000Z',mode:'ordinary_disposable',idempotencyKey:'browser-other-work',sources:['EV','debt','EBITDA','liability'].map(source),acceptance:{requiredSourceKeys:['EV','debt','EBITDA','liability'],targets:[{key:'netEquity',expression:{kind:'subtract',left:{kind:'subtract',left:ref('EV'),right:ref('debt')},right:ref('liability')},unit:'currency',currencyCode:'USD'},{key:'leverage',expression:{kind:'ratio',left:ref('debt'),right:ref('EBITDA')},unit:'multiple',currencyCode:null}],deliverable:{kind:'analytical_draft',title:'Other native Work analytical draft'}}};
 const otherResponse=await (await import('../../apps/api/app/api/company-brain/[operation]/route')).POST(new Request('http://localhost/api/company-brain/program-submit',{method:'POST',headers:{authorization:'Bearer '+issue(),'content-type':'application/json'},body:JSON.stringify(otherBody)}),{params:Promise.resolve({operation:'program-submit'})});const other=await otherResponse.json();if(otherResponse.status!==202)throw Error('OTHER_NATIVE_WORK_SETUP_FAILED:'+JSON.stringify(other));
 let delayed:{programId:string;waiting:boolean;promise:Promise<void>;release:()=>void}|null=null;
 const traffic:any[]=[];
 const api=createServer(async(req,res)=>{const started=Date.now();try{const url=new URL(req.url??'/','http://127.0.0.1:4591');const parts=url.pathname.replace(/^\/api\//,'').split('/').map(decodeURIComponent);let matched:any;for(const route of routes){const params:Record<string,unknown>={};let ok=true,j=0;for(const segment of route.parts){if(segment.startsWith('[...')){params[segment.slice(4,-1)]=parts.slice(j);j=parts.length;break;}if(j>=parts.length){ok=false;break;}if(segment.startsWith('['))params[segment.slice(1,-1)]=parts[j];else if(segment!==parts[j]){ok=false;break;}j++;}if(ok&&j===parts.length){matched={...route,params};break;}}if(!matched){res.writeHead(404);res.end('{}');return;}
   let body='';for await(const b of req){body+=b;if(body.length>8388608)throw Error('BODY_BOUND');}const module=await import(pathToFileURL(matched.file).href),handler=module[req.method??'GET'];if(!handler){res.writeHead(405);res.end('{}');return;}const headers=new Headers();for(const [key,value] of Object.entries(req.headers))if(typeof value==='string')headers.set(key,value);const request=new Request(url,{method:req.method,headers,...(!['GET','HEAD'].includes(req.method??'GET')?{body}: {})});const response:Response=await handler(request,{params:Promise.resolve(matched.params)});if(delayed&&url.pathname==='/api/company-brain/program-read'&&JSON.parse(body).programId===delayed.programId&&!delayed.waiting){delayed.waiting=true;await delayed.promise;}res.writeHead(response.status,(()=>{const out:Record<string,string>={};response.headers.forEach((value,key)=>{out[key]=value;});return out;})());res.end(Buffer.from(await response.arrayBuffer()));traffic.push({path:url.pathname,method:req.method,status:response.status,ms:Date.now()-started,bearer:Boolean(req.headers.authorization),at:new Date().toISOString()});
  }catch(error){res.writeHead(500,{'content-type':'application/json'});res.end(JSON.stringify({error:'Local route host failed'}));traffic.push({path:req.url,status:500,diagnostic:String(error),at:new Date().toISOString()});}await writeFile(join(output,'traffic.json'),JSON.stringify(traffic,null,2));
 });await new Promise<void>(yes=>api.listen(4591,'127.0.0.1',yes));
 let stopped=false;let stopFixture!:()=>void;const stoppedPromise=new Promise<void>(yes=>{stopFixture=()=>{stopped=true;yes();};});
 const control=createServer(async(req,res)=>{try{if(req.method==='POST'&&req.url==='/delay-read'){let body='';for await(const bytes of req)body+=bytes;const parsed=JSON.parse(body);let release!:()=>void;const promise=new Promise<void>(yes=>{release=yes;});delayed={programId:parsed.programId,waiting:false,promise,release};res.end('{}');return;}if(req.url==='/delay-status'){res.end(JSON.stringify({waiting:delayed?.waiting??false,programId:delayed?.programId??null}));return;}if(req.method==='POST'&&req.url==='/release-read'){delayed?.release();delayed=null;res.end('{}');return;}if(req.method==='POST'&&req.url==='/stop'){delayed?.release();res.end('{}');stopFixture();return;}if(req.method==='POST'&&req.url==='/correct'){const correction=await restateMetricObservation(ctx,{priorObservationId:observations['A.debt'],expectedVersion:1,replacement:{value:{type:'number',value:'80'},evidence:sourceRef}});res.end(JSON.stringify({correction,expected:{netEquity:'33',leverage:'4'}}));return;}if(req.method==='POST'&&req.url==='/revoke'){await admin.query("UPDATE finnor_os.users SET status='suspended' WHERE tenant_id=$1 AND id=$2",[tenant,actor]);res.end('{}');return;}if(req.url==='/health'){res.end('ready');return;}res.writeHead(404);res.end('{}');}catch(error){res.writeHead(500);res.end(String(error));}});await new Promise<void>(yes=>control.listen(4593,'127.0.0.1',yes));
 const data={profile:'DISPOSABLE_LOCAL_AUTH_SERVICE_ACTUAL_BEARER_AND_RLS',hostedSupabaseQualified:false,email,password,tenant,actor,companyRoot:{entityType:'external_organization',entityId:companies.A},dealRoot:{entityType:'pe_deal',entityId:deal.row.id},threadId:thread.id,url:`http://127.0.0.1:4590/centropy/investigations/${thread.id}?root=${encodeURIComponent(JSON.stringify({entityType:'pe_deal',entityId:deal.row.id}))}`,expected:{netEquity:'43',leverage:'3.5'},other:{...other,threadId:otherThread.id,title:otherThread.title,instruction:otherBody.instruction}};await writeFile(join(output,'fixture.json'),JSON.stringify(data,null,2));await writeFile(join(output,'frontend-env.json'),JSON.stringify({NEXT_PUBLIC_OS_API_URL:'http://127.0.0.1:4591',NEXT_PUBLIC_SUPABASE_URL:'http://127.0.0.1:4592',NEXT_PUBLIC_SUPABASE_ANON_KEY:'disposable-local-auth-key'},null,2));console.log(JSON.stringify({browserFixture:'READY',fixture:join(output,'fixture.json'),url:data.url}));
