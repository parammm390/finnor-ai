 const secret=randomBytes(32),email=actor+'@test.invalid',password='p4-disposable-only';
 const user={id:actor,aud:'authenticated',role:'authenticated',email,email_confirmed_at:new Date().toISOString(),app_metadata:{provider:'email',providers:['email']},user_metadata:{},created_at:new Date().toISOString()};
 function issue(){const encode=(o:unknown)=>Buffer.from(JSON.stringify(o)).toString('base64url');const now=Math.floor(Date.now()/1000),body=encode({alg:'HS256',typ:'JWT'})+'.'+encode({sub:actor,email,aud:'authenticated',role:'authenticated',iat:now,exp:now+3600,iss:'http://127.0.0.1:4592/auth/v1'});return body+'.'+createHmac('sha256',secret).update(body).digest('base64url');}
 function verify(token:string){try{const [h,p,s]=token.split('.');if(!h||!p||!s)return false;const signature=createHmac('sha256',secret).update(h+'.'+p).digest();const actual=Buffer.from(s,'base64url');const claims=JSON.parse(Buffer.from(p,'base64url').toString());return actual.length===signature.length&&timingSafeEqual(signature,actual)&&claims.sub===actor&&claims.exp>Date.now()/1000;}catch{return false;}}
 const auth=createServer(async(req,res)=>{res.setHeader('access-control-allow-origin','http://127.0.0.1:4590');res.setHeader('access-control-allow-headers','authorization,apikey,content-type,x-client-info,x-supabase-api-version');res.setHeader('access-control-allow-methods','GET,POST,OPTIONS');res.setHeader('content-type','application/json');if(req.method==='OPTIONS'){res.end();return;}let text='';for await(const b of req){text+=b;if(text.length>16384){res.writeHead(413);res.end('{}');return;}}let body:any;try{body=JSON.parse(text||'{}');}catch{res.writeHead(400);res.end('{}');return;}
