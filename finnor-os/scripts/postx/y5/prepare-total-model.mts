import {mkdir,readFile,writeFile,realpath,statfs,stat} from 'node:fs/promises';
import {join,resolve,dirname,isAbsolute} from 'node:path';
import {native,toolIdentity,prepareScratch} from '../../../packages/epistemic-runtime/src/uniform-algorithms/native';
import {hash,jsonHash} from '../../../packages/epistemic-runtime/src/uniform-algorithms/syntax';
import {TOTAL_MODEL_PIN} from '../../../packages/epistemic-runtime/src/uniform-algorithms/total/model-pin.generated';
import {totalModelPath,totalModelPinPath,modelPinSchema,modelSetupSchema,readModelAssetBytes} from '../../../packages/epistemic-runtime/src/uniform-algorithms/total/model-asset';
const args=process.argv.slice(2),at=args.indexOf('--output'),output=at>=0?args[at+1]:undefined,writePin=args.includes('--write-pin');
if(!output||!isAbsolute(output)||args.some((a,i)=>i!==at&&i!==at+1&&a!=='--write-pin'))throw Error('Y5_TOTAL_SETUP_USAGE_ABSOLUTE_OUTPUT_REQUIRED');
const started=Date.now(),deadlineAt=started+60000,source=await readFile(totalModelPath,'utf8'),sourceDigest=hash(source);
if(Buffer.byteLength(source)>131072)throw Error('Y5_TOTAL_SETUP_SOURCE_BOUND');
if(!writePin&&sourceDigest!==TOTAL_MODEL_PIN.sourceDigest)throw Error('Y5_TOTAL_SETUP_FROZEN_SOURCE_MISMATCH');
const root=resolve(output);let existing=root;
while(!await stat(existing).then(()=>true,error=>{if(error.code==='ENOENT')return false;throw error;}))existing=dirname(existing);
if(await realpath(existing)!==existing)throw Error('Y5_TOTAL_SETUP_OUTPUT_SYMLINK');
for(const directory of [dirname(totalModelPath),existing]){
 const capacity=await statfs(directory);
 if(Number(capacity.bavail)*Number(capacity.bsize)<1620000000)throw Error('Y5_TOTAL_SETUP_1_6GB_FREE_FLOOR');
}
await mkdir(root,{recursive:true,mode:0o700});
if(await realpath(root)!==root)throw Error('Y5_TOTAL_SETUP_OUTPUT_SYMLINK');
const scratch=join(root,sourceDigest);
await mkdir(scratch,{mode:0o700});await prepareScratch(scratch);
try{
 const tool=await toolIdentity(Math.min(deadlineAt,Date.now()+30000)),budget={deadlineAt,scratch};
 if(!writePin&&(tool.archiveDigest!==TOTAL_MODEL_PIN.archiveDigest||tool.inventoryDigest!==TOTAL_MODEL_PIN.inventoryDigest||
  tool.identityDigest!==TOTAL_MODEL_PIN.identityDigest))throw Error('Y5_TOTAL_SETUP_FROZEN_RUNTIME_MISMATCH');
 await writeFile(join(scratch,'Total.lean'),source,{mode:0o600});
 const build=await native(tool,['lean','-M','2048','-T','200000','-o','Total.olean','Total.lean'],budget,'total-model-build');
 if(build.exitCode!==0)throw Object.assign(Error('Y5_TOTAL_SETUP_ELABORATION'),{receipt:build});
 const replay=await native(tool,['leanchecker','Total'],budget,'total-model-replay');
 if(replay.exitCode!==0)throw Object.assign(Error('Y5_TOTAL_SETUP_KERNEL_REPLAY'),{receipt:replay});
 const pin=modelPinSchema.parse({schema:'finnor.y5.total-model-pin.v2',sourceDigest,
  objectDigest:hash(await readModelAssetBytes(join(scratch,'Total.olean'),16777216)),version:'4.34.1',
  archiveDigest:tool.archiveDigest,inventoryDigest:tool.inventoryDigest,identityDigest:tool.identityDigest});
 if(hash(await readFile(totalModelPath))!==sourceDigest||Date.now()>=deadlineAt)throw Error('Y5_TOTAL_SETUP_ORIGINAL_SOURCE_OR_DEADLINE_CHANGED');
 if(!writePin&&jsonHash(pin)!==jsonHash(TOTAL_MODEL_PIN))throw Error('Y5_TOTAL_SETUP_FROZEN_PIN_MISMATCH');
 const setup=modelSetupSchema.parse({schema:'finnor.y5.total-model-setup.v2',pin,native:[build,replay],wallMs:Date.now()-started,
  accounting:'RECORDED_SHARED_SETUP_NOT_FREE_OR_INDEPENDENTLY_QUALIFIED',
  completeMoney:null,completeHumanSeconds:null,aggregatePeakBytes:null});
 await writeFile(join(scratch,'setup.json'),JSON.stringify(setup,null,2)+'\n',{mode:0o600,flag:'wx'});
 if(writePin)await writeFile(totalModelPinPath,'// Generated by scripts/postx/y5/prepare-total-model.mts --write-pin.\nexport const TOTAL_MODEL_PIN='+JSON.stringify(pin,null,2)+' as const;\n');
 console.log(JSON.stringify({status:'PREPARED_UNQUALIFIED_SHARED_SETUP',root,pin,setupRef:hash(JSON.stringify(setup,null,2)+'\n')}));
}catch(error){
 await writeFile(join(scratch,'setup-failure.json'),JSON.stringify({status:'FAIL',error:String(error),receipt:(error as {receipt?:unknown}).receipt??null})+'\n',{mode:0o600});
 throw error;
}
