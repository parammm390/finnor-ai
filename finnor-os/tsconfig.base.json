{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "preserve",
    "types": [
      "node",
      "react",
      "react-dom",
      "vitest/globals"
    ],
    "paths": {
      "@finnor/shared-types": [
        "./packages/shared-types/src/index.ts"
      ],
      "@finnor/policy-schema": [
        "./packages/policy-schema/src/index.ts"
      ],
      "@finnor/db": [
        "./packages/db/index.ts"
      ],
      "@finnor/db/*": [
        "./packages/db/*"
      ],
      "@finnor/authority": [
        "./packages/authority/src/index.ts"
      ],
      "@finnor/computer": [
        "./packages/computer/src/index.ts"
      ],
      "@finnor/data-platform": [
        "./packages/data-platform/src/index.ts"
      ],
      "@finnor/import-engine": [
        "./packages/import-engine/src/index.ts"
      ],
      "@finnor/workflow-runtime": [
        "./packages/workflow-runtime/src/index.ts"
      ],
      "@finnor/memory": [
        "./packages/memory/src/index.ts"
      ],
      "@finnor/security": [
        "./packages/security/src/index.ts"
      ],
      "@finnor/tools": [
        "./packages/tools/src/index.ts"
      ],
      "@finnor/tools/*": [
        "./packages/tools/src/*.ts"
      ],
      "@finnor/orchestration": [
        "./packages/orchestration/src/index.ts"
      ],
      "@finnor/voice-os": [
        "./packages/voice-os/src/index.ts"
      ],
      "@finnor/read-models": [
        "./packages/read-models/src/index.ts"
      ],
      "@finnor/private-equity": [
        "./packages/private-equity/src/index.ts"
      ],
      "@finnor/underwriting": [
        "./packages/underwriting/src/index.ts"
      ],
      "@finnor/epistemic-runtime": [
        "./packages/epistemic-runtime/src/index.ts"
      ],
      "@finnor/plugins-shared": [
        "./packages/domain-plugins/shared/plugin-interface.ts"
      ],
      "@finnor/plugin-water-test": [
        "./packages/domain-plugins/water-test/index.ts"
      ],
      "@finnor/plugin-maintenance-agreement": [
        "./packages/domain-plugins/maintenance-agreement/index.ts"
      ],
      "@finnor/ooxml": [
        "./packages/ooxml/src/index.ts"
      ],
      "@finnor/artifacts": [
        "./packages/artifacts/src/index.ts"
      ],
      "@finnor/spreadsheet-ir": [
        "./packages/spreadsheet-ir/src/index.ts"
      ],
      "@finnor/document-ir": [
        "./packages/document-ir/src/index.ts"
      ],
      "@finnor/presentation-ir": [
        "./packages/presentation-ir/src/index.ts"
      ]
    },
    "baseUrl": "."
  }
}
