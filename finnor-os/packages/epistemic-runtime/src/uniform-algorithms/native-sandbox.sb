(version 1)
(deny default)

(allow file-read-metadata)
(allow file-read*
  (literal "/")
  (subpath (param "TOOL_ROOT"))
  (subpath (param "SCRATCH"))
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/private/var/db/dyld")
  (literal "/private/etc/localtime")
  (literal "/dev/null")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (subpath "/dev/fd"))
(allow file-write*
  (subpath (param "SCRATCH"))
  (literal "/dev/null"))
(allow process-exec (literal (param "NATIVE_BINARY")))
(allow sysctl-read)
(deny network*)
