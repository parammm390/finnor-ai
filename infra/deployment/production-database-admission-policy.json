{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:601804670058:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "secretsmanager.us-east-1.amazonaws.com"
          ]
        },
        "StringLike": {
          "kms:EncryptionContext:aws:secretsmanager:arn": "arn:aws:secretsmanager:us-east-1:601804670058:secret:finnor/prod/database-url-??????"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:601804670058:secret:finnor/prod/database-url-??????"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:GetTemplate"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:601804670058:stack/finnor-production/*"
      ]
    }
  ]
}
