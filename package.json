{
  "name": "centropy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "workspace:generate": "node scripts/generate-workspace-contract.mjs",
    "workspace:check": "node scripts/generate-workspace-contract.mjs --check",
    "centropy:manifest": "node scripts/centropy/generate-capability-manifest.mjs",
    "centropy:manifest:check": "node scripts/centropy/generate-capability-manifest.mjs --check",
    "centropy:client": "node scripts/centropy/generate-openapi-client.mjs",
    "centropy:client:check": "node scripts/centropy/generate-openapi-client.mjs --check",
    "centropy:forms": "node scripts/centropy/generate-human-forms.mjs",
    "centropy:forms:check": "node scripts/centropy/generate-human-forms.mjs --check",
    "release:p8-zero-resurrection": "node scripts/release/verify-p8-zero-resurrection.mjs && npm run release:p8-runtime-contract --prefix finnor-os",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "release:verify": "node scripts/release/verify-release.mjs",
    "release:truth": "node scripts/release/validate-deployment-truth.mjs",
    "release:mutation-inventory": "node scripts/release/validate-production-mutation-inventory.mjs",
    "release:preflight": "npm run release:truth && npm run test:release",
    "test:release": "FINNOR_RELEASE_SOURCE= node --test scripts/release/p8-water-retirement-policy.test.mjs scripts/release/release-policy.test.mjs scripts/release/supplier-canary-health.test.mjs scripts/release/production-mutation-guard.test.mjs scripts/release/production-readiness-policy.test.mjs scripts/release/pr-verdict-policy.test.mjs scripts/release/protected-env.test.mjs scripts/release/postgres-connection.test.mjs && node scripts/release/validate-production-mutation-inventory.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sentry/nextjs": "^10.67.0",
    "@supabase/supabase-js": "^2.45.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.19",
    "geist": "^1.7.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.424.0",
    "next": "^16.3.8",
    "nodemailer": "10.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.27",
    "braces": "file:vendor/finnor-braces-3.0.4-finnor.1.tgz",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "braces": "$braces",
    "chokidar": {
      "braces": "file:../../vendor/finnor-braces-3.0.4-finnor.1.tgz"
    },
    "micromatch": {
      "braces": "file:../../vendor/finnor-braces-3.0.4-finnor.1.tgz"
    },
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^5": "5.0.12",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5",
    "tailwindcss": {
      "postcss-selector-parser": "7.1.6"
    },
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
