{
  "schema": "x3-independent-development-cases.v1",
  "contexts": {
    "base": {
      "tenant": "pe-a", "scope": "deal-1", "active_release": "r1",
      "actors": {
        "analyst": {"principal": "u-a", "roles": ["analyst"], "tenant": "pe-a", "scope": "deal-1", "current": true},
        "partner": {"principal": "u-p", "roles": ["partner"], "tenant": "pe-a", "scope": "deal-1", "current": true},
        "compliance": {"principal": "u-c", "roles": ["compliance"], "tenant": "pe-a", "scope": "deal-1", "current": true}
      },
      "source_current": ["S1/book/1", "S1/bank/1"], "source_status": ["KNOWN", "KNOWN"],
      "record": {"record_ref": "P1/rec-1/1", "release": "r1", "author": "u-a", "currency": "USD",
        "book_currency": "USD", "bank_currency": "USD", "book_minor": ["9007199254740992", "1"],
        "bank_minor": ["9007199254740993"], "source_refs": ["S1/book/1", "S1/bank/1"]}
    }
  },
  "cases": [
    {"id": "exact-match", "input": {"context": "base", "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["RECONCILED"], "state": "RECONCILED", "amount_minor": "9007199254740993", "delta_minor": "0"}},
    {"id": "one-minor-mismatch", "input": {"context": "base", "record": {"bank_minor": ["9007199254740992"]}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["AMOUNT_MISMATCH"], "state": "DRAFT", "delta_minor": "1", "prepared_count": 0}},
    {"id": "currency-mismatch", "input": {"context": "base", "record": {"bank_currency": "INR"}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["CURRENCY_MISMATCH"], "state": "DRAFT"}},
    {"id": "inr-match", "input": {"context": "base", "record": {"currency": "INR", "book_currency": "INR", "bank_currency": "INR", "book_minor": ["2500", "7500"], "bank_minor": ["10000"]}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}]},
      "expected": {"codes": ["RECONCILED", "APPROVED"], "state": "APPROVED", "amount_minor": "10000", "approvers": ["u-p"]}},
    {"id": "invalid-number", "input": {"context": "base", "record": {"book_minor": [9007199254740992]}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["INVALID_QUANTITY"], "state": "DRAFT"}},
    {"id": "invalid-exponent", "input": {"context": "base", "record": {"book_minor": ["1e5"]}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["INVALID_QUANTITY"], "state": "DRAFT"}},
    {"id": "invalid-leading-zero", "input": {"context": "base", "record": {"book_minor": ["01"]}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["INVALID_QUANTITY"], "state": "DRAFT"}},
    {"id": "invalid-negative", "input": {"context": "base", "record": {"book_minor": ["-1"]}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["INVALID_QUANTITY"], "state": "DRAFT"}},
    {"id": "sum-overflow", "input": {"context": "base", "record": {"book_minor": ["99999999999999999999999999999999999999", "1"]}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["QUANTITY_OVERFLOW"], "state": "DRAFT"}},
    {"id": "unknown", "input": {"context": "base", "set": {"source_status": ["KNOWN", "UNKNOWN"]}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}]},
      "expected": {"codes": ["EVIDENCE_UNKNOWN", "INVALID_STATE"], "state": "DRAFT", "evidence": "UNKNOWN"}},
    {"id": "stale", "input": {"context": "base", "set": {"source_status": ["KNOWN", "STALE"]}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["SOURCE_STALE"], "state": "DRAFT", "currentness": "STALE"}},
    {"id": "conflict", "input": {"context": "base", "set": {"source_status": ["CONFLICTING", "KNOWN"]}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["EVIDENCE_CONFLICTING"], "state": "DRAFT", "evidence": "CONFLICTING"}},
    {"id": "high-approval", "input": {"context": "base", "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}, {"op": "prepare", "as": "analyst"}, {"op": "approve", "as": "compliance"}, {"op": "prepare", "as": "analyst"}]},
      "expected": {"codes": ["RECONCILED", "APPROVAL_RECORDED", "INVALID_STATE", "APPROVED", "PREPARED"], "state": "PREPARED", "approvers": ["u-c", "u-p"], "prepared_count": 1, "executed_count": 0, "binding": {"tenant": "pe-a", "scope": "deal-1", "record_ref": "P1/rec-1/1", "release": "r1", "currency": "USD", "amount_minor": "9007199254740993", "source_refs": ["S1/book/1", "S1/bank/1"]}}},
    {"id": "low-approval", "input": {"context": "base", "record": {"book_minor": ["99999"], "bank_minor": ["99999"]}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}]},
      "expected": {"codes": ["RECONCILED", "APPROVED"], "state": "APPROVED", "approvers": ["u-p"]}},
    {"id": "threshold-equal", "input": {"context": "base", "record": {"book_minor": ["100000"], "bank_minor": ["100000"]}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}]},
      "expected": {"codes": ["RECONCILED", "APPROVAL_RECORDED"], "state": "RECONCILED", "approvers": ["u-p"], "prepared_count": 0}},
    {"id": "compliance-first", "input": {"context": "base", "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "compliance"}, {"op": "approve", "as": "partner"}]},
      "expected": {"codes": ["RECONCILED", "APPROVAL_RECORDED", "APPROVED"], "state": "APPROVED", "approvers": ["u-c", "u-p"]}},
    {"id": "self-approval", "input": {"context": "base", "record": {"author": "u-p"}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}]},
      "expected": {"codes": ["RECONCILED", "SELF_APPROVAL_DENIED"], "state": "RECONCILED", "approvers": []}},
    {"id": "self-dual-role", "input": {"context": "base", "set": {"actor_overrides": {"analyst": {"roles": ["analyst", "partner"]}}}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "analyst"}]},
      "expected": {"codes": ["RECONCILED", "SELF_APPROVAL_DENIED"], "state": "RECONCILED", "approvers": []}},
    {"id": "same-principal", "input": {"context": "base", "set": {"actor_overrides": {"compliance": {"principal": "u-p"}}}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}, {"op": "approve", "as": "compliance"}]},
      "expected": {"codes": ["RECONCILED", "APPROVAL_RECORDED", "PRINCIPAL_SEPARATION_DENIED"], "state": "RECONCILED", "approvers": ["u-p"]}},
    {"id": "wrong-role", "input": {"context": "base", "events": [{"op": "reconcile", "as": "partner"}]},
      "expected": {"codes": ["ROLE_DENIED"], "state": "DRAFT"}},
    {"id": "wrong-scope", "input": {"context": "base", "set": {"actor_overrides": {"analyst": {"scope": "deal-2"}}}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["SCOPE_DENIED"], "state": "DRAFT", "prepared_count": 0}},
    {"id": "wrong-tenant", "input": {"context": "base", "set": {"actor_overrides": {"partner": {"tenant": "pe-b"}}}, "events": [{"op": "read", "as": "partner"}]},
      "expected": {"codes": ["TENANT_DENIED"], "read_count": 0, "readbacks": [], "prepared_count": 0}},
    {"id": "revoked", "input": {"context": "base", "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}, {"op": "approve", "as": "compliance"}, {"op": "revoke", "actor": "partner"}, {"op": "prepare", "as": "analyst"}]},
      "expected": {"codes": ["RECONCILED", "APPROVAL_RECORDED", "APPROVED", "REVOKED", "APPROVER_AUTHORITY_REVOKED"], "state": "APPROVED", "approvers": ["u-c", "u-p"], "prepared_count": 0}},
    {"id": "refresh-after-approval", "input": {"context": "base", "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}, {"op": "approve", "as": "compliance"}, {"op": "refresh", "source": 1, "ref": "S1/bank/2"}, {"op": "read", "as": "analyst"}, {"op": "prepare", "as": "analyst"}]},
      "expected": {"codes": ["RECONCILED", "APPROVAL_RECORDED", "APPROVED", "REFRESHED", "READ", "SOURCE_STALE"], "state": "APPROVED", "source_refs": ["S1/book/1", "S1/bank/1"], "currentness": "STALE", "prepared_count": 0}},
    {"id": "record-precondition", "input": {"context": "base", "events": [{"op": "reconcile", "as": "analyst", "ref": "P1/rec-1/0"}]},
      "expected": {"codes": ["RECORD_REF_MISMATCH"], "state": "DRAFT"}},
    {"id": "approval-record-precondition", "input": {"context": "base", "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner", "ref": "P1/rec-1/0"}]},
      "expected": {"codes": ["RECONCILED", "RECORD_REF_MISMATCH"], "state": "RECONCILED", "approvers": []}},
    {"id": "prepare-record-precondition", "input": {"context": "base", "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}, {"op": "approve", "as": "compliance"}, {"op": "prepare", "as": "analyst", "ref": "P1/rec-1/2"}]},
      "expected": {"codes": ["RECONCILED", "APPROVAL_RECORDED", "APPROVED", "RECORD_REF_MISMATCH"], "state": "APPROVED", "prepared_count": 0}},
    {"id": "commit-race", "input": {"context": "base", "events": [{"op": "reconcile", "as": "analyst", "race": {"revision": "P1/rec-1/2"}}]},
      "expected": {"codes": ["COMMIT_CONFLICT"], "state": "DRAFT", "prepared_count": 0}},
    {"id": "prepare-retry", "input": {"context": "base", "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}, {"op": "approve", "as": "compliance"}, {"op": "prepare", "as": "analyst"}, {"op": "restart"}, {"op": "prepare", "as": "analyst"}]},
      "expected": {"codes": ["RECONCILED", "APPROVAL_RECORDED", "APPROVED", "PREPARED", "RESTARTED", "PREPARED"], "state": "PREPARED", "prepared_count": 1, "executed_count": 0}},
    {"id": "execute-refused", "input": {"context": "base", "events": [{"op": "execute", "as": "partner"}]},
      "expected": {"codes": ["EXECUTION_OUT_OF_SCOPE"], "state": "DRAFT", "executed_count": 0}},
    {"id": "eur-r1-denied", "input": {"context": "base", "record": {"currency": "EUR", "book_currency": "EUR", "bank_currency": "EUR"}, "events": [{"op": "reconcile", "as": "analyst"}]},
      "expected": {"codes": ["UNSUPPORTED_CURRENCY"], "state": "DRAFT"}},
    {"id": "eur-r2", "input": {"context": "base", "set": {"active_release": "r2"}, "record": {"release": "r2", "currency": "EUR", "book_currency": "EUR", "bank_currency": "EUR", "book_minor": ["50000"], "bank_minor": ["50000"]}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}, {"op": "approve", "as": "compliance"}]},
      "expected": {"codes": ["RECONCILED", "APPROVAL_RECORDED", "APPROVED"], "release": "r2", "state": "APPROVED", "amount_minor": "50000"}},
    {"id": "r2-lowered-threshold", "input": {"context": "base", "set": {"active_release": "r2"}, "record": {"release": "r2", "book_minor": ["75000"], "bank_minor": ["75000"]}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}]},
      "expected": {"codes": ["RECONCILED", "APPROVAL_RECORDED"], "state": "RECONCILED", "release": "r2"}},
    {"id": "release-retains-original", "input": {"context": "base", "record": {"book_minor": ["75000"], "bank_minor": ["75000"]}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}, {"op": "activate", "release": "r2"}, {"op": "restart"}, {"op": "read", "as": "analyst"}, {"op": "prepare", "as": "analyst"}]},
      "expected": {"codes": ["RECONCILED", "APPROVED", "ACTIVATED", "RESTARTED", "READ", "RELEASE_CHANGED"], "state": "APPROVED", "release": "r1", "amount_minor": "75000", "approvers": ["u-p"], "prepared_count": 0}},
    {"id": "inr-retains-original", "input": {"context": "base", "record": {"currency": "INR", "book_currency": "INR", "bank_currency": "INR", "book_minor": ["2500", "7500"], "bank_minor": ["10000"]}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}, {"op": "activate", "release": "r2"}, {"op": "restart"}, {"op": "read", "as": "analyst"}]},
      "expected": {"codes": ["RECONCILED", "APPROVED", "ACTIVATED", "RESTARTED", "READ"], "state": "APPROVED", "release": "r1", "currency": "INR", "book_minor": ["2500", "7500"], "bank_minor": ["10000"], "amount_minor": "10000", "approvers": ["u-p"]}},
    {"id": "revision-retains-original", "input": {"context": "base", "record": {"book_minor": ["75000"], "bank_minor": ["75000"]}, "events": [{"op": "reconcile", "as": "analyst"}, {"op": "approve", "as": "partner"}, {"op": "activate", "release": "r2"}, {"op": "refresh", "source": 1, "ref": "S1/bank/2"}, {"op": "edit", "as": "analyst", "record": {"release": "r2", "currency": "EUR", "book_currency": "EUR", "bank_currency": "EUR", "book_minor": ["50000"], "bank_minor": ["50000"]}}, {"op": "restart"}, {"op": "read", "as": "analyst"}]},
      "expected": {"codes": ["RECONCILED", "APPROVED", "ACTIVATED", "REFRESHED", "EDITED", "RESTARTED", "READ"], "record_ref": "P1/rec-1/2", "release": "r2", "state": "DRAFT", "approvers": [], "source_refs": ["S1/book/1", "S1/bank/2"], "history": [{"record_ref": "P1/rec-1/1", "release": "r1", "currency": "USD", "state": "APPROVED", "amount_minor": "75000", "book_minor": ["75000"], "bank_minor": ["75000"], "approvers": ["u-p"], "source_refs": ["S1/book/1", "S1/bank/1"]}]}}
  ]
}
